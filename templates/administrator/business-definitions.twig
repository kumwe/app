{% extends "layout.twig" %}
{% block title %}{{ t('core.administrator.business_definitions.business_definitions_kumwe') }}{% endblock %}
{% block context_title %}{{ t('core.administrator.business_definitions.business_definitions') }}{% endblock %}
{% block content %}
  {% embed '@kis/page-header.twig' with {
    eyebrow: 'Structure',
    title: t('core.administrator.business_definitions.business_definitions'),
    purpose: t('core.administrator.business_definitions.model_operational_entities_relationships_views_a')
  } %}
    {% block actions %}
      {% if capabilities['content.update'] is defined %}<div class="page-actions"><a class="button primary" href="/administrator/business-definitions?new=1&tab=identity">{{ t('core.administrator.business_definitions.new_definition') }}</a></div>{% endif %}
    {% endblock %}
  {% endembed %}

  <div class="notice" role="status"><span><strong>{{ t('core.administrator.business_definitions.publication_is_immutable') }}</strong> {{ t('core.administrator.business_definitions.validation_and_compatibility_analysis_run_before') }}</span><button class="notice-dismiss" type="button" aria-label="{{ t('core.administrator.business_definitions.dismiss_notice') }}" data-dismiss-notice>×</button></div>

  <kumwe-tabs data-kis-tab-parameter="tab">
    {% include '@kis/tabs.twig' with {
      id: 'business-definition-workspace',
      label: t('core.administrator.business_definitions.business_definition_tasks'),
      tabs: workspace_tabs,
      active: active_tab
    } only %}

    {% embed '@kis/master-detail.twig' with {
      id: 'business-definition-workspace',
      catalog_label: t('core.administrator.business_definitions.definition_catalog'),
      catalog_toggle_label: t('core.administrator.business_definitions.browse_definitions')
    } %}
      {% block catalog %}
    <section class="panel stack definition-catalog">
      {% embed '@kis/resource-toolbar.twig' with {
        label: t('core.administrator.business_definitions.definition_catalog'),
        title: 'Entities',
        summary: t('core.administrator.business_definitions.definitions', {count: catalog|length})
      } %}{% endembed %}
      {% for item in catalog %}
        <a class="definition-catalog-item{% if selected == item.id or selected == item.handle %} active{% endif %}" href="/administrator/business-definitions?definition={{ item.id|url_encode }}&tab={{ active_tab|url_encode }}"{% if selected == item.id or selected == item.handle %} aria-current="true"{% endif %}>
          <strong>{{ item.handle }}</strong><span>{{ item.status }}{% if item.published_version %} · v{{ item.published_version }}{% endif %}</span>
          <small>{{ item.owner.type }}:{{ item.owner.identifier }}{% if not item.owner_active %} {{ t('core.administrator.business_definitions.inactive') }}{% endif %}</small>
        </a>
      {% else %}
        <p class="empty-state">{{ t('core.administrator.business_definitions.no_business_definitions_have_been_declared') }}</p>
      {% endfor %}
      {% if capabilities['content.update'] is defined %}
        <details>
          <summary>{{ t('core.administrator.business_definitions.import_strict_definition') }}</summary>
          <form method="post" enctype="multipart/form-data" class="stack compact-form">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="import">
            <input type="hidden" name="return_tab" value="{{ active_tab }}">
            <label>{{ t('core.administrator.business_definitions.definition_json_file') }}<input type="file" name="definition_file" accept="application/json,.json" required></label>
            <label>{{ t('core.administrator.business_definitions.expected_draft_revision') }}<input type="number" name="revision" min="0" placeholder="{{ t('core.administrator.business_definitions.required_when_replacing_an_existing_definition') }}"></label>
            <p class="field-help">{{ t('core.administrator.business_definitions.imports_use_the_same_strict_validation') }}</p>
            <button type="submit">{{ t('core.administrator.business_definitions.import_draft') }}</button>
          </form>
        </details>
      {% endif %}
    </section>
      {% endblock %}

      {% block detail %}
    <div class="stack">
      {% set is_package = definition and definition.owner.type != 'site' %}
      {% set fields = definition ? definition.fields : [{'handle':'id','label':'ID','type':'core.uuid','description':t('core.administrator.business_definitions.stable_entity_identity'),'required':true,'nullable':false,'default':null,'length':null,'precision':null,'scale':null,'configuration':{},'normalizers':[],'validators':[],'unique':true,'indexed':true,'immutable_after_create':true,'server_only':true,'computed':false,'read_only':true,'create_visible':false,'update_visible':false,'read_visible':true,'searchable':false,'filterable':true,'sortable':true,'reportable':false,'exportable':true,'sensitivity':'internal','localized':false,'help_text':t('core.administrator.business_definitions.generated_automatically'),'form_group':'identity','order':0,'placements':['detail','history'],'visibility_condition':null,'editability_condition':null,'formula':null}] %}
      {% if is_package %}
        <div class="notice warning" role="status"><span><strong>{{ t('core.administrator.business_definitions.package_owned') }}</strong> {{ t('core.administrator.business_definitions.this_definition_is_read_only_here') }}</span></div>
      {% elseif definition and capabilities['content.update'] is not defined %}
        <div class="notice warning" role="status"><span><strong>{{ t('core.administrator.business_definitions.read_only_access') }}</strong> {{ t('core.administrator.business_definitions.you_can_inspect_and_export_this') }}</span></div>
      {% endif %}

      {% if definition and (is_package or capabilities['content.update'] is not defined) %}
        {% embed '@kis/tab-panel.twig' with {id: 'business-definition-workspace', tab: 'identity'} %}
          {% block content %}<section class="panel stack">
            <div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_definitions.typed_contract') }}</p><h2>{{ definition.plural_label }}</h2>{% include '@kis/technical-value.twig' with {label: t('core.administrator.business_definitions.definition_handle'), value: definition.handle} only %}</div><a class="button" href="/administrator/business-definitions?export={{ definition.id|url_encode }}">{{ t('core.administrator.business_definitions.export_json') }}</a></div>
            <dl class="definition-metadata"><div><dt>{{ t('core.administrator.business_definitions.storage') }}</dt><dd>{{ definition.storage_mode }}</dd></div><div><dt>{{ t('core.administrator.business_definitions.identity') }}</dt><dd>{{ definition.identity_strategy }}</dd></div><div><dt>{{ t('core.administrator.access_control.scope') }}</dt><dd>{{ definition.scope }}</dd></div></dl>
          </section>{% endblock %}
        {% endembed %}
        {% embed '@kis/tab-panel.twig' with {id: 'business-definition-workspace', tab: 'fields'} %}
          {% block content %}<section class="panel stack"><div class="section-heading"><h2>{{ t('core.administrator.business_definitions.fields') }}</h2><span class="count-badge">{{ definition.fields|length }}</span></div><div class="table-wrap kis-responsive-table" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_definitions.definition_fields') }}"><table class="definition-fields-table"><thead><tr><th scope="col">{{ t('core.administrator.business_definitions.field') }}</th><th scope="col">{{ t('core.administrator.business_definitions.type') }}</th><th scope="col">{{ t('core.administrator.business_definitions.required') }}</th><th scope="col">{{ t('core.administrator.business_definitions.use') }}</th></tr></thead><tbody>{% for field in definition.fields %}<tr><th scope="row" data-label="Field"><strong>{{ field.label }}</strong><br><code>{{ field.handle }}</code></th><td data-label="Type"><code>{{ field.type }}</code></td><td data-label="Required">{{ field.required ? 'Yes' : 'No' }}</td><td data-label="Use">{{ field.placements|join(', ') }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
        {% endembed %}
        {% embed '@kis/tab-panel.twig' with {id: 'business-definition-workspace', tab: 'relationships'} %}
          {% block content %}<section class="panel stack"><div class="section-heading"><h2>{{ t('core.administrator.business_definitions.relationships') }}</h2><span class="count-badge">{{ definition.relationships|length }}</span></div>{% for relation in definition.relationships %}<p><strong>{{ relation.label }}</strong> · {{ relation.kind }} → <code>{{ relation.target }}</code>{% if relation.inverse %} {{ t('core.administrator.business_definitions.inverse', {inverse: relation.inverse}) }}{% endif %}</p>{% else %}<p class="text-muted">{{ t('core.administrator.business_definitions.no_relationships_are_declared') }}</p>{% endfor %}</section>{% endblock %}
        {% endembed %}
        {% embed '@kis/tab-panel.twig' with {id: 'business-definition-workspace', tab: 'delivery'} %}
          {% block content %}<section class="panel stack"><h2>{{ t('core.administrator.business_definitions.views_and_actions') }}</h2><p>{{ t('core.administrator.business_definitions.views_actions', {views: (definition.views|length), actions: (definition.actions|length)}) }}</p></section>{% endblock %}
        {% endembed %}
        {% embed '@kis/tab-panel.twig' with {id: 'business-definition-workspace', tab: 'workflow'} %}
          {% block content %}<section class="panel stack"><h2>{{ t('core.administrator.business_definitions.workflow') }}</h2><p>{{ t('core.administrator.business_definitions.workflow_states', {value: (definition.workflow ? definition.workflow.states|length : 0)}) }}</p></section>{% endblock %}
        {% endembed %}
        {% embed '@kis/tab-panel.twig' with {id: 'business-definition-workspace', tab: 'publication'} %}
          {% block content %}<section class="panel stack"><h2>{{ t('core.administrator.business_definitions.publication') }}</h2><p>{{ t('core.administrator.business_definitions.this_package_owned_or_permission_reduced') }}</p></section>{% endblock %}
        {% endembed %}
      {% endif %}

      {% if not is_package and capabilities['content.update'] is defined %}
        <form method="post" class="stack" id="business-definition-form">
          <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="save">
          <input type="hidden" name="return_tab" value="{{ active_tab }}">
          <input type="hidden" name="id" value="{{ definition ? definition.id : '' }}"><input type="hidden" name="revision" value="{{ draft ? draft.revision : (definition ? 0 : '') }}">
          {% embed '@kis/tab-panel.twig' with {id: 'business-definition-workspace', tab: 'identity'} %}
            {% block content %}
          <section class="panel stack">
            <div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_definitions.identity') }}</p><h2>{{ definition ? definition.singular_label : t('core.administrator.business_definitions.new_business_entity') }}</h2></div><div class="page-actions">{% if definition %}<a class="button" href="/administrator/business-definitions?export={{ definition.id|url_encode }}">{{ t('core.administrator.business_definitions.export_json') }}</a>{% endif %}{% if draft %}<span class="status-badge">{{ t('core.administrator.business_definitions.draft_r', {revision: draft.revision}) }}</span>{% endif %}</div></div>
            <div class="two-column">
              <label>{{ t('core.administrator.business_definitions.stable_handle') }}<small>{{ t('core.administrator.business_definitions.must_start_with', {site_namespace: site_namespace}) }}</small><input name="handle" value="{{ definition ? definition.handle : site_namespace }}" pattern="[a-z][a-z0-9._-]+"{% if definition %} readonly aria-readonly="true"{% endif %} required></label>
              <label>{{ t('core.administrator.business_definitions.identity_strategy') }}<select name="identity_strategy"><option value="uuid"{% if not definition or definition.identity_strategy == 'uuid' %} selected{% endif %}>UUID</option><option value="reference"{% if definition and definition.identity_strategy == 'reference' %} selected{% endif %}>{{ t('core.administrator.business_definitions.external_reference') }}</option></select></label>
              <label>{{ t('core.administrator.business_definitions.singular_label') }}<input name="singular_label" value="{{ definition ? definition.singular_label : '' }}" required maxlength="120"></label>
              <label>{{ t('core.administrator.business_definitions.plural_label') }}<input name="plural_label" value="{{ definition ? definition.plural_label : '' }}" required maxlength="120"></label>
              <label>{{ t('core.administrator.access_control.scope') }}<select name="scope">{% for value, label in {'site':'Site','organization':'Organization','site_organization':t('core.administrator.business_definitions.site_and_organization'),'installation':'Installation'} %}<option value="{{ value }}"{% if definition and definition.scope == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
              <fieldset><legend>{{ t('core.administrator.business_definitions.exposure_and_policy') }}</legend><label class="check"><input type="checkbox" name="administrator_hidden" value="1"{% if definition and not definition.administrator_exposure %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.hide_from_administrator') }}</span></label><label class="check"><input type="checkbox" name="portal_exposure" value="1"{% if definition and definition.portal_exposure %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.portal') }}</span></label><label class="check"><input type="checkbox" name="public_exposure" value="1"{% if definition and definition.public_exposure %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.public_read_surface') }}</span></label><label class="check"><input type="checkbox" name="soft_delete_enabled" value="1"{% if definition and definition.soft_delete_enabled|default(false) %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.enable_soft_deletion_and_restore') }}</span></label><label class="check"><input type="checkbox" name="audit_disabled" value="1"{% if definition and not definition.audit_enabled %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.disable_audit_policy') }}</span></label><label class="check"><input type="checkbox" name="revisions_disabled" value="1"{% if definition and not definition.revisions_enabled %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.disable_revision_policy') }}</span></label></fieldset>
            </div>
          </section>
            {% endblock %}
          {% endembed %}

          <kumwe-definition-editor class="stack">
            {% embed '@kis/tab-panel.twig' with {id: 'business-definition-workspace', tab: 'fields'} %}
              {% block content %}
            <section class="panel stack">
              <div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_definitions.data_contract') }}</p><h2>{{ t('core.administrator.business_definitions.focused_field_editor') }}</h2><p class="field-help">{{ t('core.administrator.business_definitions.choose_one_compact_field_row_to') }}</p></div><div class="page-actions"><span class="count-badge">{{ fields|length }}</span><button type="button" data-add="field">{{ t('core.administrator.business_definitions.add_field') }}</button></div></div>
              <div class="stack" data-rows="field">
                {% for field in fields %}
                  <details class="builder-row definition-row" data-row="field"{% if loop.first %} open{% endif %}>
                    <input type="hidden" name="field_{{ loop.index0 }}_configuration_preserved" value="{{ field.configuration|json_encode }}">
                    <input type="hidden" name="field_{{ loop.index0 }}_validators_preserved" value="{{ field.validators|json_encode }}">
                    <summary><strong>{{ field.label }}</strong><span>{{ field.handle }} · {{ field.type }}</span></summary>
                    <div class="definition-row-grid">
                      <label>{{ t('core.administrator.business_definitions.handle') }}<input name="field_{{ loop.index0 }}_handle" value="{{ field.handle }}" pattern="[a-z][a-z0-9_]*" required></label>
                      <label>{{ t('core.administrator.business_definitions.label') }}<input name="field_{{ loop.index0 }}_label" value="{{ field.label }}" required></label>
                      <label>{{ t('core.administrator.business_definitions.type') }}<select name="field_{{ loop.index0 }}_type">{% for type in field_types %}<option value="{{ type.id }}"{% if type.id == field.type %} selected{% endif %}>{{ type.label }} · {{ type.id }}</option>{% endfor %}</select></label>
                      <label>{{ t('core.administrator.business_definitions.group') }}<input name="field_{{ loop.index0 }}_group" value="{{ field.form_group|default('general') }}"></label>
                      <label>{{ t('core.administrator.business_definitions.description') }}<input name="field_{{ loop.index0 }}_description" value="{{ field.description }}"></label>
                      <label>{{ t('core.administrator.business_definitions.help_text') }}<input name="field_{{ loop.index0 }}_help" value="{{ field.help_text }}"></label>
                      <label>{{ t('core.administrator.business_definitions.length') }}<input type="number" min="1" max="1000000" name="field_{{ loop.index0 }}_length" value="{{ field.length }}"></label>
                      <label>{{ t('core.administrator.business_definitions.precision') }}<input type="number" min="1" max="65" name="field_{{ loop.index0 }}_precision" value="{{ field.precision }}"></label>
                      <label>{{ t('core.administrator.business_definitions.scale') }}<input type="number" min="0" max="30" name="field_{{ loop.index0 }}_scale" value="{{ field.scale }}"></label>
                      <label>{{ t('core.administrator.business_custom_view.default') }}<input name="field_{{ loop.index0 }}_default" value="{{ field.default is same as(true) ? 'true' : (field.default is same as(false) ? 'false' : field.default) }}"></label>
                      <label>{{ t('core.administrator.business_definitions.sensitivity') }}<select name="field_{{ loop.index0 }}_sensitivity">{% for value in ['public','internal','confidential','restricted','secret'] %}<option value="{{ value }}"{% if field.sensitivity == value %} selected{% endif %}>{{ value|capitalize }}</option>{% endfor %}</select></label>
                      <label>{{ t('core.administrator.business_definitions.order') }}<input type="number" min="0" max="100000" name="field_{{ loop.index0 }}_order" value="{{ field.order }}"></label>
                      <label>{{ t('core.administrator.business_definitions.placements') }}<small>{{ t('core.administrator.business_definitions.comma_separated_form_detail_list_history') }}</small><input name="field_{{ loop.index0 }}_placements" value="{{ field.placements|join(', ') }}"></label>
                      <label>{{ t('core.administrator.business_definitions.normalizers') }}<small>{{ t('core.administrator.business_definitions.comma_separated_identifiers') }}</small><input name="field_{{ loop.index0 }}_normalizers" value="{{ field.normalizers|join(', ') }}"></label>
                      <label>{{ t('core.administrator.business_definitions.choices_options') }}<small>{{ t('core.administrator.business_definitions.comma_or_line_separated') }}</small><textarea name="field_{{ loop.index0 }}_options" rows="2">{{ field.configuration.options|default([])|join('\n') }}</textarea></label>
                      <label>{{ t('core.administrator.business_definitions.currency') }}<input name="field_{{ loop.index0 }}_currency" value="{{ field.configuration.currency|default('') }}" placeholder="USD"></label>
                      <label>{{ t('core.administrator.business_definitions.unit') }}<input name="field_{{ loop.index0 }}_unit" value="{{ field.configuration.unit|default('') }}" placeholder="kg"></label>
                      <label>{{ t('core.administrator.business_definitions.reference_target') }}<input name="field_{{ loop.index0 }}_target" value="{{ field.configuration.target|default('') }}" placeholder="site.default.entity"></label>
                      <label>{{ t('core.administrator.business_definitions.json_maximum_bytes') }}<input type="number" min="1" max="1048576" name="field_{{ loop.index0 }}_max_bytes" value="{{ field.configuration.max_bytes|default('') }}"></label>
                      <label>{{ t('core.administrator.business_definitions.validation_rule') }}<select name="field_{{ loop.index0 }}_validator"><option value="">{{ t('core.administrator.business_definitions.none') }}</option><option value="minimum">{{ t('core.administrator.business_definitions.minimum') }}</option><option value="maximum">{{ t('core.administrator.business_definitions.maximum') }}</option><option value="pattern">{{ t('core.administrator.business_definitions.pattern') }}</option><option value="allowed_values">{{ t('core.administrator.business_definitions.allowed_values') }}</option></select></label>
                      <label>{{ t('core.administrator.business_definitions.validation_value') }}<input name="field_{{ loop.index0 }}_validator_value"></label>
                    </div>
                    {% set field_index = loop.index0 %}<fieldset class="check-grid"><legend>{{ t('core.administrator.business_definitions.behavior_and_use') }}</legend>{% for key, label in {'required':'Required','unique':'Unique','indexed':'Indexed','immutable':t('core.administrator.business_definitions.immutable_after_creation'),'server_only':t('core.administrator.business_definitions.server_only'),'read_only':t('core.administrator.business_definitions.read_only'),'searchable':'Searchable','filterable':'Filterable','sortable':'Sortable','reportable':'Reportable','exportable':'Exportable','localized':'Localized','computed':'Computed'} %}<label class="check"><input type="checkbox" name="field_{{ field_index }}_{{ key }}" value="1"{% set property = key == 'immutable' ? 'immutable_after_create' : key %}{% if attribute(field, property) %} checked{% endif %}><span>{{ label }}</span></label>{% endfor %}<label class="check"><input type="checkbox" name="field_{{ field_index }}_stored" value="1"{% if field.computation_mode|default('virtual') == 'stored' %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.persist_computed_value') }}</span></label><label class="check"><input type="checkbox" name="field_{{ field_index }}_hide_create" value="1"{% if not field.create_visible %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.hide_on_create') }}</span></label><label class="check"><input type="checkbox" name="field_{{ field_index }}_hide_update" value="1"{% if not field.update_visible %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.hide_on_update') }}</span></label><label class="check"><input type="checkbox" name="field_{{ field_index }}_hide_read" value="1"{% if not field.read_visible %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.hide_on_read') }}</span></label></fieldset>
                    <div class="formula-builder" data-formula><h3>{{ t('core.administrator.business_definitions.safe_computed_formula') }}</h3><input type="hidden" name="field_{{ loop.index0 }}_formula_preserved" value="{{ field.formula ? field.formula|json_encode : '' }}"><div class="four-column"><label>{{ t('core.administrator.business_definitions.result_type') }}<select name="field_{{ loop.index0 }}_formula_type">{% for value in ['string','integer','decimal'] %}<option value="{{ value }}"{% if field.formula and field.formula.type == value %} selected{% endif %}>{{ value }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_definitions.left_field') }}<input name="field_{{ loop.index0 }}_formula_left" value="{{ field.formula and field.formula.op == 'field' ? field.formula.field : '' }}"></label><label>{{ t('core.administrator.business_definitions.operator') }}<select name="field_{{ loop.index0 }}_formula_operator">{% for value in ['field','concat','add','subtract','multiply','divide'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_definitions.right_field') }}<input name="field_{{ loop.index0 }}_formula_right"></label><label>{{ t('core.administrator.business_definitions.division_scale') }}<input type="number" min="0" max="30" name="field_{{ loop.index0 }}_formula_scale" value="{{ field.formula and field.formula.scale is not null ? field.formula.scale : 2 }}"></label></div><p class="field-help">{{ t('core.administrator.business_definitions.leave_the_controls_empty_to_retain') }}</p></div>
                    <div class="formula-builder"><h3>{{ t('core.administrator.business_definitions.safe_visibility_condition') }}</h3><input type="hidden" name="field_{{ loop.index0 }}_visibility_preserved" value="{{ field.visibility_condition ? field.visibility_condition|json_encode : '' }}"><div class="four-column"><label>{{ t('core.administrator.business_definitions.field') }}<input name="field_{{ loop.index0 }}_visibility_field"></label><label>{{ t('core.administrator.business_definitions.type') }}<select name="field_{{ loop.index0 }}_visibility_type">{% for value in ['string','integer','decimal','boolean','date','time','datetime'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_definitions.comparison') }}<select name="field_{{ loop.index0 }}_visibility_operator">{% for value in ['eq','ne','lt','lte','gt','gte','is_null'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_fields.value') }}<input name="field_{{ loop.index0 }}_visibility_value"></label></div><h3>{{ t('core.administrator.business_definitions.safe_editability_condition') }}</h3><input type="hidden" name="field_{{ loop.index0 }}_editability_preserved" value="{{ field.editability_condition ? field.editability_condition|json_encode : '' }}"><div class="four-column"><label>{{ t('core.administrator.business_definitions.field') }}<input name="field_{{ loop.index0 }}_editability_field"></label><label>{{ t('core.administrator.business_definitions.type') }}<select name="field_{{ loop.index0 }}_editability_type">{% for value in ['string','integer','decimal','boolean','date','time','datetime'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_definitions.comparison') }}<select name="field_{{ loop.index0 }}_editability_operator">{% for value in ['eq','ne','lt','lte','gt','gte','is_null'] %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_fields.value') }}<input name="field_{{ loop.index0 }}_editability_value"></label></div></div>
                    <button class="remove-row" type="button" data-remove>{{ t('core.administrator.business_definitions.remove_field') }}</button>
                  </details>
                {% endfor %}
              </div>
              <template data-template="field">
                <details class="builder-row definition-row" data-row="field" open>
                  <summary><strong>{{ t('core.administrator.business_definitions.new_field') }}</strong></summary>
                  <div class="definition-row-grid">
                    <label>{{ t('core.administrator.business_definitions.handle') }}<input name="field___INDEX___handle" pattern="[a-z][a-z0-9_]*" required></label>
                    <label>{{ t('core.administrator.business_definitions.label') }}<input name="field___INDEX___label" required></label>
                    <label>{{ t('core.administrator.business_definitions.type') }}<select name="field___INDEX___type">{% for type in field_types %}<option value="{{ type.id }}">{{ type.label }} · {{ type.id }}</option>{% endfor %}</select></label>
                    <label>{{ t('core.administrator.business_definitions.group') }}<input name="field___INDEX___group" value="general"></label>
