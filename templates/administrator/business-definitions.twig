      {% embed '@kis/tab-panel.twig' with {id: 'business-definition-workspace', tab: 'history'} %}
        {% block content %}
          <section class="panel stack"><div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_definitions.immutable_ledger') }}</p><h2>{{ t('core.administrator.business_definitions.version_history') }}</h2></div><span class="count-badge">{{ history|length }}</span></div>{% for version in history %}<details class="history-row"><summary><strong>{{ t('core.administrator.business_definitions.version', {version: version.version}) }}</strong><span>{{ version.status }} · {{ version.published_at }}</span></summary><dl class="definition-metadata"><div><dt>{{ t('core.administrator.business_definitions.checksum') }}</dt><dd>{% include '@kis/technical-value.twig' with {label: t('core.administrator.business_definitions.version_checksum'), value: version.checksum} only %}</dd></div><div><dt>{{ t('core.administrator.business_definitions.published_by') }}</dt><dd>{{ version.published_by }}</dd></div></dl>{% if not is_package and capabilities['content.update'] is defined %}<div class="page-actions">{% for action in ['supersede','deprecate','reject'] %}<form method="post"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="{{ action }}"><input type="hidden" name="return_tab" value="history"><input type="hidden" name="id" value="{{ definition.id }}"><input type="hidden" name="version" value="{{ version.version }}"><button type="submit" data-confirm="Mark version {{ version.version }} as {{ action }}?">{{ action|capitalize }}</button></form>{% endfor %}</div>{% endif %}</details>{% else %}<p class="text-muted">{{ t('core.administrator.business_definitions.no_immutable_versions_have_been_published') }}</p>{% endfor %}</section>
        {% endblock %}
      {% endembed %}
    </div>
      {% endblock %}
    {% endembed %}
  </kumwe-tabs>
{% endblock %}
