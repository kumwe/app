{% extends "layout.twig" %}

{% block title %}{{ t('core.administrator.business_history.record_history_kumwe') }}{% endblock %}
{% block context_title %}{{ t('core.administrator.business_history.record_history') }}{% endblock %}
{% block context_subtitle %}{{ t('core.administrator.business_history.disclosure_filtered_revision_evidence') }}{% endblock %}

{% block content %}
  {% set record_path = business_base_path ~ '/' ~ (definition_handle|url_encode) ~ '/' ~ (record_id|url_encode) %}
  <kumwe-business-surface data-kis-business data-kis-component="generated-record-history" data-kis-surface="core.administrator.generated-record" data-record-task="history">
    <header class="page-heading">
      <div>
        <p class="eyebrow">{{ definition_handle }}</p>
        <h1>{{ t('core.administrator.business_history.record_history') }}</h1>
        <p>{% include '@kis/technical-value.twig' with {label: t('core.administrator.business_confirm.record_id'), value: record_id} only %}</p>
      </div>
      <div class="page-actions">
        <a class="button" href="{{ record_path }}">{{ t('core.administrator.business_custom_view.back_to_record') }}</a>
      </div>
    </header>

    {% include '@kis/task-navigation.twig' with {
      label: t('core.administrator.business_detail.record_tasks'),
      active: 'history',
      tasks: [
        {id: 'summary', label: 'Summary', href: record_path ~ '?task=summary'},
        {id: 'relations', label: 'Relations', href: record_path ~ '?task=relations'},
        {id: 'history', label: 'History', href: record_path ~ '?task=history'},
        {id: 'actions', label: 'Actions', href: record_path ~ '?task=actions'}
      ]
    } only %}

    {% if items is empty %}
      <section class="empty-state"><div class="empty-state-content"><h2>{{ t('core.administrator.business_history.no_revisions_are_available') }}</h2><p>{{ t('core.administrator.business_history.this_record_has_no_visible_history') }}</p></div></section>
    {% else %}
      <ol class="business-history-list kis-business-history">
        {% for revision in items %}
          <li class="panel business-history-entry kis-business-history-entry">
            <header>
              <div>
                <p class="eyebrow">{{ revision.operation|replace({'_': ' '}) }}</p>
                <h2>{{ t('core.administrator.business_history.version_revision', {record_version: revision.record_version, revision_number: revision.revision_number}) }}</h2>
              </div>
              <time datetime="{{ revision.occurred_at }}">{{ revision.occurred_at|date('M j, Y H:i:s') }}</time>
            </header>
            <p>
              {% if revision.actor_id is defined and revision.actor_id %}{{ t('core.administrator.business_history.performed_by') }} <code>{{ revision.actor_id }}</code>.{% else %}{{ t('core.administrator.business_history.actor_attribution_is_not_disclosed') }}{% endif %}
              {% if revision.changed_fields is not empty %}
                {{ t('core.administrator.business_history.changed', {changed_fields: (revision.changed_fields|join(', '))}) }}
              {% endif %}
            </p>
            {% if revision.snapshot is not empty %}
              <details>
                <summary>{{ t('core.administrator.business_history.view_disclosed_snapshot') }}</summary>
                <dl class="business-history-snapshot">
                  {% for handle, value in revision.snapshot %}
                    <div>
                      <dt>{{ handle|replace({'_': ' '})|title }}</dt>
                      <dd>
                        {{ value is same as(true)
                          ? 'Yes'
                          : (value is same as(false)
                            ? 'No'
                            : (value is null ? t('core.administrator.business_fields.not_set') : (value is iterable ? value|json_encode : value)))
                        }}
                      </dd>
                    </div>
                  {% endfor %}
                </dl>
              </details>
            {% endif %}
            {% if revision.integrity_checksum is defined %}
              <small>{{ t('core.administrator.business_history.integrity_checksum') }} <code>{{ revision.integrity_checksum }}</code></small>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
      {% if has_more and before_version %}
        <nav class="pagination-actions" aria-label="{{ t('core.administrator.business_history.history_pages') }}">
          <a class="button" href="?task=history&amp;before_version={{ before_version }}" rel="next">{{ t('core.administrator.business_history.older_revisions') }}</a>
        </nav>
      {% endif %}
    {% endif %}
  </kumwe-business-surface>
{% endblock %}
