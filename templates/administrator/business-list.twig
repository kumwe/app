{% extends "layout.twig" %}

{% block title %}{{ definition.plural_label }} · Kumwe{% endblock %}
{% block context_title %}{{ definition.plural_label }}{% endblock %}
{% block context_subtitle %}Generated business workspace{% endblock %}

{% block content %}
  {% set searchable_fields = definition.fields|filter(field => field.uses.search)|slice(0, 16) %}
  {% set graphical_filter_fields = definition.fields|filter(field =>
    field.uses.filter
    and not field.write_only
    and field.value_type in ['string', 'reference', 'integer', 'boolean']
  )|slice(0, 128) %}
  {% set bulk_actions = definition.actions|filter(action => action.bulk and not action.high_impact) %}
  {% set bulk_available = query_purpose == 'browse' and (
    available_operations.archive is defined
    or available_operations.restore is defined
    or (available_operations.action is defined and bulk_actions is not empty)
  ) %}
  <kumwe-business-surface
    data-kis-business
    data-kis-component="generated-collection"
    data-kis-surface="core.administrator.generated-definition"
    data-density="{{ collection_presentation.density }}"
    data-representation="{{ collection_presentation.representation }}"
  >
    <header class="page-heading">
      <div>
        <p class="eyebrow">{{ definition.scope|replace({'_': ' '}) }}</p>
        <h1>{{ definition.plural_label }}</h1>
        <p>Browse policy-filtered {{ definition.plural_label|lower }} from definition version {{ definition.version }}.</p>
      </div>
      <div class="page-actions">
        <a class="button" href="{{ business_base_path }}">All workspaces</a>
        {% for declared_view in definition.views %}
          {% if declared_view.custom and (
            declared_view.kind == 'list'
            or (declared_view.kind == 'form' and available_operations.create is defined)
          ) %}
            <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}/views/{{ declared_view.handle|url_encode }}">
              {{ declared_view.label }}
            </a>
          {% endif %}
        {% endfor %}
        {% if available_operations.report is defined %}
          <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}?purpose=report">Report</a>
        {% endif %}
        {% if record_export_report %}
          <form class="business-export-form" method="post" action="/administrator/reports/{{ record_export_report|url_encode }}/exports">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <button class="button" type="submit">Queue CSV export</button>
          </form>
        {% endif %}
        {% if available_operations.create is defined %}
          <a class="button primary" href="{{ business_base_path }}/{{ definition.handle|url_encode }}?new=1">
            Create {{ definition.singular_label|lower }}
          </a>
        {% endif %}
      </div>
    </header>

    {% if completed_operation_id %}
      <div class="notice success" role="status">
        The operation completed.{% if available_operations.status is defined %} <a href="{{ business_base_path }}/operations/{{ completed_operation_id|url_encode }}">View operation status</a>.{% endif %}
      </div>
    {% elseif completed_bulk_count %}
      <div class="notice success" role="status">The bulk operation completed for {{ completed_bulk_count }} record{{ completed_bulk_count == 1 ? '' : 's' }}.</div>
    {% endif %}

    <nav class="kis-business-view-nav" aria-label="Collection views">
      <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}" aria-current="{{ collection_presentation.columns == definition.fields|map(field => field.handle) ? 'page' : 'false' }}">All fields</a>
      {% for declared_view in definition.views %}
        {% if declared_view.kind == 'list' and not declared_view.custom %}
          <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}?{% for column in declared_view.fields %}columns%5B%5D={{ column|url_encode }}{% if not loop.last %}&amp;{% endif %}{% endfor %}" aria-current="{{ collection_presentation.columns == declared_view.fields ? 'page' : 'false' }}">{{ declared_view.label }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    {% if aggregates is not empty %}
      <section class="business-aggregate-grid kis-business-aggregates" aria-label="Report totals">
        {% for label, value in aggregates %}
          <article class="panel business-aggregate kis-business-aggregate"><span>{{ label|replace({'_': ' '})|title }}</span><strong>{{ value }}</strong></article>
        {% endfor %}
      </section>
    {% endif %}

    <section class="panel business-list-panel kis-business-collection" aria-labelledby="business-results-title">
      <div class="table-toolbar business-table-toolbar">
        <div>
          <h2 id="business-results-title">Records</h2>
          <p class="text-muted text-small">Only records and fields disclosed by the current policy are included.</p>
        </div>
        <label class="search-field js-only" for="business-page-search">Filter this page
          <input id="business-page-search" type="search" autocomplete="off" data-business-page-search>
        </label>
        <form class="business-query-form kis-business-query-form" action="{{ business_base_path }}/{{ definition.handle|url_encode }}" method="get">
          {% if query_purpose != 'browse' %}<input type="hidden" name="purpose" value="{{ query_purpose }}">{% endif %}
          {% if searchable_fields is not empty %}
            <label for="business-search">Search records
              <input id="business-search" type="search" name="search_term" value="{{ query_state.search_term|default('') }}">
            </label>
            {% for field in searchable_fields %}<input type="hidden" name="search_fields[]" value="{{ field.handle }}">{% endfor %}
          {% endif %}
          <details class="kis-business-advanced-filters">
            <summary>Filters, sorting and lifecycle</summary>
            <div class="kis-business-advanced-grid">
          {% for field in graphical_filter_fields %}
            {% if field.schema.enum is defined %}
              <label for="business-filter-{{ field.handle }}">{{ field.label }}
                <select id="business-filter-{{ field.handle }}" name="filters[{{ field.handle }}]">
                  <option value="">Any</option>
                  {% for option in field.schema.enum %}
                    <option value="{{ option }}"{% if query_state.filters[field.handle] is defined and query_state.filters[field.handle] is same as(option) %} selected{% endif %}>
                      {{ option|replace({'_': ' '})|title }}
                    </option>
                  {% endfor %}
                </select>
              </label>
            {% elseif field.value_type == 'boolean' %}
              <label for="business-filter-{{ field.handle }}">{{ field.label }}
                <select id="business-filter-{{ field.handle }}" name="boolean_filters[{{ field.handle }}]">
                  <option value="">Any</option>
                  <option value="true"{% if query_state.filters[field.handle] is defined and query_state.filters[field.handle] is same as(true) %} selected{% endif %}>Yes</option>
                  <option value="false"{% if query_state.filters[field.handle] is defined and query_state.filters[field.handle] is same as(false) %} selected{% endif %}>No</option>
                </select>
              </label>
            {% elseif field.value_type == 'integer' %}
              <label for="business-filter-{{ field.handle }}">{{ field.label }}
                <input id="business-filter-{{ field.handle }}" type="number" step="1" name="integer_filters[{{ field.handle }}]" value="{{ query_state.filters[field.handle] is defined ? query_state.filters[field.handle] : '' }}">
              </label>
            {% else %}
              <label for="business-filter-{{ field.handle }}">{{ field.label }}
                <input id="business-filter-{{ field.handle }}" type="{% if field.schema.format|default('') == 'date' %}date{% elseif field.schema.format|default('') == 'time' %}time{% elseif field.schema.format|default('') == 'email' %}email{% else %}text{% endif %}"{% if field.type == 'core.decimal' %} inputmode="decimal"{% endif %} name="filters[{{ field.handle }}]" value="{{ query_state.filters[field.handle] is defined ? query_state.filters[field.handle] : '' }}">
              </label>
            {% endif %}
          {% endfor %}
          {% if graphical_filter_fields is not empty %}<span class="field-help">Choose at most 16 exact field filters.</span>{% endif %}
          <label for="business-sort-field">Sort field
            <select id="business-sort-field" name="sort_field">
              <option value="">Definition order</option>
              {% for field in definition.fields %}
                {% if field.uses.sort %}
                  <option value="{{ field.handle }}"{% if query_state.sort_field is same as(field.handle) %} selected{% endif %}>{{ field.label }}</option>
                {% endif %}
              {% endfor %}
            </select>
          </label>
          <label for="business-sort-direction">Direction
            <select id="business-sort-direction" name="sort_direction">
              <option value=""{% if query_state.sort_direction is null %} selected{% endif %}>Default</option>
              <option value="asc"{% if query_state.sort_direction == 'asc' %} selected{% endif %}>Ascending</option>
              <option value="desc"{% if query_state.sort_direction == 'desc' %} selected{% endif %}>Descending</option>
            </select>
          </label>
          <label for="business-page-size">Rows per page
            <select id="business-page-size" name="page_size">
              {% for size in [25, 50, 100, 200] %}<option value="{{ size }}"{% if query_state.page_size == size %} selected{% endif %}>{{ size }}</option>{% endfor %}
            </select>
          </label>
          {% if available_operations.restore is defined %}
            <label class="check"><input type="checkbox" name="include_archived" value="1"{% if query_state.include_archived %} checked{% endif %}> <span>Include archived</span></label>
            {% if definition.soft_delete %}
              <label class="check"><input type="checkbox" name="include_deleted" value="1"{% if query_state.include_deleted %} checked{% endif %}> <span>Include deleted</span></label>
            {% endif %}
          {% endif %}
            </div>
          </details>
          <details class="kis-business-column-picker">
            <summary>Columns and display</summary>
            <div class="kis-business-column-grid">
              {% for field in definition.fields %}
                <label><input type="checkbox" name="columns[]" value="{{ field.handle }}"{% if field.handle in collection_presentation.columns %} checked{% endif %}> <span>{{ field.label }}</span></label>
              {% endfor %}
              <label for="business-density">Density
                <select id="business-density" name="density">
                  {% for density in ['comfortable', 'compact', 'touch'] %}<option value="{{ density }}"{% if collection_presentation.density == density %} selected{% endif %}>{{ density|title }}</option>{% endfor %}
                </select>
              </label>
              <label for="business-representation">Small-screen view
                <select id="business-representation" name="representation">
                  <option value="auto"{% if collection_presentation.representation == 'auto' %} selected{% endif %}>Automatic</option>
                  <option value="table"{% if collection_presentation.representation == 'table' %} selected{% endif %}>Table</option>
                  <option value="cards"{% if collection_presentation.representation == 'cards' %} selected{% endif %}>Cards</option>
                </select>
              </label>
            </div>
          </details>
          <div class="page-actions">
            <button type="submit">Apply</button>
            <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}{% if query_purpose != 'browse' %}?purpose={{ query_purpose|url_encode }}{% endif %}">Reset</a>
          </div>
        </form>
      </div>

      {% if query_state.filters is not empty or query_state.search_term or query_state.include_archived or query_state.include_deleted %}
        <div class="kis-business-applied-filters" aria-label="Applied filters">
          <strong>Applied:</strong>
          {% if query_state.search_term %}<span class="kis-business-filter-token">Search “{{ query_state.search_term }}”</span>{% endif %}
          {% for handle, value in query_state.filters %}<span class="kis-business-filter-token">{{ handle|replace({'_': ' '})|title }}: {{ value is same as(true) ? 'Yes' : (value is same as(false) ? 'No' : value) }}</span>{% endfor %}
          {% if query_state.include_archived %}<span class="kis-business-filter-token">Archived included</span>{% endif %}
          {% if query_state.include_deleted %}<span class="kis-business-filter-token">Deleted included</span>{% endif %}
          <a href="{{ business_base_path }}/{{ definition.handle|url_encode }}">Clear all</a>
        </div>
      {% endif %}

      {% if items is empty %}
        <div class="empty-state">
          <div class="empty-state-content">
            <h2>No {{ definition.plural_label|lower }} found</h2>
            <p>The current scope and filters returned no visible records.</p>
            {% if available_operations.create is defined %}
              <a class="button primary" href="{{ business_base_path }}/{{ definition.handle|url_encode }}?new=1">
                Create {{ definition.singular_label|lower }}
              </a>
            {% endif %}
          </div>
        </div>
      {% else %}
        {% if bulk_available %}<form class="business-bulk-form" action="{{ business_base_path }}/{{ definition.handle|url_encode }}" method="get">{% endif %}
        <kumwe-business-table>
          <div class="table-wrap business-table-wrap kis-business-table-region" tabindex="0" role="region" aria-label="{{ definition.plural_label }} results" data-scroll-label="Scroll horizontally to review every selected column">
            <table class="business-record-table kis-business-table">
              <thead>
                <tr>
                  {% if bulk_available %}<th scope="col"><span class="sr-only">Select</span></th>{% endif %}
                  <th scope="col">Record</th>
                  {% for field in visible_columns %}<th scope="col">{{ field.label }}</th>{% endfor %}
                  <th scope="col">State</th>
                  <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
              </thead>
              <tbody>
                {% for item in items %}
                  {% set item_state = item.deleted_at ? 'Deleted' : (item.archived_at ? 'Archived' : item.workflow_state|default('Active')) %}
                  <tr data-business-record-row>
                    {% if bulk_available %}
                      <td data-label="Select">
                        <label class="check">
                          <input type="checkbox" name="bulk_records[]" value="{{ {'record_id': item.record_id, 'expected_version': item.version}|json_encode }}">
                          <span class="sr-only">Select record {{ item.record_id }}</span>
                        </label>
                      </td>
                    {% endif %}
                    <th scope="row"><code>{{ item.record_id }}</code><small>v{{ item.version }}</small></th>
                    {% for column in visible_columns %}
                      {% set matches = item.fields|filter(field => field.handle == column.handle) %}
                      <td data-label="{{ column.label }}">
                        {% if matches is not empty %}
                          {{ (matches|first).display is not same as('') ? (matches|first).display : 'Not set' }}
                        {% else %}
                          <span class="text-muted" aria-label="Not available">—</span>
                        {% endif %}
                      </td>
                    {% endfor %}
                    <td data-label="State"><span class="status">{{ item_state|replace({'_': ' '})|title }}</span></td>
                    <td class="actions">
                      {% if available_operations.read is defined %}
                        <a href="{{ business_base_path }}/{{ definition.handle|url_encode }}/{{ item.record_id|url_encode }}">View</a>
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          <ul class="kis-business-card-list" aria-label="{{ definition.plural_label }} summary cards">
            {% for item in items %}
              {% set item_state = item.deleted_at ? 'Deleted' : (item.archived_at ? 'Archived' : item.workflow_state|default('Active')) %}
              <li class="kis-business-result-card">
                <header>
                  <span><strong>{{ definition.singular_label }}</strong><br><code>{{ item.record_id }}</code></span>
                  <span class="status">{{ item_state|replace({'_': ' '})|title }}</span>
                </header>
                {% if bulk_available %}<label class="check"><input type="checkbox" name="bulk_records[]" value="{{ {'record_id': item.record_id, 'expected_version': item.version}|json_encode }}"><span>Select this record</span></label>{% endif %}
                <dl>
                  {% for column in visible_columns %}
                    {% set matches = item.fields|filter(field => field.handle == column.handle) %}
                    <div><dt>{{ column.label }}</dt><dd>{{ matches is not empty ? ((matches|first).display is not same as('') ? (matches|first).display : 'Not set') : 'Not available' }}</dd></div>
                  {% endfor %}
                </dl>
                {% if available_operations.read is defined %}<a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}/{{ item.record_id|url_encode }}">Open record</a>{% endif %}
              </li>
            {% endfor %}
          </ul>
          <p class="business-page-search-empty" role="status" hidden data-business-search-empty>
            No records on this page match your search.
          </p>
        </kumwe-business-table>
        {% if bulk_available %}
          <div class="business-bulk-controls kis-business-bulk-controls">
            <label for="business-bulk-operation">Bulk operation
              <select id="business-bulk-operation" name="bulk_operation" required>
                <option value="" selected disabled>Choose an operation</option>
                {% if available_operations.archive is defined %}<option value="archive">Archive selected</option>{% endif %}
                {% if available_operations.restore is defined %}<option value="restore">Restore selected</option>{% endif %}
                {% if available_operations.action is defined %}
                  {% for action in bulk_actions %}<option value="action:{{ action.handle }}">{{ action.label }} selected</option>{% endfor %}
                {% endif %}
              </select>
            </label>
            <button type="submit">Review bulk operation</button>
            <span class="field-help">Select no more than 50 records. Versions are rechecked when you confirm.</span>
          </div>
        </form>
        {% endif %}
      {% endif %}

      <footer class="pagination kis-business-pagination">
        <span>Bounded record page</span>
        <nav class="pagination-actions" aria-label="Record pages">
          {% if next_query %}
            <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}?{% if query_purpose != 'browse' %}purpose={{ query_purpose|url_encode }}&amp;{% endif %}query={{ next_query|url_encode }}&amp;{{ presentation_query }}" rel="next">
              Next page
            </a>
          {% endif %}
        </nav>
      </footer>
    </section>
  </kumwe-business-surface>
{% endblock %}
