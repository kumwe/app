{% extends "layout.twig" %}
{% block title %}{{ t('core.administrator.extensions.extensions_kumwe') }}{% endblock %}
{% block context_title %}{{ t('core.administrator.extensions.extensions') }}{% endblock %}
{% block content %}
  <div class="kis-phase-five" data-kis-surface="core.administrator.extensions">
    {% include '@kis/page-header.twig' with {
      eyebrow: 'Platform',
      title: 'Extensions',
      purpose: t('core.administrator.extensions.install_verified_packages_manage_activation_and')
    } only %}
    <nav class="kis-phase-five-section-nav" aria-label="{{ t('core.administrator.extensions.extension_management_concerns') }}">
      <a href="#installed-extensions">{{ t('core.administrator.extensions.installed_extensions') }}</a>
      <a href="#install-extension">{{ t('core.administrator.extensions.install_package') }}</a>
      <a href="#extension-trust">{{ t('core.administrator.extensions.signing_trust') }}</a>
    </nav>

    {% if error is defined %}<div class="notice danger" role="alert">{{ error }}</div>{% endif %}

    <section id="installed-extensions" class="panel stack kis-phase-five-card" aria-labelledby="installed-extensions-title">
      <div><p class="eyebrow">{{ t('core.administrator.extensions.installed') }}</p><h2 id="installed-extensions-title">{{ t('core.administrator.extensions.runtime_extensions') }}</h2><p class="text-muted">{{ t('core.administrator.extensions.lifecycle_actions_apply_to_the_selected') }}</p></div>
      {% if extensions is empty %}
        {% include '@kis/empty-state.twig' with {
          title: t('core.administrator.extensions.no_extensions_installed'),
          message: t('core.administrator.extensions.core_content_management_remains_available_instal')
        } only %}
      {% else %}
        <div class="kis-phase-five-extension-grid">
          {% for extension in extensions %}
            <article class="panel kis-phase-five-extension-card" aria-labelledby="extension-{{ loop.index }}-title">
              <header>
                <p class="eyebrow">{{ extension.extension_type|title }}</p>
                <h3 id="extension-{{ loop.index }}-title">
                  {% include '@kis/technical-value.twig' with {
                    label: t('core.administrator.extensions.extension_identifier'),
                    value: extension.identifier,
                    copy: true
                  } only %}
                </h3>
                <p class="kis-phase-five-status-line">
                  <span>{{ extension.extension_type }} · {{ extension.installed_version }} · {{ extension.status }}</span>
                  <span class="status status-{{ extension.status }}">{{ extension.status|title }}</span>
                  {% if extension.theme_surfaces is not empty %}<span>{{ t('core.administrator.extensions.theme', {theme_surfaces: (extension.theme_surfaces|join(', ')|title)}) }}</span>{% endif %}
                </p>
              </header>

              <div class="kis-phase-five-extension-actions" aria-label="{{ t('core.administrator.extensions.lifecycle_actions_for', {identifier: extension.identifier}) }}">
                {% if extension.extension_type == 'template' %}
                  {% if capabilities['themes.site.manage'] is defined %}
                    <form action="/administrator/extensions/action" method="post">
                      <input type="hidden" name="_csrf" value="{{ csrf }}">
                      <input type="hidden" name="identifier" value="{{ extension.identifier }}">
                      <input type="hidden" name="surface" value="site">
                      <button type="submit" name="action" value="activate">{{ t('core.administrator.extensions.use_for_site') }}</button>
                    </form>
                  {% endif %}
                  {% if capabilities['themes.administrator.manage'] is defined %}
                    <form action="/administrator/extensions/action" method="post">
                      <input type="hidden" name="_csrf" value="{{ csrf }}">
                      <input type="hidden" name="identifier" value="{{ extension.identifier }}">
                      <input type="hidden" name="surface" value="administrator">
                      <label>{{ t('core.administrator.access_control.current_password') }}<small>{{ t('core.administrator.extensions.required_only_at_administrator_theme_activation') }}</small><input type="password" name="current_password" autocomplete="current-password" required></label>
                      <button type="submit" name="action" value="activate">{{ t('core.administrator.extensions.use_for_administrator') }}</button>
                    </form>
                  {% endif %}
                {% elseif extension.status != 'active' %}
                  <form action="/administrator/extensions/action" method="post">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="identifier" value="{{ extension.identifier }}">
                    <button type="submit" name="action" value="activate">{{ t('core.administrator.extensions.activate') }}</button>
                  </form>
                {% endif %}

                {% if extension.status == 'active' %}
                  <form action="/administrator/extensions/action" method="post">
                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                    <input type="hidden" name="identifier" value="{{ extension.identifier }}">
                    {% if 'administrator' in extension.theme_surfaces %}<label>{{ t('core.administrator.access_control.current_password') }}<input type="password" name="current_password" autocomplete="current-password" required></label>{% endif %}
                    <button type="submit" name="action" value="disable">{{ t('core.administrator.extensions.disable') }}</button>
                  </form>
                {% endif %}
              </div>

              <div class="kis-phase-five-supply-chain stack">
                <h4>{{ t('core.administrator.extensions.supply_chain') }}</h4>
                {% set supply = extension.supply_chain|default({}) %}
                <p class="kis-phase-five-status-line">
                  <span class="status status-{{ supply.sbom|default('unscanned') == 'verified' ? 'active' : 'disabled' }}">{{ t('core.administrator.extensions.bill_of_materials', {sbom: (supply.sbom|default('unscanned'))}) }}</span>
                  <span class="status status-{{ supply.provenance|default('unscanned') == 'verified' ? 'active' : 'disabled' }}">{{ t('core.administrator.extensions.provenance', {provenance: (supply.provenance|default('unscanned'))}) }}</span>
                  <span class="status status-{{ supply.conformance|default('unscanned') == 'passed' ? 'active' : 'disabled' }}">{{ t('core.administrator.extensions.code_scan', {conformance: (supply.conformance|default('unscanned'))}) }}</span>
                </p>
                {% if supply.components|default(0) > 0 %}<p class="text-muted text-small">{{ t('core.administrator.extensions.packaged_files_inventoried', {components: supply.components}) }}{% if supply.builder %} {{ t('core.administrator.extensions.built_by') }} <code>{{ supply.builder }}</code>{% endif %}.</p>{% endif %}
                {% if supply.sbom|default('unscanned') == 'unscanned' %}<p class="text-muted text-small">{{ t('core.administrator.extensions.this_release_predates_install_time_admission') }}</p>{% endif %}
                {% if supply.findings|default([]) is not empty %}
                  <details class="advanced-definition">
                    <summary>{{ t('core.administrator.extensions.admission_findings', {findings: (supply.findings|length)}) }}</summary>
                    <ul>{% for finding in supply.findings %}<li>{{ finding }}</li>{% endfor %}</ul>
                  </details>
                {% endif %}
              </div>

              <div class="kis-phase-five-contribution-map stack">
                <h4>{{ t('core.administrator.extensions.where_this_extension_appears') }}</h4>
                {% if extension.contribution_summary is defined and extension.contribution_summary is not empty %}
                  {% for group in extension.contribution_summary %}
                    <div class="kis-phase-five-contribution-group">
                      <p class="eyebrow">{{ group.heading }}</p>
                      <ul>
                        {% for entry in group.entries %}
                          <li>
                            {% if entry.active and entry.href is not null %}
                              <a href="{{ entry.href }}">{{ entry.label }}</a>
                            {% else %}
                              <strong>{{ entry.label }}</strong>
                            {% endif %}
                            {% if not entry.active %}<span class="status status-disabled">{{ t('core.administrator.extensions.inactive') }}</span>{% endif %}
                            {% if entry.href is not null and not entry.active %}<code>{{ entry.href }}</code>{% endif %}
                            <span class="text-muted">{{ entry.detail }}</span>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endfor %}
                {% else %}
                  <p class="text-muted">{{ t('core.administrator.extensions.this_release_declares_no_screens_listeners') }}</p>
                {% endif %}
              </div>

              <details class="advanced-definition">
                <summary>{{ t('core.administrator.extensions.declared_contributions_manifest_schema', {manifest_schema: extension.manifest_schema}) }}</summary>
                <div class="stack">
                  {% if extension.contributions.capabilities is empty and extension.contributions.administrator.workspaces is empty and extension.contributions.administrator.navigation is empty and extension.contributions.administrator.routes is empty and extension.contributions.administrator.views is empty %}
                    <p>{{ t('core.administrator.extensions.this_release_has_no_typed_contribution') }}</p>
                  {% endif %}
                  {% if extension.contributions.capabilities is not empty %}
                    <div><strong>{{ t('core.administrator.access_control.capabilities') }}</strong><ul>{% for contribution in extension.contributions.capabilities %}<li><code>{{ contribution.id }}</code> · {{ contribution.label }} · {{ contribution.active ? 'active' : 'inactive' }}</li>{% endfor %}</ul></div>
                  {% endif %}
                  {% if extension.contributions.administrator.workspaces is not empty %}
                    <div><strong>{{ t('core.administrator.extensions.administrator_workspaces') }}</strong><ul>{% for contribution in extension.contributions.administrator.workspaces %}<li><code>{{ contribution.id }}</code> · {{ contribution.label }} · {{ contribution.active ? 'active' : 'inactive' }}</li>{% endfor %}</ul></div>
                  {% endif %}
                  {% if extension.contributions.administrator.navigation is not empty %}
                    <div><strong>{{ t('core.administrator.extensions.administrator_navigation') }}</strong><ul>{% for contribution in extension.contributions.administrator.navigation %}<li><code>{{ contribution.id }}</code> · {{ contribution.path }} · {{ contribution.capability }} · {{ contribution.active ? 'active' : 'inactive' }}</li>{% endfor %}</ul></div>
                  {% endif %}
                  {% if extension.contributions.administrator.routes is not empty %}
                    <div><strong>{{ t('core.administrator.extensions.administrator_routes') }}</strong><ul>{% for contribution in extension.contributions.administrator.routes %}<li><code>{{ contribution.name }}</code> · {{ contribution.methods|join(', ') }} {{ contribution.path }} · {{ contribution.capability }} · {{ contribution.active ? 'active' : 'inactive' }}</li>{% endfor %}</ul></div>
                  {% endif %}
                  {% if extension.contributions.administrator.views is not empty %}
                    <div><strong>{{ t('core.administrator.extensions.templates_and_views') }}</strong><ul>{% for contribution in extension.contributions.administrator.views %}<li><code>{{ contribution.name }}</code> · {{ contribution.template }} · {{ contribution.active ? 'active' : 'inactive' }}</li>{% endfor %}</ul></div>
                  {% endif %}
                </div>
              </details>

              <details class="kis-phase-five-danger-zone">
                <summary>{{ t('core.administrator.extensions.uninstall_extension') }}</summary>
                <form action="/administrator/extensions/action" method="post" class="stack">
                  <input type="hidden" name="_csrf" value="{{ csrf }}">
                  <input type="hidden" name="identifier" value="{{ extension.identifier }}">
                  {% if 'administrator' in extension.theme_surfaces %}<label>{{ t('core.administrator.access_control.current_password') }}<input type="password" name="current_password" autocomplete="current-password" required></label>{% endif %}
                  <p>{{ t('core.administrator.extensions.uninstalling_removes_this_package_from_the') }}</p>
                  <button class="danger" type="submit" name="action" value="uninstall" data-confirm="Uninstall {{ extension.identifier }}?">{{ t('core.administrator.extensions.uninstall', {identifier: extension.identifier}) }}</button>
                </form>
              </details>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </section>

    <section id="install-extension" class="panel panel-body stack kis-phase-five-card" aria-labelledby="install-extension-title">
      <div><p class="eyebrow">{{ t('core.administrator.extensions.install') }}</p><h2 id="install-extension-title">{{ t('core.administrator.extensions.upload_a_verified_package') }}</h2><p class="text-muted text-small">{{ t('core.administrator.extensions.packages_install_disabled_signature_compatibilit') }}</p></div>
      <div class="notice" role="note">
        <p><strong>{{ t('core.administrator.extensions.installing_an_extension_trusts_its_publisher') }}</strong> {{ t('core.administrator.extensions.an_installed_package_is_trusted_in') }}</p>
        <p class="text-small">{{ t('core.administrator.extensions.the_checks_below_prove_who_published') }}</p>
      </div>
      <form action="/administrator/extensions" method="post" enctype="multipart/form-data" class="stack">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <label>{{ t('core.administrator.extensions.kumwe_extension_zip') }}<input type="file" name="package" accept=".zip,application/zip" required></label>
        <label>{{ t('core.administrator.extensions.signing_key_id_signed_production_packages') }}<input type="text" name="key_id"></label>
        <label>{{ t('core.administrator.extensions.ed25519_signature_base64') }}<textarea name="signature" rows="4"></textarea></label>
        <div class="page-actions"><button class="primary" type="submit">{{ t('core.administrator.extensions.verify_and_install') }}</button></div>
      </form>
    </section>

    <div id="extension-trust" class="editor-grid kis-phase-five-card">
      <section class="panel stack" aria-labelledby="extension-trust-title">
        <div><p class="eyebrow">{{ t('core.administrator.extensions.supply_chain') }}</p><h2 id="extension-trust-title">{{ t('core.administrator.extensions.extension_trust_keys') }}</h2><p class="text-muted">{{ t('core.administrator.extensions.rotation_and_emergency_revocation_are_explicit') }}</p></div>
        {% set feed = revocation_feed|default({'configured': false}) %}
        {% if feed.configured %}
          <div class="notice {{ feed.stale ? 'danger' : 'info' }}" role="status">
            <p><strong>{{ t('core.administrator.extensions.upstream_revocation_feed', {stale: feed.stale}) }}</strong>
            {{ t('core.administrator.extensions.issuer_list_keys_withdrawn_upstream_last', {issuer: (feed.issuer|default(t('core.administrator.extensions.none_yet'))), sequence: feed.sequence, revoked_keys: feed.revoked_keys, last_success_at: (feed.last_success_at|default('never'))}) }}</p>
            {% if feed.stale %}<p>{{ t_html('core.administrator.extensions.the_last_applied_list_stays_in', {origin: feed.origin}) }}</p>{% endif %}
            {% if feed.last_failure_reason %}<p class="text-small">{{ t('core.administrator.extensions.last_failure_consecutive', {last_failure_at: feed.last_failure_at, consecutive_failures: feed.consecutive_failures, last_failure_reason: feed.last_failure_reason}) }}</p>{% endif %}
          </div>
        {% else %}
          <p class="text-muted text-small">{{ t_html('core.administrator.extensions.no_upstream_revocation_feed_is_configured') }}</p>
        {% endif %}
        {% if trust_keys is empty %}
          {% include '@kis/empty-state.twig' with {
            title: t('core.administrator.extensions.no_trusted_signing_keys'),
            message: t('core.administrator.extensions.signed_production_packages_cannot_be_activated')
          } only %}
        {% endif %}
        {% for key in trust_keys %}
          <article class="panel kis-phase-five-extension-card">
            <h3>{% include '@kis/technical-value.twig' with {label: t('core.administrator.extensions.signing_key_identifier'), value: key.key_id, copy: true} only %}</h3>
            <p class="kis-phase-five-status-line"><span>{{ key.vendor_namespace }}/{{ key.extension_pattern }}</span><span>{{ t('core.administrator.extensions.expires', {expires_at: key.expires_at}) }}</span>{% if key.revoked_at %}<span class="status status-failed">{{ t('core.administrator.extensions.revoked') }}</span>{% endif %}</p>
            {% if key.affected_extensions is not empty %}<p class="kis-phase-five-security-note">{{ t('core.administrator.extensions.releases_requiring_upgrade_or_quarantine', {affected_extensions: (key.affected_extensions|join(', '))}) }}</p>{% endif %}
            {% if not key.revoked_at %}
              <details class="advanced-definition">
                <summary>{{ t('core.administrator.extensions.rotate_key') }}</summary>
                <form action="/administrator/extensions/action" method="post" class="stack">
                  <input type="hidden" name="_csrf" value="{{ csrf }}">
                  <input type="hidden" name="action" value="trust-rotate">
                  <input type="hidden" name="old_key_id" value="{{ key.key_id }}">
                  <label>{{ t('core.administrator.extensions.new_key_id') }}<input type="text" name="new_key_id" maxlength="127" required></label>
                  <label>{{ t('core.administrator.extensions.new_ed25519_public_key_base64') }}<textarea name="public_key_base64" rows="3" required></textarea></label>
                  <label>{{ t('core.administrator.extensions.vendor_namespace') }}<input type="text" name="vendor_namespace" value="{{ key.vendor_namespace }}"></label>
                  <label>{{ t('core.administrator.extensions.extension_name_constraint') }}<input type="text" name="extension_pattern" value="{{ key.extension_pattern }}"></label>
                  <label>{{ t('core.administrator.access_control.expires_at') }}<input type="datetime-local" name="expires_at" required></label>
                  <button type="submit">{{ t('core.administrator.extensions.begin_rotation_overlap') }}</button>
                </form>
              </details>
              <details class="advanced-definition">
                <summary>{{ t('core.administrator.extensions.finalize_planned_rotation') }}</summary>
                <form action="/administrator/extensions/action" method="post" class="stack">
                  <input type="hidden" name="_csrf" value="{{ csrf }}">
                  <input type="hidden" name="key_id" value="{{ key.key_id }}">
                  <label>{{ t('core.administrator.extensions.revocation_reason') }}<input type="text" name="reason" maxlength="500" required></label>
                  <button type="submit" name="action" value="trust-revoke">{{ t('core.administrator.extensions.finalize_rotation') }}</button>
                </form>
              </details>
              <details class="kis-phase-five-danger-zone">
                <summary>{{ t('core.administrator.extensions.emergency_revoke_and_quarantine') }}</summary>
                <form action="/administrator/extensions/action" method="post" class="stack">
                  <input type="hidden" name="_csrf" value="{{ csrf }}">
                  <input type="hidden" name="key_id" value="{{ key.key_id }}">
                  <label>{{ t('core.administrator.extensions.emergency_reason') }}<input type="text" name="reason" maxlength="500" required></label>
                  <p>{{ t('core.administrator.extensions.immediately_revokes_trust_and_quarantines_affect') }}</p>
                  <button class="danger" type="submit" name="action" value="trust-emergency-revoke">{{ t('core.administrator.extensions.emergency_revoke_and_quarantine') }}</button>
                </form>
              </details>
            {% endif %}
          </article>
        {% endfor %}
      </section>
      <aside class="panel stack" aria-labelledby="add-signing-key-title">
        <div><p class="eyebrow">{{ t('core.administrator.extensions.trust') }}</p><h2 id="add-signing-key-title">{{ t('core.administrator.extensions.add_signing_key') }}</h2></div>
        <form action="/administrator/extensions/action" method="post" class="stack">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <input type="hidden" name="action" value="trust-add">
          <label>{{ t('core.administrator.extensions.key_id') }}<input type="text" name="key_id" maxlength="127" required></label>
          <label>{{ t('core.administrator.extensions.ed25519_public_key_base64') }}<textarea name="public_key_base64" rows="3" required></textarea></label>
          <label>{{ t('core.administrator.extensions.vendor_namespace') }}<input type="text" name="vendor_namespace" value="*"></label>
          <label>{{ t('core.administrator.extensions.extension_name_constraint') }}<input type="text" name="extension_pattern" value="*"></label>
          <label>{{ t('core.administrator.access_control.expires_at') }}<input type="datetime-local" name="expires_at" required></label>
          <button class="primary" type="submit">{{ t('core.administrator.extensions.add_trusted_key') }}</button>
        </form>
      </aside>
    </div>
  </div>
{% endblock %}
