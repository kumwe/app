{% extends "layout.twig" %}
{% block title %}Site settings · Kumwe{% endblock %}
{% block context_title %}Site settings{% endblock %}
{% block content %}
  <header class="page-heading"><div><p class="eyebrow">Website</p><h1>Site settings</h1><p>Control the public identity, homepage, language, timezone, and search visibility.</p></div><div class="page-actions"><a class="button" href="/" target="_blank" rel="noopener">View website</a></div></header>
  {% if saved %}<div class="notice success" role="status"><span>Settings saved.</span><button class="notice-dismiss" type="button" aria-label="Dismiss" data-dismiss-notice>×</button></div>{% endif %}
  <div class="editor-grid">
    <form class="panel editor-main editor-form stack" action="/administrator/settings" method="post"><input type="hidden" name="_csrf" value="{{ csrf }}">
      <fieldset class="field-group stack"><legend>Public identity</legend><label>Site name<small>Shown in the built-in header, page titles, and public footer.</small><input name="site_name" value="{{ settings.site_name }}" maxlength="160" required></label><label>Homepage slug<small>Publish a page with this slug; Kumwe presents it at the root address.</small><span class="input-prefix"><span>/pages/</span><input name="homepage_slug" value="{{ settings.homepage_slug }}" pattern="[a-z0-9]+(-[a-z0-9]+)*" required></span></label></fieldset>
      <fieldset class="field-group stack"><legend>Regional defaults</legend><div class="two-column"><label>Default locale<small>Use a language-region value such as en-NA.</small><input name="default_locale" value="{{ settings.default_locale }}" maxlength="35" required></label><label>Timezone<small>Use an IANA timezone such as Africa/Windhoek.</small><input name="timezone" value="{{ settings.timezone }}" maxlength="80" required></label></div></fieldset>
      <fieldset class="field-group stack"><legend>Search engines</legend><label class="check"><input type="checkbox" name="search_indexing_enabled" value="1"{% if settings.search_indexing_enabled %} checked{% endif %}><span>Allow search indexing<small>When disabled, Kumwe publishes no-index instructions. It does not make content private.</small></span></label></fieldset>
      <div class="page-actions"><button class="primary" type="submit">Save settings</button></div>
    </form>
    <aside class="editor-sidebar stack"><section class="panel panel-body stack"><div><p class="eyebrow">Presentation</p><h2>Public website</h2></div><p class="text-muted text-small">The built-in public shell uses these settings together with the managed main menu. Site themes can override presentation without changing content.</p><a href="/administrator/navigation">Manage public menu</a></section><section class="panel panel-body stack"><div><p class="eyebrow">Protected boundary</p><h2>Infrastructure settings</h2></div><p class="text-muted text-small">Database, Redis, secrets, trusted proxies, and releases remain deployment configuration and cannot be changed from a browser session.</p></section></aside>
  </div>
{% endblock %}
