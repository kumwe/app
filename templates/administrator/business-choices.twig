{% extends "layout.twig" %}

{% block title %}{{ t('core.administrator.business_choices.choose_a_value_kumwe') }}{% endblock %}
{% block context_title %}{{ t('core.administrator.business_choices.choose_a_value') }}{% endblock %}
{% block context_subtitle %}{{ t('core.administrator.business_choices.policy_filtered_generated_business_choices') }}{% endblock %}

{% block content %}
  <kumwe-business-surface data-kis-business data-kis-component="generated-choice-browser" data-kis-surface="core.administrator.generated-choices">
    <header class="page-heading">
      <div>
        <p class="eyebrow">{{ choice_kind == 'media' ? t('core.administrator.business_choices.media_reference') : t('core.administrator.business_choices.related_record') }}</p>
        <h1>{{ t('core.administrator.business_choices.choose', {choice_handle: (choice_handle|replace({'_': ' '}))}) }}</h1>
        <p>{{ t('core.administrator.business_choices.only_values_available_to_this_field') }}</p>
      </div>
      <div class="page-actions">
        <a class="button" href="{{ choice_return_path }}">{{ t('core.administrator.business_choices.return_without_choosing') }}</a>
      </div>
    </header>

    <section class="panel stack" aria-labelledby="choice-search-title">
      <div class="section-heading">
        <div>
          <h2 id="choice-search-title">{{ t('core.administrator.business_choices.search_choices') }}</h2>
          <p>{{ t('core.administrator.business_choices.search_remains_within_the_server_authorized') }}</p>
        </div>
      </div>
      <form method="get" class="business-query-form compact-form kis-business-query-form">
        <input type="hidden" name="operation" value="{{ choice_operation }}">
        {% if choice_kind == 'media' %}
          <label for="choice-search">{{ t('core.administrator.business_choices.media_name') }}</label>
          <input id="choice-search" type="search" name="search" value="{{ choice_search }}" maxlength="200">
        {% elseif choice_search_fields is not empty %}
          <label for="choice-search">{{ t('core.administrator.business_choices.search_related_records') }}</label>
          <input
            id="choice-search"
            type="search"
            name="search_term"
            value="{{ choice_query_state.search_term|default('') }}"
            maxlength="500"
          >
          {% for field in choice_search_fields %}
            <input type="hidden" name="search_fields[]" value="{{ field.handle }}">
          {% endfor %}
          <input type="hidden" name="page_size" value="50">
          <p class="field-help">
            {{ t('core.administrator.business_choices.searches', {choice_search_fields: (choice_search_fields|map(field => field.label)|join(', '))}) }}
          </p>
        {% else %}
          <p class="empty-state">{{ t('core.administrator.business_choices.no_search_fields_are_available_browse') }}</p>
        {% endif %}
        {% if choice_kind == 'media' or choice_search_fields is not empty %}
          <div class="page-actions">
            <button class="primary" type="submit">{{ t('core.administrator.business_choices.search') }}</button>
          </div>
        {% endif %}
      </form>
    </section>

    <section class="panel stack" aria-labelledby="choice-results-title">
      <div class="section-heading">
        <div>
          <h2 id="choice-results-title">{{ t('core.administrator.business_choices.available_choices') }}</h2>
          <p>{{ t('core.administrator.business_choices.choose_one_value_to_return_it') }}</p>
        </div>
        <span class="status">{{ t('core.administrator.business_choices.on_this_page', {choices: (choices|length)}) }}</span>
      </div>
      {% if choices is empty %}
        <p class="empty-state">{{ t('core.administrator.business_choices.no_available_choices_match_this_search') }}</p>
      {% else %}
        <div class="table-wrap business-choice-table kis-business-table-region" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_choices.available_choices_table') }}" data-scroll-label="Scroll horizontally to review choice details">
          <table class="kis-business-table">
            <thead>
              <tr>
                <th scope="col">{{ t('core.administrator.business_choices.choice') }}</th>
                {% if choice_kind == 'related' %}<th scope="col">{{ t('core.administrator.business_choices.details') }}</th>{% endif %}
                <th scope="col"><span class="visually-hidden">{{ t('core.administrator.business_choices.select') }}</span></th>
              </tr>
            </thead>
            <tbody>
              {% for choice in choices %}
                <tr>
                  <th scope="row">{{ choice.label }}</th>
                  {% if choice_kind == 'related' %}
                    <td>
                      {% if choice.fields is empty %}
                        <span class="muted">{{ t('core.administrator.business_choices.no_additional_disclosed_fields') }}</span>
                      {% else %}
                        <dl class="business-choice-fields kis-business-details">
                          {% for field in choice.fields %}
                            <div><dt>{{ field.label }}</dt><dd>{{ field.display is not empty ? field.display : t('core.administrator.business_fields.not_set') }}</dd></div>
                          {% endfor %}
                        </dl>
                      {% endif %}
                    </td>
                  {% endif %}
                  <td class="table-actions">
                    <a
                      class="button"
                      href="{{ choice_return_path }}&amp;choice_value={{ choice.id|url_encode }}&amp;choice_label={{ choice.label|url_encode }}"
                    >{{ t('core.administrator.business_choices.choose_2') }}</a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
      {% if next_query %}
        <div class="page-actions">
          <a
            class="button"
            rel="next"
            href="?operation={{ choice_operation|url_encode }}&amp;query={{ next_query|url_encode }}"
          >{{ t('core.administrator.business_choices.next_choices') }}</a>
        </div>
      {% endif %}
    </section>
  </kumwe-business-surface>
{% endblock %}
