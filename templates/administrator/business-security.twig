{% extends "layout.twig" %}

{% macro step_up() %}
  <fieldset class="field-group stack">
    <legend>{{ t('core.administrator.access_control.verify_this_exact_action') }}</legend>
    <p class="text-muted text-small">{{ t('core.administrator.business_security.verification_is_requested_only_at_submission') }}</p>
    <label>{{ t('core.administrator.access_control.verification_method') }}
      <select name="step_up_method">
        <option value="totp">{{ t('core.administrator.access_control.authenticator_code') }}</option>
        <option value="recovery">{{ t('core.administrator.access_control.recovery_code') }}</option>
      </select>
    </label>
    <div class="two-column">
      <label>{{ t('core.administrator.access_control.authenticator_code') }}<input name="step_up_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}"></label>
      <label>{{ t('core.administrator.access_control.recovery_code') }}<input name="recovery_code" autocomplete="one-time-code" maxlength="128"></label>
    </div>
    <small>{{ t('core.administrator.business_security.fill_only_the_field_matching_the') }}</small>
  </fieldset>
{% endmacro %}

{% import _self as security_forms %}
{% set section = workspace.section %}
{% set mode = workspace.mode %}
{% set selected_id = workspace.id %}

{% block title %}{{ t('core.administrator.business_security.business_security_kumwe') }}{% endblock %}
{% block context_title %}{{ t('core.administrator.business_security.business_security') }}{% endblock %}
{% block content %}
<div data-kis-surface="core.administrator.business-security" data-kis-component="local-navigation">
  {% embed '@kis/page-header.twig' with {
    eyebrow: t('core.administrator.business_security.business_authority'),
    title: t('core.administrator.business_security.business_security'),
    purpose: t('core.administrator.business_security.govern_organization_boundaries_membership_row_an')
  } %}
    {% block metadata %}
      <p><strong>{{ t('core.administrator.access_control.authority_context') }}</strong> {{ active_organization|default('Installation-wide') }}{% if active_workspace %} / {{ active_workspace }}{% endif %}</p>
    {% endblock %}
    {% block actions %}
      <div class="page-actions"><a class="button" href="/administrator/access?section=users">{{ t('core.administrator.business_security.open_users_access') }}</a></div>
    {% endblock %}
  {% endembed %}

  {% if saved %}<div class="notice success" role="status"><span>{{ t('core.administrator.business_security.business_security_updated') }}</span><button class="notice-dismiss" type="button" aria-label="{{ t('core.administrator.access_control.dismiss') }}" data-dismiss-notice>×</button></div>{% endif %}

  <nav class="panel" aria-label="{{ t('core.administrator.business_security.business_security_concerns') }}">
    <div class="actions">
      {% for item in [
        {id: 'overview', label: 'Overview'},
        {id: 'organizations', label: 'Organizations'},
        {id: 'memberships', label: 'Memberships'},
        {id: 'policies', label: 'Policies'},
        {id: 'approvals', label: 'Approvals'},
        {id: 'credentials', label: 'Credentials'}
      ] %}
        <a class="button{% if section == item.id %} primary{% endif %}" href="/administrator/business-security?section={{ item.id }}"{% if section == item.id %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </div>
  </nav>

  {% if section == 'overview' %}
    <section class="stack" aria-labelledby="security-overview-heading">
      <div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.scoped_summary') }}</p><h2 id="security-overview-heading">{{ t('core.administrator.business_security.authority_overview') }}</h2><p>{{ t('core.administrator.business_security.counts_include_only_records_visible_in') }}</p></div></div>
      <div class="admin-grid">
        <article class="role-card"><h3>{{ t('core.administrator.business_security.organizations') }}</h3><p><strong>{{ security.organizations|length }}</strong> {{ t('core.administrator.business_security.policy_boundaries_and_workspaces', {workspaces: (security.workspaces|length)}) }}</p><a class="button" href="/administrator/business-security?section=organizations">{{ t('core.administrator.business_security.review_boundaries') }}</a></article>
        <article class="role-card"><h3>{{ t('core.administrator.business_security.memberships') }}</h3><p><strong>{{ security.memberships|length }}</strong> {{ t('core.administrator.business_security.visible_memberships_with_explainable_effective_a') }}</p><a class="button" href="/administrator/business-security?section=memberships">{{ t('core.administrator.business_security.review_membership') }}</a></article>
        <article class="role-card"><h3>{{ t('core.administrator.business_security.policies') }}</h3><p><strong>{{ security.resource_policies|length }}</strong> {{ t('core.administrator.business_security.row_or_field_policies_and_maker', {separation_rules: (security.separation_rules|length)}) }}</p><a class="button" href="/administrator/business-security?section=policies">{{ t('core.administrator.business_security.review_policy') }}</a></article>
        <article class="role-card"><h3>{{ t('core.administrator.business_security.approvals') }}</h3><p><strong>{{ security.approvals|length }}</strong> {{ t('core.administrator.business_security.visible_requests_in_this_authority_scope') }}</p><a class="button" href="/administrator/business-security?section=approvals">{{ t('core.administrator.business_security.open_approval_work') }}</a></article>
        <article class="role-card"><h3>{{ t('core.administrator.business_security.credentials') }}</h3><p>{{ t('core.administrator.business_security.status_and_delegation_diagnostics_never_disclose') }}</p><a class="button" href="/administrator/business-security?section=credentials">{{ t('core.administrator.business_security.inspect_assurance') }}</a></article>
        <article class="role-card"><h3>{{ t('core.administrator.business_security.portal_readiness') }}</h3><p>{{ t('core.administrator.business_security.create_an_active_identity_then_add') }}</p><a class="button" href="/administrator/access?section=users&mode=create">{{ t('core.administrator.business_security.start_provisioning') }}</a></article>
      </div>
    </section>

  {% elseif section == 'organizations' %}
    {% if mode == 'create' %}
      <p><a href="/administrator/business-security?section=organizations">{{ t('core.administrator.business_security.organization_catalog') }}</a></p>
      <nav class="actions" aria-label="{{ t('core.administrator.business_security.create_authority_boundary') }}">
        <a class="button{% if workspace.kind == 'organization' %} primary{% endif %}" href="/administrator/business-security?section=organizations&amp;mode=create&amp;kind=organization"{% if workspace.kind == 'organization' %} aria-current="page"{% endif %}>{{ t('core.administrator.business_security.new_organization') }}</a>
        <a class="button{% if workspace.kind == 'workspace' %} primary{% endif %}" href="/administrator/business-security?section=organizations&amp;mode=create&amp;kind=workspace"{% if workspace.kind == 'workspace' %} aria-current="page"{% endif %}>{{ t('core.administrator.business_security.new_workspace') }}</a>
      </nav>
      {% if workspace.kind == 'workspace' %}
        <section class="panel stack" aria-labelledby="create-workspace-heading">
          <div><p class="eyebrow">{{ t('core.administrator.access_control.focused_authoring') }}</p><h2 id="create-workspace-heading">{{ t('core.administrator.business_security.create_workspace') }}</h2><p>{{ t('core.administrator.business_security.a_workspace_is_always_nested_inside') }}</p></div>
          {% if security.organizations is empty %}
            {% embed '@kis/empty-state.twig' with {title: t('core.administrator.business_security.an_organization_is_required'), message: t('core.administrator.business_security.create_the_policy_boundary_before_adding')} %}{% block action %}<a class="button primary" href="/administrator/business-security?section=organizations&amp;mode=create&amp;kind=organization">{{ t('core.administrator.business_security.create_organization') }}</a>{% endblock %}{% endembed %}
          {% else %}
            <form method="post" action="/administrator/business-security?section=organizations" class="stack">
              <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="workspace.create">
              <label>{{ t('core.administrator.business_security.organization') }}<select name="organization_id" required>{% for organization in security.organizations %}<option value="{{ organization.id }}">{{ organization.name }} · {{ organization.identifier }}</option>{% endfor %}</select></label>
              <label>{{ t('core.administrator.business_security.identifier') }}<input name="identifier" pattern="[a-z0-9][a-z0-9._:-]{0,190}" maxlength="191" required><small>{{ t('core.administrator.business_security.stable_lowercase_identifier_used_in_membership') }}</small></label>
              <label>{{ t('core.administrator.access_control.name') }}<input name="name" maxlength="191" required></label>
              {{ security_forms.step_up() }}
              <div class="page-actions"><button class="primary" type="submit">{{ t('core.administrator.business_security.create_workspace') }}</button><a class="button" href="/administrator/business-security?section=organizations">{{ t('core.administrator.access_control.cancel') }}</a></div>
            </form>
          {% endif %}
        </section>
      {% else %}
        <section class="panel stack" aria-labelledby="create-organization-heading">
          <div><p class="eyebrow">{{ t('core.administrator.access_control.focused_authoring') }}</p><h2 id="create-organization-heading">{{ t('core.administrator.business_security.create_organization') }}</h2><p>{{ t('core.administrator.business_security.the_organization_becomes_a_site_owned') }}</p></div>
          <form method="post" action="/administrator/business-security?section=organizations" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="organization.create">
            <label>{{ t('core.administrator.business_security.identifier') }}<input name="identifier" pattern="[a-z0-9][a-z0-9._:-]{0,190}" maxlength="191" required></label>
            <label>{{ t('core.administrator.access_control.name') }}<input name="name" maxlength="191" required></label>
            {{ security_forms.step_up() }}
            <div class="page-actions"><button class="primary" type="submit">{{ t('core.administrator.business_security.create_organization') }}</button><a class="button" href="/administrator/business-security?section=organizations">{{ t('core.administrator.access_control.cancel') }}</a></div>
          </form>
        </section>
      {% endif %}
    {% else %}
      <section class="panel stack" aria-labelledby="organization-heading">
        <header class="panel-header section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.authority_boundaries') }}</p><h2 id="organization-heading">{{ t('core.administrator.business_security.organizations_and_workspaces') }}</h2><p>{{ t('core.administrator.business_security.browse_first_creation_remains_a_separate') }}</p></div><a class="button primary" href="/administrator/business-security?section=organizations&amp;mode=create&amp;kind=organization">{{ t('core.administrator.business_security.create_organization') }}</a></header>
        {% if security.organizations is empty %}
          {% embed '@kis/empty-state.twig' with {title: t('core.administrator.business_security.no_organizations_configured'), message: t('core.administrator.business_security.create_the_first_site_owned_authority')} %}{% block action %}<a class="button primary" href="/administrator/business-security?section=organizations&amp;mode=create&amp;kind=organization">{{ t('core.administrator.business_security.create_organization') }}</a>{% endblock %}{% endembed %}
        {% else %}
          <div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_security.organizations_and_workspaces') }}"><table>
            <thead><tr><th scope="col">{{ t('core.administrator.business_security.organization') }}</th><th scope="col">{{ t('core.administrator.access_control.status') }}</th><th scope="col">{{ t('core.administrator.business_security.policy_generation') }}</th><th scope="col">{{ t('core.administrator.business_security.workspaces') }}</th></tr></thead>
            <tbody>{% for organization in security.organizations %}<tr>
              <th scope="row"><strong>{{ organization.name }}</strong><br>{% include '@kis/technical-value.twig' with {label: t('core.administrator.business_security.organization_identifier'), value: organization.identifier} only %}</th>
              <td><span class="status status-{{ organization.status }}">{{ organization.status|title }}</span></td>
              <td>{{ organization.policy_generation }} <small>{{ t('core.administrator.business_security.record_version', {version: organization.version}) }}</small></td>
              <td>{% for item in security.workspaces|filter(item => item.organization_id == organization.id) %}<span class="status status-{{ item.status }}">{{ item.name }} · {{ item.identifier }}</span> {% else %}<span class="text-muted">{{ t('core.administrator.business_security.no_workspaces') }}</span>{% endfor %}</td>
            </tr>{% endfor %}</tbody>
          </table></div>
          <div class="page-actions"><a class="button" href="/administrator/business-security?section=organizations&amp;mode=create&amp;kind=workspace">{{ t('core.administrator.business_security.create_workspace') }}</a></div>
        {% endif %}
      </section>
    {% endif %}

  {% elseif section == 'memberships' %}
    {% set membership = selected_id ? security.memberships|filter(item => item.id == selected_id)|first : null %}
    {% if mode == 'create' %}
      <p><a href="/administrator/business-security?section=memberships">{{ t('core.administrator.business_security.membership_catalog') }}</a></p>
      <section class="panel stack" aria-labelledby="create-membership-heading">
        <div><p class="eyebrow">{{ t('core.administrator.business_security.portal_provisioning_step_2') }}</p><h2 id="create-membership-heading">{{ t('core.administrator.business_security.create_organization_membership') }}</h2><p>{{ t('core.administrator.business_security.choose_an_active_identity_and_authority') }}</p></div>
        {% if security.organizations is empty or security.users is empty %}
          {% embed '@kis/empty-state.twig' with {title: t('core.administrator.business_security.provisioning_prerequisites_are_incomplete'), message: security.organizations is empty ? t('core.administrator.business_security.create_an_organization_before_a_membership') : t('core.administrator.business_security.create_an_active_user_before_a')} %}
            {% block action %}{% if security.organizations is empty %}<a class="button primary" href="/administrator/business-security?section=organizations&amp;mode=create&amp;kind=organization">{{ t('core.administrator.business_security.create_organization') }}</a>{% else %}<a class="button primary" href="/administrator/access?section=users&amp;mode=create">{{ t('core.administrator.access_control.create_user') }}</a>{% endif %}{% endblock %}
          {% endembed %}
        {% else %}
          <form method="post" action="/administrator/business-security?section=memberships" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="membership.create">
            <div class="form-grid">
              <label>{{ t('core.administrator.business_security.organization') }}<select name="organization_id" required>{% for organization in security.organizations %}<option value="{{ organization.id }}">{{ organization.name }} · {{ organization.identifier }}</option>{% endfor %}</select></label>
              <label>{{ t('core.administrator.access_control.user') }}<select name="user_id" required>{% for user in security.users %}<option value="{{ user.id }}">{{ user.display_name }} · {{ user.email }}</option>{% endfor %}</select></label>
              <label>{{ t('core.administrator.business_security.valid_from') }}<input type="datetime-local" name="valid_from" required></label>
              <label>{{ t('core.administrator.business_security.valid_until') }} <span class="text-muted">{{ t('core.administrator.access_control.optional') }}</span><input type="datetime-local" name="valid_until"></label>
            </div>
            {{ security_forms.step_up() }}
            <div class="page-actions"><button class="primary" type="submit">{{ t('core.administrator.business_security.create_membership') }}</button><a class="button" href="/administrator/business-security?section=memberships">{{ t('core.administrator.access_control.cancel') }}</a></div>
          </form>
        {% endif %}
      </section>
    {% elseif mode == 'edit' %}
      <p><a href="/administrator/business-security?section=memberships">{{ t('core.administrator.business_security.membership_catalog') }}</a></p>
      {% if not membership %}
        {% embed '@kis/empty-state.twig' with {title: t('core.administrator.business_security.membership_unavailable'), message: t('core.administrator.business_security.the_membership_does_not_exist_in')} %}{% block action %}<a class="button" href="/administrator/business-security?section=memberships">{{ t('core.administrator.business_security.return_to_memberships') }}</a>{% endblock %}{% endembed %}
      {% else %}
        <section class="panel stack" aria-labelledby="edit-membership-heading">
          <div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.focused_edit') }}</p><h2 id="edit-membership-heading">{{ membership.display_name }}</h2><p>{{ t('core.administrator.business_security.version', {organization_identifier: membership.organization_identifier, status: (membership.status|title), version: membership.version}) }}{% if membership.expired %} {{ t('core.administrator.business_security.expired') }}{% endif %}</p></div><a class="button" href="/administrator/business-security?section=memberships&amp;mode=review&amp;id={{ membership.id|url_encode }}">{{ t('core.administrator.business_security.explain_access') }}</a></div>
          <form method="post" action="/administrator/business-security?section=memberships" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="membership.status"><input type="hidden" name="membership_id" value="{{ membership.id }}"><input type="hidden" name="version" value="{{ membership.version }}">
            <label>{{ t('core.administrator.access_control.status') }}<select name="status">{% for status in ['active','suspended','revoked'] %}<option value="{{ status }}"{% if membership.status == status %} selected{% endif %}>{{ status|title }}</option>{% endfor %}</select></label>
            {{ security_forms.step_up() }}<button class="primary" type="submit">{{ t('core.administrator.business_security.save_membership_status') }}</button>
          </form>
          <div class="admin-grid">
            <form method="post" action="/administrator/business-security?section=memberships" class="role-card stack">
              <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="membership_id" value="{{ membership.id }}">
              <h3>{{ t('core.administrator.business_security.workspace_assignment') }}</h3><label>{{ t('core.administrator.business_security.workspace') }}<select name="workspace_id" required>{% for item in security.workspaces|filter(item => item.organization_id == membership.organization_id) %}<option value="{{ item.id }}">{{ item.name }}</option>{% endfor %}</select></label>
              {{ security_forms.step_up() }}<div class="actions"><button name="action" value="membership.workspace.assign">{{ t('core.administrator.business_security.assign_workspace') }}</button><button class="danger" name="action" value="membership.workspace.revoke">{{ t('core.administrator.business_security.revoke_workspace') }}</button></div>
            </form>
            <form method="post" action="/administrator/business-security?section=memberships" class="role-card stack">
              <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="membership_id" value="{{ membership.id }}">
              <h3>{{ t('core.administrator.business_security.role_assignment') }}</h3><label>{{ t('core.administrator.access_control.role') }}<select name="role_id" required>{% for role in security.roles %}<option value="{{ role.id }}">{{ role.name }} · {{ role.code }}</option>{% endfor %}</select></label>
              {{ security_forms.step_up() }}<div class="actions"><button name="action" value="membership.role.assign">{{ t('core.administrator.access_control.assign_role') }}</button><button class="danger" name="action" value="membership.role.revoke">{{ t('core.administrator.business_security.revoke_role') }}</button></div>
            </form>
          </div>
        </section>
      {% endif %}
    {% elseif mode == 'review' %}
      <p><a href="/administrator/business-security?section=memberships">{{ t('core.administrator.business_security.membership_catalog') }}</a></p>
      {% if not membership %}
        {% embed '@kis/empty-state.twig' with {title: t('core.administrator.business_security.membership_unavailable'), message: t('core.administrator.business_security.the_membership_does_not_exist_in')} %}{% endembed %}
      {% else %}
        <section class="panel stack" aria-labelledby="effective-access-heading">
          <div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.explainable_authority') }}</p><h2 id="effective-access-heading">{{ t('core.administrator.business_security.effective_access_for', {display_name: membership.display_name}) }}</h2><p>{{ t('core.administrator.business_security.version', {organization_identifier: membership.organization_identifier, status: (membership.status|title), version: membership.version}) }}</p></div><a class="button" href="/administrator/business-security?section=memberships&amp;mode=edit&amp;id={{ membership.id|url_encode }}">{{ t('core.administrator.business_security.edit_membership') }}</a></div>
          <div class="two-column"><div><h3>{{ t('core.administrator.business_security.workspaces') }}</h3>{% for item in membership.workspaces %}<span class="status">{{ item.name }}</span> {% else %}<span class="text-muted">{{ t('core.administrator.business_security.organization_wide') }}</span>{% endfor %}</div><div><h3>{{ t('core.administrator.business_security.roles') }}</h3>{% for role in membership.roles %}<span class="status">{{ role.name }}</span> {% else %}<span class="text-muted">{{ t('core.administrator.business_security.no_roles') }}</span>{% endfor %}</div></div>
          <div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_security.effective_access_for', {display_name: membership.display_name}) }}"><table>
            <thead><tr><th scope="col">{{ t('core.administrator.access_control.capability') }}</th><th scope="col">{{ t('core.administrator.business_security.source') }}</th><th scope="col">{{ t('core.administrator.access_control.scope') }}</th><th scope="col">{{ t('core.administrator.business_security.impact') }}</th><th scope="col">{{ t('core.administrator.business_security.decision') }}</th></tr></thead>
            <tbody>{% for access in membership.effective_access %}<tr><th scope="row"><code>{{ access.capability }}</code><br><small>{{ t('core.administrator.business_security.owner', {owner: access.owner}) }}</small></th><td>{{ access.role }}</td><td>{{ access.scope_type }}{% if access.scope_identifier %}:{{ access.scope_identifier }}{% endif %}</td><td>{{ access.high_impact ? t('core.administrator.business_definitions.high_impact') : 'Standard' }} · {{ access.delegable ? 'delegable' : t('core.administrator.business_security.not_delegable') }}</td><td><span class="status status-{{ access.effective ? 'published' : 'draft' }}">{{ access.effective ? 'Effective' : 'Dormant' }}</span><br><small>{{ access.reason|replace({'_':' '}) }}</small></td></tr>{% else %}<tr><td colspan="5">{{ t('core.administrator.business_security.no_effective_grants_assign_the_minimum') }}</td></tr>{% endfor %}</tbody>
          </table></div>
          <div class="notice" role="status"><span><strong>{{ t('core.administrator.access_control.portal_readiness') }}</strong> {{ t('core.administrator.business_security.an_active_membership_plus_an_assigned') }}</span></div>
        </section>
      {% endif %}
    {% else %}
      <section class="panel stack" aria-labelledby="membership-heading">
        <header class="panel-header section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.people_and_roles') }}</p><h2 id="membership-heading">{{ t('core.administrator.business_security.organization_memberships') }}</h2><p>{{ t('core.administrator.business_security.assignments_update_live_membership_versions_and') }}</p></div><a class="button primary" href="/administrator/business-security?section=memberships&amp;mode=create">{{ t('core.administrator.business_security.create_membership') }}</a></header>
        {% if security.memberships is empty %}
          {% embed '@kis/empty-state.twig' with {title: t('core.administrator.business_security.no_memberships_configured'), message: t('core.administrator.business_security.provision_an_active_identity_and_organization')} %}{% block action %}<a class="button primary" href="/administrator/business-security?section=memberships&amp;mode=create">{{ t('core.administrator.business_security.create_membership') }}</a>{% endblock %}{% endembed %}
        {% else %}
          <div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_security.organization_memberships') }}"><table><thead><tr><th scope="col">{{ t('core.administrator.business_security.member') }}</th><th scope="col">{{ t('core.administrator.business_security.organization') }}</th><th scope="col">{{ t('core.administrator.access_control.status') }}</th><th scope="col">{{ t('core.administrator.business_security.workspaces') }}</th><th scope="col">{{ t('core.administrator.business_security.roles') }}</th><th scope="col">{{ t('core.administrator.automation.actions') }}</th></tr></thead><tbody>
