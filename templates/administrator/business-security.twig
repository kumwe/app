      {% if workspace.kind == 'separation' %}
        <section class="panel stack" aria-labelledby="separation-create-heading">
          <div><p class="eyebrow">{{ t('core.administrator.business_security.guided_authoring') }}</p><h2 id="separation-create-heading">{{ t('core.administrator.business_security.create_separation_of_duty_rule') }}</h2><p>{{ t('core.administrator.business_security.bind_a_request_and_approval_to') }}</p></div>
          <form method="post" action="/administrator/business-security?section=policies" class="stack">
