      <section class="panel stack" aria-labelledby="policy-heading"><header class="panel-header section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.row_field_and_maker_checker_policy') }}</p><h2 id="policy-heading">{{ t('core.administrator.business_security.policy_catalog_2') }}</h2><p>{{ t('core.administrator.business_security.browse_live_bounded_policy_documents_before') }}</p></div><div class="page-actions"><a class="button primary" href="/administrator/business-security?section=policies&amp;mode=create&amp;kind=resource&amp;step=scope#policy-step-scope">{{ t('core.administrator.business_security.create_policy') }}</a><a class="button" href="/administrator/business-security?section=policies&amp;mode=create&amp;kind=separation">{{ t('core.administrator.business_security.create_separation_rule') }}</a></div></header>
        <h3>{{ t('core.administrator.business_security.row_and_field_policies') }}</h3>{% for item in security.resource_policies %}<article class="role-card"><div class="section-heading"><div><h4>{{ item.policy_code }}</h4><p><code>{{ item.capability_code }}</code> · {{ item.effect|upper }} · {{ item.organization_identifier|default('Site-wide') }} · {{ item.definition_handle|default(t('core.administrator.business_security.all_definitions')) }}</p></div><a class="button" href="/administrator/business-security?section=policies&amp;mode=review&amp;kind=resource&amp;id={{ item.id|url_encode }}">{{ t('core.administrator.business_security.review', {value: (item.status == 'active' ? 'deactivation' : 'activation')}) }}</a></div></article>{% else %}<p class="text-muted">{{ t('core.administrator.business_security.no_row_or_field_policies_configured') }}</p>{% endfor %}
        <h3>{{ t('core.administrator.business_security.separation_of_duty_rules') }}</h3><div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_security.separation_of_duty_rules') }}"><table><thead><tr><th scope="col">{{ t('core.administrator.business_security.rule') }}</th><th scope="col">{{ t('core.administrator.business_security.binding') }}</th><th scope="col">{{ t('core.administrator.business_security.roles') }}</th><th scope="col">{{ t('core.administrator.business_security.quorum') }}</th><th scope="col">{{ t('core.administrator.business_list.state') }}</th><th scope="col">{{ t('core.administrator.access_control.review') }}</th></tr></thead><tbody>{% for item in security.separation_rules %}<tr><th scope="row">{{ item.rule_code }}<br><small>{{ item.organization_identifier|default('Site-wide') }}</small></th><td>{{ item.resource_type }}<br><code>{{ item.request_action }}</code> → <code>{{ item.approval_action }}</code></td><td>{{ t('core.administrator.business_security.maker', {requester_role_code: (item.requester_role_code|default('Any'))}) }}<br>{{ t('core.administrator.business_security.checker', {approver_role_code: (item.approver_role_code|default('Any'))}) }}</td><td>{{ item.quorum }} · {{ item.distinct_actors ? t('core.administrator.business_security.distinct_actors') : t('core.administrator.business_security.same_actor_allowed') }}</td><td>{{ item.status|title }} · v{{ item.version }}</td><td><a href="/administrator/business-security?section=policies&amp;mode=review&amp;kind=separation&amp;id={{ item.id|url_encode }}">{{ t('core.administrator.business_security.review', {value: (item.status == 'active' ? 'deactivation' : 'activation')}) }}</a></td></tr>{% else %}<tr><td colspan="6">{{ t('core.administrator.business_security.no_separation_of_duty_rules_configured') }}</td></tr>{% endfor %}</tbody></table></div>
        <div class="page-actions"><a class="button" href="/administrator/business-security?section=policies&amp;mode=history">{{ t('core.administrator.business_security.policy_audit_path') }}</a></div>
      </section>
    {% endif %}

  {% elseif section == 'approvals' %}
    {% set approval = selected_id ? security.approvals|filter(item => item.id == selected_id)|first : null %}
    {% if mode == 'review' %}
      <p><a href="/administrator/business-security?section=approvals">{{ t('core.administrator.business_security.approval_inbox') }}</a></p>
      {% if not approval %}
        {% embed '@kis/empty-state.twig' with {title: t('core.administrator.business_security.approval_unavailable'), message: t('core.administrator.business_security.the_request_does_not_exist_in')} %}{% endembed %}
      {% else %}
        <section class="panel stack" aria-labelledby="approval-review-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.version_bound_review') }}</p><h2 id="approval-review-heading">{{ approval.rule_code }}</h2><p>{{ approval.organization_identifier|default('Site') }}{% if approval.workspace_identifier %} / {{ approval.workspace_identifier }}{% endif %}</p></div><dl class="definition-metadata"><div><dt>{{ t('core.administrator.business_confirm.request') }}</dt><dd>{% include '@kis/technical-value.twig' with {label: t('core.administrator.business_security.approval_request'), value: approval.id} only %}</dd></div><div><dt>{{ t('core.administrator.business_schema_plans.operation') }}</dt><dd><code>{{ approval.action }}</code></dd></div><div><dt>{{ t('core.administrator.access_control.target') }}</dt><dd>{{ t('core.administrator.business_security.version_4', {resource_type: approval.resource_type, resource_id: approval.resource_id, resource_version: approval.resource_version}) }}</dd></div><div><dt>{{ t('core.administrator.business_security.decision_state') }}</dt><dd>{{ t('core.administrator.business_security.approval_s_expires', {status: (approval.status|title), required_quorum: approval.required_quorum, expires_at: approval.expires_at}) }}</dd></div><div><dt>{{ t('core.administrator.business_security.maker_2') }}</dt><dd>{{ approval.requester_id }}</dd></div></dl>
        {% if approval.status == 'pending' %}{% if capabilities['business.approval.approve'] is defined %}<form method="post" action="/administrator/business-security?section=approvals" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="request_id" value="{{ approval.id }}"><label>{{ t('core.administrator.business_security.decision_reason') }} <span class="text-muted">{{ t('core.administrator.access_control.optional') }}</span><input name="reason" maxlength="500"></label>{{ security_forms.step_up() }}<div class="actions"><button class="primary" name="action" value="approval.approve">{{ t('core.administrator.business_security.approve_exact_request') }}</button><button class="danger" name="action" value="approval.reject">{{ t('core.administrator.business_security.reject_exact_request') }}</button></div></form>{% endif %}{% if approval.requester_id == actor_id %}<form method="post" action="/administrator/business-security?section=approvals"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="approval.cancel"><input type="hidden" name="request_id" value="{{ approval.id }}"><button class="link-button" type="submit">{{ t('core.administrator.business_security.cancel_my_request') }}</button></form>{% endif %}{% elseif approval.status == 'approved' and capabilities['business.approval.manage'] is defined %}<form method="post" action="/administrator/business-security?section=approvals" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="approval.revoke"><input type="hidden" name="request_id" value="{{ approval.id }}">{{ security_forms.step_up() }}<button class="danger" type="submit">{{ t('core.administrator.business_security.revoke_exact_approval') }}</button></form>{% else %}<p class="text-muted">{{ t('core.administrator.business_security.this_request_is_closed_or_no') }}</p>{% endif %}</section>
      {% endif %}
    {% elseif mode == 'history' %}
      {% set visible_votes = selected_id ? security.approval_votes|filter(vote => vote.request_id == selected_id) : security.approval_votes %}
      <section class="panel stack" aria-labelledby="approval-history-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.immutable_decisions') }}</p><h2 id="approval-history-heading">{{ t('core.administrator.business_security.approval_decision_history') }}</h2><p>{{ t('core.administrator.business_security.decision_attribution_is_retained_separately_from') }}</p></div><div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_security.approval_decision_history') }}"><table><thead><tr><th scope="col">{{ t('core.administrator.business_confirm.request') }}</th><th scope="col">{{ t('core.administrator.business_security.approver') }}</th><th scope="col">{{ t('core.administrator.business_security.decision') }}</th><th scope="col">{{ t('core.administrator.business_security.reason') }}</th><th scope="col">{{ t('core.administrator.access_control.time') }}</th></tr></thead><tbody>{% for vote in visible_votes %}<tr><th scope="row">{{ vote.request_id }}</th><td>{{ vote.approver_id }}</td><td>{{ vote.decision|title }}</td><td>{{ vote.reason|default('—') }}</td><td>{{ vote.decided_at }}</td></tr>{% else %}<tr><td colspan="5">{{ t('core.administrator.business_security.no_visible_approval_decisions') }}</td></tr>{% endfor %}</tbody></table></div><div class="page-actions"><a class="button" href="/administrator/business-security?section=approvals">{{ t('core.administrator.business_security.return_to_inbox') }}</a></div></section>
    {% else %}
      <section class="panel stack" aria-labelledby="approval-heading"><header class="panel-header section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.inbox') }}</p><h2 id="approval-heading">{{ t('core.administrator.business_security.approval_requests') }}</h2><p>{{ t('core.administrator.business_security.makers_see_their_requests_approvers_and') }}</p></div><a class="button" href="/administrator/business-security?section=approvals&amp;mode=history">{{ t('core.administrator.business_security.decision_history') }}</a></header><div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_security.approval_requests') }}"><table><thead><tr><th scope="col">{{ t('core.administrator.business_confirm.request') }}</th><th scope="col">{{ t('core.administrator.business_security.resource') }}</th><th scope="col">{{ t('core.administrator.business_security.maker_2') }}</th><th scope="col">{{ t('core.administrator.business_list.state') }}</th><th scope="col">{{ t('core.administrator.access_control.review') }}</th></tr></thead><tbody>{% for item in security.approvals %}<tr><th scope="row">{{ item.rule_code }}<br><small>{{ item.id }}</small><br>{{ item.created_at }}</th><td><code>{{ item.action }}</code><br>{{ item.resource_type }} · {{ item.resource_id }} · v{{ item.resource_version }}<br><small>{{ item.organization_identifier|default('Site') }}{% if item.workspace_identifier %} / {{ item.workspace_identifier }}{% endif %}</small></td><td>{{ item.requester_id }}</td><td><span class="status status-{{ item.status }}">{{ item.status|title }}</span><br>{{ t('core.administrator.business_security.approval_s', {required_quorum: item.required_quorum}) }}<br><small>{{ t('core.administrator.business_security.expires', {expires_at: item.expires_at}) }}</small></td><td><a href="/administrator/business-security?section=approvals&amp;mode=review&amp;id={{ item.id|url_encode }}">{{ t('core.administrator.business_security.review_request') }}</a><br><a href="/administrator/business-security?section=approvals&amp;mode=history&amp;id={{ item.id|url_encode }}">{{ t('core.administrator.business_security.decision_history') }}</a></td></tr>{% else %}<tr><td colspan="5">{{ t('core.administrator.business_security.no_approval_requests_are_visible_in') }}</td></tr>{% endfor %}</tbody></table></div></section>
    {% endif %}

  {% elseif section == 'credentials' %}
    {% if mode == 'history' %}
      <section class="panel stack" aria-labelledby="credential-history-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.credential_audit') }}</p><h2 id="credential-history-heading">{{ t('core.administrator.business_security.credential_history') }}</h2><p>{{ t('core.administrator.business_security.enrollment_verification_token_issue_rotation_and') }}</p></div><div class="page-actions"><a class="button primary" href="/administrator/access?section=events">{{ t('core.administrator.access_control.open_security_events') }}</a><a class="button" href="/administrator/business-security?section=credentials">{{ t('core.administrator.business_security.return_to_credential_status') }}</a></div></section>
    {% else %}
    <section class="panel stack" aria-labelledby="credential-heading"><header class="panel-header section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.credential_assurance') }}</p><h2 id="credential-heading">{{ t('core.administrator.business_security.step_up_status') }}</h2><p>{{ t('core.administrator.business_security.status_only_encrypted_secrets_proof_nonces') }}</p></div><a class="button" href="/administrator/access?section=events">{{ t('core.administrator.business_security.set_up_or_review_verification') }}</a></header><div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_security.step_up_credential_status') }}"><table><thead><tr><th scope="col">{{ t('core.administrator.access_control.user') }}</th><th scope="col">{{ t('core.administrator.access_control.status') }}</th><th scope="col">{{ t('core.administrator.business_security.confirmed') }}</th><th scope="col">{{ t('core.administrator.business_security.last_verified') }}</th><th scope="col">{{ t('core.administrator.business_schema_plans.recovery') }}</th></tr></thead><tbody>{% for item in security.step_up_credentials %}<tr><th scope="row">{{ item.display_name }}<br><small>{{ item.email }}</small></th><td>{{ item.status|title }} · v{{ item.version }}</td><td>{{ item.confirmed_at|default(t('core.administrator.business_security.not_confirmed')) }}</td><td>{{ item.last_verified_at|default('Never') }}</td><td>{{ t('core.administrator.business_security.unused_codes', {recovery_codes_remaining: item.recovery_codes_remaining}) }}</td></tr>{% else %}<tr><td colspan="5">{{ t('core.administrator.business_security.no_step_up_status_is_available') }}</td></tr>{% endfor %}</tbody></table></div></section>
    <section class="panel stack" aria-labelledby="token-heading"><header class="panel-header"><div><p class="eyebrow">{{ t('core.administrator.business_security.delegated_credentials') }}</p><h2 id="token-heading">{{ t('core.administrator.business_security.token_scope_and_delegation_diagnostics') }}</h2><p>{{ t('core.administrator.business_security.metadata_only_families_parentage_depth_and') }}</p></div><a class="button" href="/administrator/business-security?section=credentials&amp;mode=history">{{ t('core.administrator.business_security.credential_history') }}</a></header><div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_security.token_scope_diagnostics') }}"><table><thead><tr><th scope="col">{{ t('core.administrator.access_control.token') }}</th><th scope="col">{{ t('core.administrator.business_security.subject') }}</th><th scope="col">{{ t('core.administrator.access_control.scope') }}</th><th scope="col">{{ t('core.administrator.business_security.family') }}</th><th scope="col">{{ t('core.administrator.access_control.capabilities') }}</th><th scope="col">{{ t('core.administrator.business_security.diagnostics') }}</th></tr></thead><tbody>{% for item in security.tokens %}<tr><th scope="row">{{ item.name }}<br><small>{{ item.id }}</small><br>{{ item.revoked_at ? 'Revoked' : 'Active' }}</th><td>{{ item.display_name }}<br><small>{{ item.email }}</small></td><td>{% for scope in item.scope_summary %}<code>{{ scope }}</code><br>{% endfor %}</td><td><small>{{ t('core.administrator.business_security.family_2', {family_id: item.family_id}) }}<br>{{ t('core.administrator.business_security.parent', {parent_token_id: (item.parent_token_id|default('root'))}) }}<br>{{ t('core.administrator.business_security.depth', {delegation_depth: item.delegation_depth}) }}</small></td><td>{{ item.capabilities|join(', ') }}</td><td><span class="status status-{{ item.delegation_valid ? 'published' : 'draft' }}">{{ item.delegation_valid ? 'Bounded' : 'Review' }}</span><br>{% for reason in item.delegation_diagnostics %}<small>{{ reason|replace({'_':' '}) }}</small><br>{% endfor %}</td></tr>{% else %}<tr><td colspan="6">{{ t('core.administrator.business_security.no_token_diagnostics_are_available_with') }}</td></tr>{% endfor %}</tbody></table></div></section>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
