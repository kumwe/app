            <div class="form-grid"><label>{{ t('core.administrator.business_security.rule_code') }}<input name="rule_code" pattern="[a-z][a-z0-9._-]*" maxlength="191" required></label><label>{{ t('core.administrator.business_security.organization') }}<select name="organization_id"><option value="">{{ t('core.administrator.business_security.site_wide') }}</option>{% for organization in security.organizations %}<option value="{{ organization.id }}">{{ organization.name }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_security.resource_type') }}<input name="resource_type" pattern="[a-z][a-z0-9._-]*" maxlength="63" required></label><label>{{ t('core.administrator.business_security.request_operation') }}<input name="request_action" list="business-security-request-actions" pattern="[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*" maxlength="127" placeholder="business.record.action:approve" required></label><datalist id="business-security-request-actions">{% for capability in security.capabilities %}<option value="{{ capability.code }}">{% endfor %}{% for definition in security.definitions %}{% for action in definition.actions %}<option value="business.record.action:{{ action.handle }}">{% endfor %}{% endfor %}</datalist><label>{{ t('core.administrator.business_security.approval_action') }}<select name="approval_action" required>{% for capability in security.approval_capabilities %}<option value="{{ capability.code }}">{{ capability.code }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_security.requester_role') }}<select name="requester_role_id"><option value="">{{ t('core.administrator.business_security.any_eligible_requester') }}</option>{% for role in security.roles %}<option value="{{ role.id }}">{{ role.name }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_security.approver_role') }}<select name="approver_role_id"><option value="">{{ t('core.administrator.business_security.any_eligible_approver') }}</option>{% for role in security.roles %}<option value="{{ role.id }}">{{ role.name }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_security.quorum') }}<input type="number" name="quorum" min="1" max="32" value="1" required></label></div>
            <label><input type="checkbox" name="distinct_actors" value="1" checked> {{ t('core.administrator.business_security.requester_and_approvers_must_be_distinct') }}</label>
            <section class="notice warning"><div><h3>{{ t('core.administrator.business_security.review_consequence') }}</h3><p>{{ t('core.administrator.business_security.the_rule_changes_who_may_complete') }}</p></div></section>
            {{ security_forms.step_up() }}<div class="page-actions"><button class="primary" type="submit">{{ t('core.administrator.business_security.create_separation_rule') }}</button><a class="button" href="/administrator/business-security?section=policies">{{ t('core.administrator.access_control.cancel') }}</a></div>
          </form>
        </section>
      {% else %}
        <section class="panel stack" aria-labelledby="resource-policy-create-heading">
          <div><p class="eyebrow">{{ t('core.administrator.business_security.guided_policy_authoring') }}</p><h2 id="resource-policy-create-heading">{{ t('core.administrator.business_security.create_row_and_field_policy') }}</h2><p>{{ t('core.administrator.business_security.complete_scope_predicate_explicit_disclosure_and') }}</p></div>
