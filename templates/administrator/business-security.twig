{% extends "layout.twig" %}
{% macro step_up() %}
  <fieldset class="field-group stack">
    <legend>Confirm with step-up verification</legend>
    <p class="text-muted text-small">The code is bound to this action, site, organization, workspace and rotated session, and is used once.</p>
    <label>Method<select name="step_up_method"><option value="totp">Authenticator code</option><option value="recovery">Recovery code</option></select></label>
    <div class="two-column">
      <label>Authenticator code<input name="step_up_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}"></label>
      <label>Recovery code<input name="recovery_code" autocomplete="one-time-code" maxlength="128"></label>
    </div>
    <small>Fill the field matching the selected method. Codes and recovery material are never retained by this form.</small>
  </fieldset>
{% endmacro %}
{% import _self as security_forms %}
{% block title %}Business Security · Kumwe{% endblock %}
{% block context_title %}Business Security{% endblock %}
{% block content %}
  <header class="page-heading"><div><p class="eyebrow">Business authority</p><h1>Business Security</h1><p>Manage organization boundaries, row and field policy, separation of duties, approvals and credential scope from one accountable workspace.</p></div></header>
  {% if saved %}<div class="notice success" role="status"><span>Business Security updated.</span><button class="notice-dismiss" type="button" aria-label="Dismiss" data-dismiss-notice>×</button></div>{% endif %}

  <section class="panel stack" aria-labelledby="organization-heading">
    <header class="panel-header"><div><p class="eyebrow">Authority boundaries</p><h2 id="organization-heading">Organizations and workspaces</h2><p>Organizations are site-owned policy boundaries. Workspaces are always nested inside one organization.</p></div></header>
    <div class="admin-grid">
      <form method="post" action="/administrator/business-security" class="panel-body stack">
        <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="organization.create">
        <h3>Create organization</h3>
        <label>Identifier<input name="identifier" pattern="[a-z0-9][a-z0-9._:-]{0,190}" maxlength="191" required></label>
        <label>Name<input name="name" maxlength="191" required></label>
        {{ security_forms.step_up() }}
        <button class="primary" type="submit">Create organization</button>
      </form>
      <form method="post" action="/administrator/business-security" class="panel-body stack">
        <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="workspace.create">
        <h3>Create workspace</h3>
        <label>Organization<select name="organization_id" required>{% for organization in security.organizations %}<option value="{{ organization.id }}">{{ organization.name }} · {{ organization.identifier }}</option>{% endfor %}</select></label>
        <label>Identifier<input name="identifier" pattern="[a-z0-9][a-z0-9._:-]{0,190}" maxlength="191" required></label>
        <label>Name<input name="name" maxlength="191" required></label>
        {{ security_forms.step_up() }}
        <button class="primary" type="submit">Create workspace</button>
      </form>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Organizations and workspaces"><table>
      <thead><tr><th>Organization</th><th>Status</th><th>Policy generation</th><th>Workspaces</th></tr></thead>
      <tbody>{% for organization in security.organizations %}<tr>
        <td><strong>{{ organization.name }}</strong><br><code>{{ organization.identifier }}</code></td>
        <td><span class="status status-{{ organization.status }}">{{ organization.status|title }}</span></td>
        <td>{{ organization.policy_generation }} <small>version {{ organization.version }}</small></td>
        <td>{% for workspace in security.workspaces|filter(item => item.organization_id == organization.id) %}<span class="status status-{{ workspace.status }}">{{ workspace.name }} · {{ workspace.identifier }}</span> {% else %}<span class="text-muted">None</span>{% endfor %}</td>
      </tr>{% else %}<tr><td colspan="4">No organizations configured.</td></tr>{% endfor %}</tbody>
    </table></div>
  </section>

  <section class="panel stack" aria-labelledby="membership-heading">
    <header class="panel-header"><div><p class="eyebrow">People and roles</p><h2 id="membership-heading">Organization memberships</h2><p>Assignments update live membership versions and user security epochs. You cannot change your own membership from this screen.</p></div></header>
    <form method="post" action="/administrator/business-security" class="panel-body stack">
      <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="membership.create">
      <div class="form-grid">
        <label>Organization<select name="organization_id" required>{% for organization in security.organizations %}<option value="{{ organization.id }}">{{ organization.name }}</option>{% endfor %}</select></label>
        <label>User<select name="user_id" required>{% for user in security.users %}<option value="{{ user.id }}">{{ user.display_name }} · {{ user.email }}</option>{% endfor %}</select></label>
        <label>Valid from<input type="datetime-local" name="valid_from" required></label>
        <label>Valid until<input type="datetime-local" name="valid_until"></label>
      </div>
      {{ security_forms.step_up() }}
      <button class="primary" type="submit">Create membership</button>
    </form>
    {% for membership in security.memberships %}
      <article class="role-card stack">
        <header><h3>{{ membership.display_name }} <small>{{ membership.email }}</small></h3><p><strong>{{ membership.organization_identifier }}</strong> · {{ membership.status|title }} · version {{ membership.version }}{% if membership.expired %} · expired{% endif %}</p></header>
        <div class="two-column">
          <div><h4>Workspaces</h4>{% for workspace in membership.workspaces %}<span class="status">{{ workspace.name }}</span> {% else %}<span class="text-muted">Organization-wide</span>{% endfor %}</div>
          <div><h4>Roles</h4>{% for role in membership.roles %}<span class="status">{{ role.name }}</span> {% else %}<span class="text-muted">No roles</span>{% endfor %}</div>
        </div>
        <details><summary>Change membership, workspace or role</summary><div class="panel-body stack">
          <form method="post" action="/administrator/business-security" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="membership_id" value="{{ membership.id }}"><input type="hidden" name="version" value="{{ membership.version }}">
            <label>Status<select name="status">{% for status in ['active','suspended','revoked'] %}<option value="{{ status }}"{% if membership.status == status %} selected{% endif %}>{{ status|title }}</option>{% endfor %}</select></label>
            {{ security_forms.step_up() }}<button name="action" value="membership.status">Save status</button>
          </form>
          <form method="post" action="/administrator/business-security" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="membership_id" value="{{ membership.id }}">
            <label>Workspace<select name="workspace_id">{% for workspace in security.workspaces|filter(item => item.organization_id == membership.organization_id) %}<option value="{{ workspace.id }}">{{ workspace.name }}</option>{% endfor %}</select></label>
            {{ security_forms.step_up() }}<div class="actions"><button name="action" value="membership.workspace.assign">Assign workspace</button><button class="danger" name="action" value="membership.workspace.revoke">Revoke workspace</button></div>
          </form>
          <form method="post" action="/administrator/business-security" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="membership_id" value="{{ membership.id }}">
            <label>Role<select name="role_id">{% for role in security.roles %}<option value="{{ role.id }}">{{ role.name }} · {{ role.code }}</option>{% endfor %}</select></label>
            {{ security_forms.step_up() }}<div class="actions"><button name="action" value="membership.role.assign">Assign role</button><button class="danger" name="action" value="membership.role.revoke">Revoke role</button></div>
          </form>
        </div></details>
        <details><summary>Explain effective access ({{ membership.effective_access|length }})</summary><div class="table-wrap" tabindex="0" role="region" aria-label="Effective access for {{ membership.display_name }}"><table>
          <thead><tr><th>Capability</th><th>Source</th><th>Scope</th><th>Impact</th><th>Decision</th></tr></thead>
          <tbody>{% for access in membership.effective_access %}<tr><td><code>{{ access.capability }}</code><br><small>owner {{ access.owner }}</small></td><td>{{ access.role }}</td><td>{{ access.scope_type }}{% if access.scope_identifier %}:{{ access.scope_identifier }}{% endif %}</td><td>{{ access.high_impact ? 'High impact' : 'Standard' }} · {{ access.delegable ? 'delegable' : 'not delegable' }}</td><td><span class="status status-{{ access.effective ? 'published' : 'draft' }}">{{ access.effective ? 'Effective' : 'Dormant' }}</span><br><small>{{ access.reason|replace({'_':' '}) }}</small></td></tr>{% else %}<tr><td colspan="5">No effective grants.</td></tr>{% endfor %}</tbody>
        </table></div></details>
      </article>
    {% else %}<p class="panel-body text-muted">No organization memberships configured.</p>{% endfor %}
  </section>

  <section class="panel stack" aria-labelledby="policy-heading">
    <header class="panel-header"><div><p class="eyebrow">ABAC</p><h2 id="policy-heading">Row and field policies</h2><p>Build a bounded typed predicate and explicit field/action disclosure. No JSON or executable policy text is accepted.</p></div></header>
    <form method="post" action="/administrator/business-security" class="panel-body stack">
      <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="resource_policy.create">
      <div class="form-grid">
        <label>Policy code<input name="policy_code" pattern="[a-z][a-z0-9._-]*" maxlength="191" required></label>
        <label>Organization<select name="organization_id"><option value="">Site-wide</option>{% for organization in security.organizations %}<option value="{{ organization.id }}">{{ organization.name }}</option>{% endfor %}</select></label>
        <label>Definition<select name="definition_id" required>{% for definition in security.definitions %}<option value="{{ definition.id }}">{{ definition.handle }} · v{{ definition.version }}</option>{% endfor %}</select></label>
        <label>Operation<select name="operation" required>{% for capability in security.business_record_capabilities %}<option value="{{ capability.code }}">{{ capability.code }}</option>{% endfor %}</select><small>Only live capabilities explicitly bound to business records are offered, including extension-owned operations.</small></label>
        <label>Effect<select name="effect"><option value="deny">Deny</option><option value="allow">Allow</option></select></label>
        <label>Priority<input type="number" name="priority" min="-100000" max="100000" value="0"></label>
      </div>
      <fieldset class="field-group stack"><legend>Record predicate</legend><div class="form-grid">
        <label>Type<select name="predicate_type"><option value="constant">Constant</option><option value="comparison">Field comparison</option><option value="null">Null check</option></select></label>
        <label>Field<select name="predicate_field"><option value="">None</option>{% for definition in security.definitions %}<optgroup label="{{ definition.handle }}">{% for field in definition.fields|filter(item => item.policy_type) %}<option value="{{ field.handle }}">{{ field.handle }} · {{ field.policy_type }}</option>{% endfor %}</optgroup>{% endfor %}</select></label>
        <label>Operator<select name="predicate_operator"><option value="equal">Equal</option><option value="not_equal">Not equal</option><option value="less_than">Less than</option><option value="less_than_or_equal">Less than or equal</option><option value="greater_than">Greater than</option><option value="greater_than_or_equal">Greater than or equal</option></select></label>
        <label>Value type<select name="predicate_value_type">{% for type in ['string','integer','decimal','boolean','temporal'] %}<option value="{{ type }}">{{ type|title }}</option>{% endfor %}</select></label>
        <label>Value<input name="predicate_value" maxlength="4096" value="false"><small>Constants and null checks use true or false.</small></label>
      </div></fieldset>
      <fieldset class="field-group stack"><legend>Explicit field and action disclosure</legend><p class="text-muted text-small">Select fields from the same definition chosen above. The server rejects mismatches.</p>
        <div class="form-grid">{% for usage in ['create','update','detail','list','filter','search','sort','aggregate','report','export','audit','mcp','relation','include','public_reference'] %}<label>{{ usage|replace({'_':' '})|title }} fields<select name="fields_{{ usage }}[]" multiple size="5">{% for definition in security.definitions %}<optgroup label="{{ definition.handle }}">{% for field in definition.fields %}<option value="{{ field.handle }}">{{ field.handle }}</option>{% endfor %}</optgroup>{% endfor %}</select></label>{% endfor %}
          <label>Declared actions<select name="fields_actions[]" multiple size="5">{% for definition in security.definitions %}<optgroup label="{{ definition.handle }}">{% for action in definition.actions %}<option value="{{ action.handle }}">{{ action.label }}</option>{% endfor %}</optgroup>{% endfor %}</select></label>
        </div>
      </fieldset>
      {{ security_forms.step_up() }}
      <button class="primary" type="submit">Create policy</button>
    </form>
    {% for policy in security.resource_policies %}<article class="role-card stack"><header><h3>{{ policy.policy_code }}</h3><p><code>{{ policy.capability_code }}</code> · {{ policy.effect|upper }} · {{ policy.organization_identifier|default('Site-wide') }} · {{ policy.definition_handle|default('All definitions') }}</p></header>
      <div><strong>Predicate:</strong>{% if policy.predicate.type == 'comparison' %} {{ policy.predicate.field }} {{ policy.predicate.operator|replace({'_':' '}) }} {{ policy.predicate.value }} ({{ policy.predicate.value_type }}){% elseif policy.predicate.type == 'null' %} {{ policy.predicate.field }} is {{ policy.predicate.is_null ? 'null' : 'not null' }}{% elseif policy.predicate.type == 'constant' %} always {{ policy.predicate.value ? 'true' : 'false' }}{% else %} bounded compound expression{% endif %}</div>
      <details><summary>Field and action rules</summary><dl>{% for usage, fields in policy.field_rules %}<dt>{{ usage|replace({'_':' '})|title }}</dt><dd>{{ fields is empty ? 'None' : fields|join(', ') }}</dd>{% endfor %}</dl></details>
      <form method="post" action="/administrator/business-security" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="resource_policy.status"><input type="hidden" name="id" value="{{ policy.id }}"><input type="hidden" name="version" value="{{ policy.policy_version }}"><input type="hidden" name="status" value="{{ policy.status == 'active' ? 'inactive' : 'active' }}">{{ security_forms.step_up() }}<button class="{{ policy.status == 'active' ? 'danger' : '' }}" type="submit">{{ policy.status == 'active' ? 'Deactivate' : 'Activate' }}</button></form>
    </article>{% else %}<p class="panel-body text-muted">No row or field policies configured.</p>{% endfor %}
  </section>

  <section class="panel stack" aria-labelledby="sod-heading">
    <header class="panel-header"><div><p class="eyebrow">Maker-checker</p><h2 id="sod-heading">Separation-of-duty rules</h2><p>Bind request and approval actions to distinct optional roles, a quorum and distinct human actors.</p></div></header>
    <form method="post" action="/administrator/business-security" class="panel-body stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="separation_duty.create">
      <div class="form-grid">
        <label>Rule code<input name="rule_code" pattern="[a-z][a-z0-9._-]*" maxlength="191" required></label>
        <label>Organization<select name="organization_id"><option value="">Site-wide</option>{% for organization in security.organizations %}<option value="{{ organization.id }}">{{ organization.name }}</option>{% endfor %}</select></label>
        <label>Resource type<input name="resource_type" pattern="[a-z][a-z0-9._-]*" maxlength="63" required></label>
        <label>Request operation<input name="request_action" list="business-security-request-actions" pattern="[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)*" maxlength="127" placeholder="business.record.action:approve" required><small>Use the exact bound operation token. Definition actions use <code>business.record.action:&lt;action_handle&gt;</code>.</small></label>
        <datalist id="business-security-request-actions">{% for capability in security.capabilities %}<option value="{{ capability.code }}">{% endfor %}{% for definition in security.definitions %}{% for action in definition.actions %}<option value="business.record.action:{{ action.handle }}">{% endfor %}{% endfor %}</datalist>
        <label>Approval action<select name="approval_action">{% for capability in security.approval_capabilities %}<option value="{{ capability.code }}">{{ capability.code }}</option>{% endfor %}</select><small>Only live capabilities explicitly bound to approval requests are offered.</small></label>
        <label>Requester role<select name="requester_role_id"><option value="">Any eligible requester</option>{% for role in security.roles %}<option value="{{ role.id }}">{{ role.name }}</option>{% endfor %}</select></label>
        <label>Approver role<select name="approver_role_id"><option value="">Any eligible approver</option>{% for role in security.roles %}<option value="{{ role.id }}">{{ role.name }}</option>{% endfor %}</select></label>
        <label>Quorum<input type="number" name="quorum" min="1" max="32" value="1" required></label>
        <label><input type="checkbox" name="distinct_actors" value="1" checked> Requester and approvers must be distinct</label>
      </div>
      {{ security_forms.step_up() }}<button class="primary" type="submit">Create separation rule</button>
    </form>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Separation-of-duty rules"><table><thead><tr><th>Rule</th><th>Binding</th><th>Roles</th><th>Quorum</th><th>Status</th><th>Manage</th></tr></thead><tbody>{% for rule in security.separation_rules %}<tr><td><strong>{{ rule.rule_code }}</strong><br><small>{{ rule.organization_identifier|default('Site-wide') }}</small></td><td>{{ rule.resource_type }}<br><code>{{ rule.request_action }}</code> → <code>{{ rule.approval_action }}</code></td><td>Maker: {{ rule.requester_role_code|default('Any') }}<br>Checker: {{ rule.approver_role_code|default('Any') }}</td><td>{{ rule.quorum }} · {{ rule.distinct_actors ? 'distinct actors' : 'same actor allowed' }}</td><td>{{ rule.status|title }} · v{{ rule.version }}</td><td><details><summary>Change</summary><form method="post" action="/administrator/business-security" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="separation_duty.status"><input type="hidden" name="id" value="{{ rule.id }}"><input type="hidden" name="version" value="{{ rule.version }}"><input type="hidden" name="status" value="{{ rule.status == 'active' ? 'inactive' : 'active' }}">{{ security_forms.step_up() }}<button class="{{ rule.status == 'active' ? 'danger' : '' }}" type="submit">{{ rule.status == 'active' ? 'Deactivate' : 'Activate' }}</button></form></details></td></tr>{% else %}<tr><td colspan="6">No separation-of-duty rules configured.</td></tr>{% endfor %}</tbody></table></div>
  </section>

  <section class="panel stack" aria-labelledby="approval-heading">
    <header class="panel-header"><div><p class="eyebrow">Inbox and history</p><h2 id="approval-heading">Approval requests</h2><p>Makers see only their own requests; approvers and approval managers see the scoped inbox. Decisions require an action-bound, single-use step-up proof.</p></div></header>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Approval requests"><table><thead><tr><th>Request</th><th>Resource</th><th>Maker</th><th>State</th><th>Decision</th></tr></thead><tbody>{% for approval in security.approvals %}<tr><td><strong>{{ approval.rule_code }}</strong><br><small>{{ approval.id }}</small><br>{{ approval.created_at }}</td><td><code>{{ approval.action }}</code><br>{{ approval.resource_type }} · {{ approval.resource_id }} · v{{ approval.resource_version }}<br><small>{{ approval.organization_identifier|default('Site') }}{% if approval.workspace_identifier %} / {{ approval.workspace_identifier }}{% endif %}</small></td><td>{{ approval.requester_id }}</td><td><span class="status status-{{ approval.status }}">{{ approval.status|title }}</span><br>{{ approval.required_quorum }} approval(s)<br><small>expires {{ approval.expires_at }}</small></td><td>{% if approval.status == 'pending' %}
        {% if capabilities['business.approval.approve'] is defined %}<details><summary>Approve or reject</summary><form method="post" action="/administrator/business-security" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="request_id" value="{{ approval.id }}"><label>Reason<input name="reason" maxlength="500"></label>{{ security_forms.step_up() }}<div class="actions"><button name="action" value="approval.approve">Approve</button><button class="danger" name="action" value="approval.reject">Reject</button></div></form></details>{% endif %}
        {% if approval.requester_id == actor_id %}<form method="post" action="/administrator/business-security"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="approval.cancel"><input type="hidden" name="request_id" value="{{ approval.id }}"><button class="link-button" type="submit">Cancel my request</button></form>{% endif %}
        {% elseif approval.status == 'approved' and capabilities['business.approval.manage'] is defined %}<details><summary>Revoke approval</summary><form method="post" action="/administrator/business-security" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="approval.revoke"><input type="hidden" name="request_id" value="{{ approval.id }}">{{ security_forms.step_up() }}<button class="danger" type="submit">Revoke</button></form></details>{% else %}<span class="text-muted">Closed</span>{% endif %}</td></tr>{% else %}<tr><td colspan="5">No approval requests are visible in this authority scope.</td></tr>{% endfor %}</tbody></table></div>
    {% if security.approval_votes is not empty %}<details><summary>Immutable decision history</summary><div class="table-wrap" tabindex="0" role="region" aria-label="Approval decision history"><table><thead><tr><th>Request</th><th>Approver</th><th>Decision</th><th>Reason</th><th>Time</th></tr></thead><tbody>{% for vote in security.approval_votes %}<tr><td>{{ vote.request_id }}</td><td>{{ vote.approver_id }}</td><td>{{ vote.decision|title }}</td><td>{{ vote.reason|default('—') }}</td><td>{{ vote.decided_at }}</td></tr>{% endfor %}</tbody></table></div></details>{% endif %}
  </section>

  <section class="panel stack" aria-labelledby="credential-heading">
    <header class="panel-header"><div><p class="eyebrow">Credential assurance</p><h2 id="credential-heading">Step-up status</h2><p>Status only: encrypted secrets, proof nonces and recovery-code digests are never disclosed.</p></div></header>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Step-up credential status"><table><thead><tr><th>User</th><th>Status</th><th>Confirmed</th><th>Last verified</th><th>Recovery</th></tr></thead><tbody>{% for credential in security.step_up_credentials %}<tr><td>{{ credential.display_name }}<br><small>{{ credential.email }}</small></td><td>{{ credential.status|title }} · v{{ credential.version }}</td><td>{{ credential.confirmed_at|default('Not confirmed') }}</td><td>{{ credential.last_verified_at|default('Never') }}</td><td>{{ credential.recovery_codes_remaining }} unused codes</td></tr>{% else %}<tr><td colspan="5">No step-up status is available with your capabilities.</td></tr>{% endfor %}</tbody></table></div>
  </section>

  <section class="panel stack" aria-labelledby="token-heading">
    <header class="panel-header"><div><p class="eyebrow">Delegated credentials</p><h2 id="token-heading">Token scope and delegation diagnostics</h2><p>Metadata only. Families, parentage, depth and capability attenuation are shown without token material.</p></div></header>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Token scope diagnostics"><table><thead><tr><th>Token</th><th>Subject</th><th>Scope</th><th>Family</th><th>Capabilities</th><th>Diagnostics</th></tr></thead><tbody>{% for token in security.tokens %}<tr><td><strong>{{ token.name }}</strong><br><small>{{ token.id }}</small><br>{{ token.revoked_at ? 'Revoked' : 'Active' }}</td><td>{{ token.display_name }}<br><small>{{ token.email }}</small></td><td>{% for scope in token.scope_summary %}<code>{{ scope }}</code><br>{% endfor %}</td><td><small>family {{ token.family_id }}<br>parent {{ token.parent_token_id|default('root') }}<br>depth {{ token.delegation_depth }}</small></td><td>{{ token.capabilities|join(', ') }}</td><td><span class="status status-{{ token.delegation_valid ? 'published' : 'draft' }}">{{ token.delegation_valid ? 'Bounded' : 'Review' }}</span><br>{% for reason in token.delegation_diagnostics %}<small>{{ reason|replace({'_':' '}) }}</small><br>{% endfor %}</td></tr>{% else %}<tr><td colspan="6">No token diagnostics are available with your capabilities.</td></tr>{% endfor %}</tbody></table></div>
  </section>
{% endblock %}
