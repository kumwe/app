                <div class="form-grid"><label>{{ t('core.administrator.business_definitions.type') }}<select name="predicate_type"><option value="constant">{{ t('core.administrator.business_security.constant') }}</option><option value="comparison">{{ t('core.administrator.business_security.field_comparison') }}</option><option value="null">{{ t('core.administrator.business_security.null_check') }}</option></select></label><label>{{ t('core.administrator.business_definitions.field') }}<select name="predicate_field"><option value="">{{ t('core.administrator.business_definitions.none') }}</option>{% for definition in security.definitions %}<optgroup label="{{ definition.handle }}">{% for field in definition.fields|filter(item => item.policy_type) %}<option value="{{ field.handle }}">{{ field.handle }} · {{ field.policy_type }}</option>{% endfor %}</optgroup>{% endfor %}</select></label><label>{{ t('core.administrator.business_definitions.operator') }}<select name="predicate_operator"><option value="equal">{{ t('core.administrator.business_security.equal') }}</option><option value="not_equal">{{ t('core.administrator.business_security.not_equal') }}</option><option value="less_than">{{ t('core.administrator.business_security.less_than') }}</option><option value="less_than_or_equal">{{ t('core.administrator.business_security.less_than_or_equal') }}</option><option value="greater_than">{{ t('core.administrator.business_security.greater_than') }}</option><option value="greater_than_or_equal">{{ t('core.administrator.business_security.greater_than_or_equal') }}</option></select></label><label>{{ t('core.administrator.business_fields.value_type') }}<select name="predicate_value_type">{% for type in ['string','integer','decimal','boolean','temporal'] %}<option value="{{ type }}">{{ type|title }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_fields.value') }}<input name="predicate_value" maxlength="4096" value="false"><small>{{ t('core.administrator.business_security.constants_and_null_checks_use_true') }}</small></label></div>
                <div class="page-actions"><a class="button" href="{{ policy_steps[0].url }}" data-kis-policy-step-target="scope">{{ t('core.administrator.business_security.back_to_scope') }}</a><a class="button primary" href="{{ policy_steps[2].url }}" data-kis-policy-step-target="disclosure">{{ t('core.administrator.business_security.continue_to_disclosure') }}</a></div>
              </fieldset>
              <fieldset
                id="policy-step-disclosure"
                class="field-group stack"
                tabindex="-1"
                data-kis-policy-step-panel="disclosure"
                {% if workspace.step == 'disclosure' %}data-kis-step-current{% endif %}
              >
                <legend>{{ t('core.administrator.business_security.step_3_explicit_field_and_action') }} <span class="status" data-kis-current-step-label{% if workspace.step != 'disclosure' %} hidden{% endif %}>{{ t('core.administrator.business_security.current_step') }}</span></legend>
                <p>{{ t('core.administrator.business_security.select_fields_only_from_the_chosen') }}</p>
                <div class="form-grid">{% for usage in ['create','update','detail','list','filter','search','sort','aggregate','report','export','audit','mcp','relation','include','public_reference'] %}<label>{{ t('core.administrator.business_security.fields', {usage: (usage|replace({'_':' '})|title)}) }}<select name="fields_{{ usage }}[]" multiple size="5">{% for definition in security.definitions %}<optgroup label="{{ definition.handle }}">{% for field in definition.fields %}<option value="{{ field.handle }}">{{ field.handle }}</option>{% endfor %}</optgroup>{% endfor %}</select></label>{% endfor %}<label>{{ t('core.administrator.business_security.declared_actions') }}<select name="fields_actions[]" multiple size="5">{% for definition in security.definitions %}<optgroup label="{{ definition.handle }}">{% for action in definition.actions %}<option value="{{ action.handle }}">{{ action.label }}</option>{% endfor %}</optgroup>{% endfor %}</select></label></div>
