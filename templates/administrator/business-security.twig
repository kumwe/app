ies" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="resource_policy.status"><input type="hidden" name="id" value="{{ resource_policy.id }}"><input type="hidden" name="version" value="{{ resource_policy.policy_version }}"><input type="hidden" name="status" value="{{ resource_policy.status == 'active' ? 'inactive' : 'active' }}"><div class="notice warning"><span>{{ t('core.administrator.business_security.this_changes_live_record_disclosure_and') }}</span></div>{{ security_forms.step_up() }}<button class="{{ resource_policy.status == 'active' ? 'danger' : 'primary' }}" type="submit">{{ resource_policy.status == 'active' ? t('core.administrator.business_security.deactivate_policy') : t('core.administrator.business_security.activate_policy') }}</button></form></section>
