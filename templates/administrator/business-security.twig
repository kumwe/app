                <p>{{ t('core.administrator.business_security.review_the_retained_values_in_the') }}</p>
                <div class="notice warning"><span><strong>{{ t('core.administrator.business_security.high_impact_boundary') }}</strong> {{ t('core.administrator.business_security.confirm_the_selected_scope_typed_predicate') }}</span></div>
                {{ security_forms.step_up() }}
                <div class="page-actions"><a class="button" href="{{ policy_steps[2].url }}" data-kis-policy-step-target="disclosure">{{ t('core.administrator.business_security.back_to_disclosure') }}</a><button class="primary" type="submit">{{ t('core.administrator.business_security.create_reviewed_policy') }}</button><a class="button" href="/administrator/business-security?section=policies">{{ t('core.administrator.access_control.cancel') }}</a></div>
              </fieldset>
            </form>
          </div>
        </section>
      {% endif %}
    {% elseif mode == 'review' %}
      <p><a href="/administrator/business-security?section=policies">{{ t('core.administrator.business_security.policy_catalog') }}</a></p>
      {% if workspace.kind == 'separation' and separation_rule %}
        <section class="panel stack" aria-labelledby="review-separation-heading"><div><p class="eyebrow">{{ t('core.administrator.business_security.protected_review') }}</p><h2 id="review-separation-heading">{{ separation_rule.rule_code }}</h2><p>{{ separation_rule.resource_type }} · <code>{{ separation_rule.request_action }}</code> → <code>{{ separation_rule.approval_action }}</code></p></div><dl class="definition-metadata"><div><dt>{{ t('core.administrator.business_security.authority_scope') }}</dt><dd>{{ separation_rule.organization_identifier|default('Site-wide') }}</dd></div><div><dt>{{ t('core.administrator.business_security.roles') }}</dt><dd>{{ t('core.administrator.business_security.maker_checker', {requester_role_code: (separation_rule.requester_role_code|default(t('core.administrator.business_security.any_eligible_requester'))), approver_role_code: (separation_rule.approver_role_code|default(t('core.administrator.business_security.any_eligible_approver')))}) }}</dd></div><div><dt>{{ t('core.administrator.business_security.quorum') }}</dt><dd>{{ separation_rule.quorum }} · {{ separation_rule.distinct_actors ? t('core.administrator.business_security.distinct_actors_required') : t('core.administrator.business_security.same_actor_permitted') }}</dd></div><div><dt>{{ t('core.administrator.business_security.current_state') }}</dt><dd>{{ t('core.administrator.business_security.version_2', {status: (separation_rule.status|title), version: separation_rule.version}) }}</dd></div></dl><form method="post" action="/administrator/business-security?section=policies" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="separation_duty.status"><input type="hidden" name="id" value="{{ separation_rule.id }}"><input type="hidden" name="version" value="{{ separation_rule.version }}"><input type="hidden" name="status" value="{{ separation_rule.status == 'active' ? 'inactive' : 'active' }}"><div class="notice warning"><span>{{ t('core.administrator.business_security.this_changes_the_live_maker_checker') }}</span></div>{{ security_forms.step_up() }}<button class="{{ separation_rule.status == 'active' ? 'danger' : 'primary' }}" type="submit">{{ separation_rule.status == 'active' ? t('core.administrator.business_security.deactivate_rule') : t('core.administrator.business_security.activate_rule') }}</button></form></section>
      {% elseif workspace.kind == 'resource' and resource_policy %}
