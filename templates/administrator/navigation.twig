{% extends "layout.twig" %}
{% block title %}{{ t('core.administrator.navigation.menus_kumwe') }}{% endblock %}
{% block context_title %}{{ t('core.administrator.navigation.menus') }}{% endblock %}
{% block content %}
  <div class="kis-phase-five" data-kis-surface="core.administrator.navigation">
    {% embed '@kis/page-header.twig' with {
      eyebrow: t('core.administrator.navigation.site_structure'),
      title: t('core.administrator.navigation.menus_and_navigation'),
      purpose: t('core.administrator.navigation.arrange_the_links_visitors_use_to')
    } only %}
      {% block actions %}<div class="page-actions"><a class="button" href="/" target="_blank" rel="noopener">{{ t('core.administrator.navigation.view_website') }}</a></div>{% endblock %}
    {% endembed %}
  {% if saved %}<div class="notice success" role="status"><span>{{ t('core.administrator.navigation.navigation_updated_public_pages_use_the') }}</span><button class="notice-dismiss" type="button" aria-label="{{ t('core.administrator.business_definitions.dismiss_notice') }}" data-dismiss-notice>×</button></div>{% endif %}

  {% if menus is empty %}
    {% include '@kis/empty-state.twig' with {
      title: t('core.administrator.navigation.create_the_main_menu'),
      message: t('core.administrator.navigation.start_with_one_menu_then_add')
    } only %}
  {% endif %}

  {% embed '@kis/master-detail.twig' with {
    id: 'navigation-workspace',
    catalog_label: t('core.administrator.navigation.menu_catalog'),
    catalog_toggle_label: t('core.administrator.navigation.browse_menus'),
    menus: menus,
    items: items,
    content_targets: content_targets,
    layout_options: layout_options,
    scheme_options: scheme_options,
    csrf: csrf
  } only %}
    {% block catalog %}
      <div class="kis-phase-five-catalog">
        <div><p class="eyebrow">{{ t('core.administrator.business_report.catalog') }}</p><h2>{{ t('core.administrator.navigation.public_menus') }}</h2><p class="field-help">{{ t('core.administrator.navigation.choose_a_menu_to_edit_its') }}</p></div>
        <nav aria-label="{{ t('core.administrator.navigation.available_menus') }}"><ul>
          {% for menu in menus %}<li><a href="#menu-{{ menu.id }}"><strong>{{ menu.title }}</strong><small>{{ t('core.administrator.navigation.links_version', {value: (items[menu.id]|length), version: menu.version}) }}</small></a></li>{% endfor %}
          <li><a href="#create-menu"><strong>{{ t('core.administrator.navigation.create_menu') }}</strong><small>{{ t('core.administrator.navigation.add_another_public_navigation_container') }}</small></a></li>
        </ul></nav>
      </div>
    {% endblock %}
    {% block detail %}
      <div class="stack">
  {% for menu in menus %}
    <section id="menu-{{ menu.id }}" class="panel menu-card kis-phase-five-card">
      <header class="panel-header"><div><h2>{{ menu.title }}</h2><p><code>{{ menu.handle }}</code> {{ t('core.administrator.navigation.links_version_2', {value: (items[menu.id]|length), version: menu.version}) }}</p></div></header>
      <div class="panel-body stack">
        <form action="/administrator/navigation" method="post" class="form-grid"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="menu.update"><input type="hidden" name="id" value="{{ menu.id }}"><input type="hidden" name="version" value="{{ menu.version }}"><label>{{ t('core.administrator.navigation.menu_handle') }}<input name="handle" value="{{ menu.handle }}" pattern="[a-z][a-z0-9_]*" required></label><label>{{ t('core.administrator.navigation.menu_title') }}<input name="title" value="{{ menu.title }}" maxlength="255" required></label><button type="submit">{{ t('core.administrator.navigation.save_menu_details') }}</button></form>
        <kumwe-menu-tree class="stack">
          <div class="stack-compact">
            {% for item in items[menu.id] %}
              <article class="panel-body menu-item" data-menu-item="{{ item.id }}" style="--menu-depth: {{ item.path|split('/')|length - 2 }}">
                <form id="menu-item-{{ item.id }}" action="/administrator/navigation" method="post" class="menu-item-grid" data-navigation-target-form>
                  <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="id" value="{{ item.id }}"><input type="hidden" name="version" value="{{ item.version }}">
                  <label>{{ t('core.administrator.business_definitions.label') }}<input name="title" value="{{ item.title }}" required data-navigation-title></label>
                  <label>{{ t('core.administrator.navigation.link_type') }}<select name="target_type" data-navigation-target-type><option value="content"{% if item.target_type == 'content' %} selected{% endif %}>{{ t('core.administrator.navigation.page') }}</option><option value="anchor"{% if item.target_type == 'anchor' %} selected{% endif %}>{{ t('core.administrator.navigation.page_section') }}</option><option value="url"{% if item.target_type == 'url' %} selected{% endif %}>{{ t('core.administrator.navigation.custom_url') }}</option></select></label>
                  <label data-navigation-content-field>{{ t('core.administrator.navigation.page') }}<select name="content_id" data-navigation-content><option value="">{{ t('core.administrator.navigation.select_a_page') }}</option>{% for target in content_targets %}<option value="{{ target.id }}" data-slug="{{ target.slug }}"{% if target.id == item.content_id %} selected{% endif %}>{{ target.title }} · {{ target.status|replace({'_': ' '})|title }}</option>{% endfor %}</select></label>
                  <label data-navigation-url-field>{{ t('core.administrator.navigation.anchor_or_custom_url') }}<input name="target_url" value="{{ item.target_url|default('') }}" placeholder="{{ t('core.administrator.navigation.platform_or_https_example_org') }}"></label>
                  <label>{{ t('core.administrator.navigation.url_segment') }}<input name="slug" value="{{ item.slug }}" pattern="[a-z0-9]+(-[a-z0-9]+)*" required data-navigation-slug></label>
                  <label>{{ t('core.administrator.navigation.parent') }}<select name="parent_id"><option value="">{{ t('core.administrator.navigation.top_level') }}</option>{% for candidate in items[menu.id] %}{% if candidate.id != item.id %}<option value="{{ candidate.id }}"{% if candidate.id == item.parent_id %} selected{% endif %}>{{ candidate.path }}</option>{% endif %}{% endfor %}</select></label>
                  <label>{{ t('core.administrator.navigation.template') }}<select name="template"><option value="">{{ t('core.administrator.navigation.type_default') }}</option>{% for layout in layout_options %}<option value="{{ layout }}"{% if item.template == layout %} selected{% endif %}>{{ layout|title }}</option>{% endfor %}</select></label>
                  <label>{{ t('core.administrator.navigation.colour_scheme') }}<select name="color_scheme"><option value="">{{ t('core.administrator.navigation.site_default') }}</option>{% for scheme in scheme_options %}<option value="{{ scheme.handle }}"{% if item.color_scheme == scheme.handle %} selected{% endif %}>{{ scheme.name }}</option>{% endfor %}</select></label>
                  <label>{{ t('core.administrator.business_detail.position') }}<input type="number" min="0" name="position" value="{{ item.position }}" data-position-input></label>
                  <div class="page-actions"><button name="action" value="item.update">{{ t('core.administrator.navigation.save') }}</button><button class="danger" name="action" value="item.delete" data-confirm="Delete the ‘{{ item.title }}’ menu item?">{{ t('core.administrator.automation.delete') }}</button></div>
                </form>
                <p class="field-help">{{ t('core.administrator.navigation.calculated_menu_path') }} <code>{{ item.path }}</code>{% if item.target_type == 'anchor' %} {{ t('core.administrator.navigation.section', {target_url: item.target_url}) }}{% elseif item.target_type == 'url' %} {{ t('core.administrator.navigation.destination', {target_url: item.target_url}) }}{% endif %}</p>
              </article>
            {% else %}<div class="empty-state"><div class="empty-state-content"><h3>{{ t('core.administrator.navigation.no_links_yet') }}</h3><p>{{ t('core.administrator.navigation.add_the_first_public_page_below') }}</p></div></div>{% endfor %}
          </div>
          {% if items[menu.id] is not empty %}<form action="/administrator/navigation" method="post" class="page-actions"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="item.reorder"><input type="hidden" name="menu_id" value="{{ menu.id }}"><input type="hidden" name="order" value="{% for item in items[menu.id] %}{{ not loop.first ? ',' : '' }}{{ item.id }}{% endfor %}" data-order-input><button type="submit">{{ t('core.administrator.navigation.save_item_order') }}</button><span class="field-help">{{ t('core.administrator.navigation.drag_rows_or_edit_each_numeric') }}</span></form>{% endif %}
        </kumwe-menu-tree>

        <details class="advanced-definition"><summary>{{ t('core.administrator.navigation.add_a_menu_item') }}</summary><form action="/administrator/navigation" method="post" class="form-grid panel-body" data-navigation-target-form><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="item.create"><input type="hidden" name="menu_id" value="{{ menu.id }}"><label>{{ t('core.administrator.navigation.link_label') }}<input name="title" required data-navigation-title></label><label>{{ t('core.administrator.navigation.link_type') }}<select name="target_type" data-navigation-target-type><option value="content">{{ t('core.administrator.navigation.page') }}</option><option value="anchor">{{ t('core.administrator.navigation.page_section') }}</option><option value="url">{{ t('core.administrator.navigation.custom_url') }}</option></select></label><label data-navigation-content-field>{{ t('core.administrator.navigation.page') }}<select name="content_id" data-navigation-content><option value="">{{ t('core.administrator.navigation.select_a_page') }}</option>{% for target in content_targets %}<option value="{{ target.id }}" data-slug="{{ target.slug }}">{{ target.title }} · {{ target.status|replace({'_': ' '})|title }}</option>{% endfor %}</select></label><label data-navigation-url-field>{{ t('core.administrator.navigation.anchor_or_custom_url') }}<input name="target_url" placeholder="{{ t('core.administrator.navigation.platform_or_https_example_org') }}"></label><label>{{ t('core.administrator.navigation.url_segment') }}<input name="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" required data-navigation-slug></label><label>{{ t('core.administrator.navigation.parent') }}<select name="parent_id"><option value="">{{ t('core.administrator.navigation.top_level') }}</option>{% for item in items[menu.id] %}<option value="{{ item.id }}">{{ item.path }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.navigation.template') }}<select name="template"><option value="">{{ t('core.administrator.navigation.type_default') }}</option>{% for layout in layout_options %}<option value="{{ layout }}">{{ layout|title }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.navigation.colour_scheme') }}<select name="color_scheme"><option value="">{{ t('core.administrator.navigation.site_default') }}</option>{% for scheme in scheme_options %}<option value="{{ scheme.handle }}">{{ scheme.name }}</option>{% endfor %}</select></label><label>{{ t('core.administrator.business_detail.position') }}<input type="number" min="0" name="position" value="{{ items[menu.id]|length }}"></label><button class="primary" type="submit">{{ t('core.administrator.navigation.add_link') }}</button></form></details>
        <details class="kis-phase-five-danger-zone"><summary>{{ t('core.administrator.access_control.danger_zone') }}</summary><form action="/administrator/navigation" method="post" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="menu.delete"><input type="hidden" name="id" value="{{ menu.id }}"><input type="hidden" name="version" value="{{ menu.version }}"><p>{{ t('core.administrator.navigation.deleting') }} <strong>{{ menu.title }}</strong> {{ t('core.administrator.navigation.also_deletes_its_link_public_pages', {count: items[menu.id]|length}) }}</p><button class="danger" type="submit" data-confirm="Delete ‘{{ menu.title }}’ and all its links?">{{ t('core.administrator.navigation.delete_menu', {title: menu.title}) }}</button></form></details>
      </div>
    </section>
  {% endfor %}

    <section id="create-menu" class="panel panel-body stack kis-phase-five-card"><div><p class="eyebrow">{{ t('core.administrator.navigation.new_navigation') }}</p><h2>{{ t('core.administrator.navigation.create_a_menu') }}</h2><p class="field-help">{{ t('core.administrator.navigation.create_the_container_first_then_add') }}</p></div><form action="/administrator/navigation" method="post" class="form-grid"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="menu.create"><label>{{ t('core.administrator.business_definitions.handle') }}<input name="handle" value="{{ menus is empty ? 'main' : '' }}" pattern="[a-z][a-z0-9_]*" required></label><label>{{ t('core.administrator.content_form.title') }}<input name="title" value="{{ menus is empty ? t('core.administrator.navigation.main_menu') : '' }}" maxlength="255" required></label><button class="primary" type="submit">{{ t('core.administrator.navigation.create_menu') }}</button></form></section>
      </div>
    {% endblock %}
  {% endembed %}
  </div>
{% endblock %}
