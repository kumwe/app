    {% elseif mode == 'review' %}
      <p><a href="/administrator/access?section=tokens">{{ t('core.administrator.access_control.token_catalog') }}</a></p>{% if token %}<section class="panel stack" aria-labelledby="token-review-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.credential_review') }}</p><h2 id="token-review-heading">{{ token.name }}</h2><p>{{ token.subject_name }} · {{ token.subject_email }}</p></div><dl class="definition-metadata"><div><dt>{{ t('core.administrator.access_control.token_id') }}</dt><dd>{% include '@kis/technical-value.twig' with {label: t('core.administrator.access_control.token_id'), value: token.id} only %}</dd></div><div><dt>{{ t('core.administrator.access_control.scope') }}</dt><dd>{{ token.audience }} · {{ token.purpose }} · {{ token.site_identifier }}</dd></div><div><dt>{{ t('core.administrator.access_control.capabilities') }}</dt><dd>{{ token.capabilities|join(', ') }}</dd></div><div><dt>{{ t('core.administrator.access_control.expiry') }}</dt><dd>{{ token.expires_at|default(t('core.administrator.access_control.no_expiry')) }}</dd></div><div><dt>{{ t('core.administrator.access_control.status') }}</dt><dd>{{ token.revoked_at ? 'Revoked' : 'Active' }}</dd></div></dl>{% if not token.revoked_at and capabilities['users.manage'] is defined %}<section class="role-card stack"><h3>{{ t('core.administrator.access_control.rotate_token') }}</h3><p>{{ t('core.administrator.access_control.rotation_issues_one_replacement_secret_and') }}</p><form method="post" action="/administrator/access?section=tokens&amp;mode=create" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="token.rotate"><input type="hidden" name="token_id" value="{{ token.id }}"><label>{{ t('core.administrator.access_control.replacement_name') }}<input name="token_name" value="{{ token.name }}" required></label><label>{{ t('core.administrator.access_control.replacement_expiry') }} <span class="text-muted">{{ t('core.administrator.access_control.optional') }}</span><input type="datetime-local" name="expires_at"></label>{{ access_forms.step_up() }}<button class="primary" type="submit">{{ t('core.administrator.access_control.rotate_and_show_replacement_once') }}</button></form></section><section class="role-card stack"><h3>{{ t('core.administrator.access_control.revoke_token') }}</h3><p>{{ t('core.administrator.access_control.revocation_is_immediate_and_retained_in') }}</p><form method="post" action="/administrator/access?section=tokens" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="token.revoke"><input type="hidden" name="token_id" value="{{ token.id }}">{{ access_forms.step_up() }}<button class="danger" type="submit">{{ t('core.administrator.access_control.revoke_2', {name: token.name}) }}</button></form></section>{% endif %}</section>{% else %}{% embed '@kis/empty-state.twig' with {title: t('core.administrator.access_control.token_unavailable'), message: t('core.administrator.access_control.the_token_does_not_exist_in')} %}{% endembed %}{% endif %}
    {% elseif mode == 'history' %}
      <section class="panel stack"><div><p class="eyebrow">{{ t('core.administrator.access_control.credential_audit') }}</p><h2>{{ t('core.administrator.access_control.token_history') }}</h2><p>{{ t('core.administrator.access_control.issue_rotation_revocation_and_emergency_actions') }}</p></div><a class="button primary" href="/administrator/access?section=events">{{ t('core.administrator.access_control.open_security_events') }}</a></section>
    {% else %}
      <section class="panel stack" aria-labelledby="tokens-heading"><header class="panel-header section-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.non_human_credentials') }}</p><h2 id="tokens-heading">{{ t('core.administrator.access_control.api_cli_and_mcp_tokens') }}</h2><p>{{ t('core.administrator.access_control.only_metadata_is_listed_plaintext_secrets') }}</p></div>{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=tokens&amp;mode=create">{{ t('core.administrator.access_control.create_token') }}</a>{% endif %}</header><div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.access_control.api_cli_and_mcp_tokens') }}"><table><thead><tr><th scope="col">{{ t('core.administrator.access_control.token') }}</th><th scope="col">{{ t('core.administrator.access_control.user') }}</th><th scope="col">{{ t('core.administrator.access_control.capabilities') }}</th><th scope="col">{{ t('core.administrator.access_control.expiry') }}</th><th scope="col">{{ t('core.administrator.access_control.status') }}</th><th scope="col">{{ t('core.administrator.access_control.review') }}</th></tr></thead><tbody>{% for item in tokens %}<tr><th scope="row">{{ item.name }}<br><small>{{ item.id }}</small></th><td>{{ item.subject_name }}<br><small>{{ item.subject_email }}</small></td><td><small>{{ item.capabilities|join(', ') }}<br>{{ item.audience }} · {{ item.purpose }} · {{ item.site_identifier }}</small></td><td>{{ item.expires_at|default(t('core.administrator.access_control.no_expiry')) }}</td><td><span class="status status-{{ item.revoked_at ? 'draft' : 'published' }}">{{ item.revoked_at ? 'Revoked' : 'Active' }}</span></td><td><a href="/administrator/access?section=tokens&amp;mode=review&amp;id={{ item.id|url_encode }}">{{ t('core.administrator.access_control.review_token') }}</a></td></tr>{% else %}<tr><td colspan="6">{{ t('core.administrator.access_control.no_api_cli_or_mcp_tokens') }}</td></tr>{% endfor %}</tbody></table></div><div class="page-actions"><a class="button" href="/administrator/access?section=tokens&amp;mode=history">{{ t('core.administrator.access_control.token_history') }}</a></div></section>
    {% endif %}

  {% elseif section == 'events' %}
    {% if mode == 'review' %}
      <p><a href="/administrator/access?section=events">{{ t('core.administrator.access_control.security_events_2') }}</a></p><section class="panel stack" aria-labelledby="step-up-enrollment-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.current_administrator_assurance') }}</p><h2 id="step-up-enrollment-heading">{{ t('core.administrator.access_control.authenticator_and_recovery_setup') }}</h2><p>{{ t('core.administrator.access_control.enrollment_material_and_recovery_codes_are') }}</p></div>{% if step_up_enrollment %}<div class="alert token-result" role="status"><strong>{{ t('core.administrator.access_control.add_this_secret_to_your_authenticator') }}</strong><code>{{ step_up_enrollment.secret }}</code><small>{{ t('core.administrator.access_control.provisioning_uri', {provisioningUri: step_up_enrollment.provisioningUri}) }}</small><small>{{ t('core.administrator.access_control.expires') }} <time datetime="{{ step_up_enrollment.expiresAt|date('c') }}">{{ step_up_enrollment.expiresAt|date('Y-m-d H:i T') }}</time></small></div><form method="post" action="/administrator/access?section=events&amp;mode=review" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="step_up.confirm"><input type="hidden" name="enrollment_id" value="{{ step_up_enrollment.enrollmentId }}"><label>{{ t('core.administrator.access_control.current_authenticator_code') }}<input name="step_up_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}" required></label><button class="primary" type="submit">{{ t('core.administrator.access_control.confirm_enrollment') }}</button></form>{% else %}<form method="post" action="/administrator/access?section=events&amp;mode=review"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="step_up.begin"><button class="primary" type="submit">{{ t('core.administrator.access_control.begin_authenticator_setup') }}</button></form>{% endif %}{% if step_up_recovery_codes is not empty %}<div class="alert token-result" role="status"><strong>{{ t('core.administrator.access_control.copy_all_recovery_codes_now_they') }}</strong><ul>{% for code in step_up_recovery_codes %}<li><code>{{ code }}</code></li>{% endfor %}</ul></div>{% endif %}<div class="page-actions"><a class="button" href="/administrator/access?section=events&amp;mode=edit">{{ t('core.administrator.access_control.rotate_my_credentials') }}</a></div></section>
    {% elseif mode == 'edit' %}
      <p><a href="/administrator/access?section=events&amp;mode=review">{{ t('core.administrator.access_control.authenticator_and_recovery_setup_2') }}</a></p>
      {% if step_up_recovery_codes is not empty %}<div class="alert token-result" role="status"><strong>{{ t('core.administrator.access_control.copy_all_recovery_codes_now_they') }}</strong><ul>{% for code in step_up_recovery_codes %}<li><code>{{ code }}</code></li>{% endfor %}</ul></div>{% endif %}
      <section class="panel stack" aria-labelledby="own-password-heading">
        <div><p class="eyebrow">{{ t('core.administrator.access_control.your_credential') }}</p><h2 id="own-password-heading">{{ t('core.administrator.access_control.change_my_password') }}</h2><p>{{ t('core.administrator.access_control.prove_the_password_you_are_replacing') }}</p></div>
        <form method="post" action="/administrator/access?section=events&amp;mode=edit" class="stack">
          <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="user.password.change">
          <label>{{ t('core.administrator.access_control.current_password') }}<input type="password" name="current_password" autocomplete="current-password" required></label>
          <label>{{ t('core.administrator.access_control.new_password') }}<input type="password" name="new_password" minlength="12" autocomplete="new-password" required><small>{{ t('core.administrator.access_control.at_least_12_characters_choose_a') }}</small></label>
          <label>{{ t('core.administrator.access_control.confirm_new_password') }}<input type="password" name="new_password_confirmation" minlength="12" autocomplete="new-password" required></label>
          {{ access_forms.step_up() }}
          <div class="page-actions"><button class="primary" type="submit">{{ t('core.administrator.access_control.change_my_password') }}</button></div>
        </form>
      </section>
      <section class="panel stack" aria-labelledby="own-recovery-heading">
        <div><p class="eyebrow">{{ t('core.administrator.access_control.your_recovery_codes') }}</p><h2 id="own-recovery-heading">{{ t('core.administrator.access_control.reissue_recovery_codes') }}</h2><p>{{ t('core.administrator.access_control.replaces_every_recovery_code_with_a') }}</p></div>
        <form method="post" action="/administrator/access?section=events&amp;mode=edit" class="stack">
          <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="step_up.recovery.reissue">
          <label>{{ t('core.administrator.access_control.current_authenticator_code') }}<input name="step_up_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}" required></label>
          <div class="page-actions"><button type="submit">{{ t('core.administrator.access_control.reissue_my_recovery_codes') }}</button></div>
        </form>
      </section>
    {% else %}
      <section class="panel stack" aria-labelledby="security-events-heading"><header class="panel-header section-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.installation_audit') }}</p><h2 id="security-events-heading">{{ t('core.administrator.access_control.security_events') }}</h2><p>{{ t('core.administrator.access_control.recent_identity_role_capability_token_and') }}</p></div><a class="button" href="/administrator/access?section=events&amp;mode=review">{{ t('core.administrator.access_control.set_up_my_verification') }}</a></header>{% if security_events is empty %}{% embed '@kis/empty-state.twig' with {title: t('core.administrator.access_control.no_identity_security_events'), message: t('core.administrator.access_control.no_identity_role_grant_token_or')} %}{% endembed %}{% else %}<div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.access_control.identity_security_events') }}"><table><thead><tr><th scope="col">{{ t('core.administrator.access_control.time') }}</th><th scope="col">{{ t('core.administrator.access_control.action') }}</th><th scope="col">{{ t('core.administrator.access_control.actor') }}</th><th scope="col">{{ t('core.administrator.access_control.target') }}</th><th scope="col">{{ t('core.administrator.access_control.outcome') }}</th></tr></thead><tbody>{% for event in security_events %}<tr><td>{{ event.occurred_at }}</td><th scope="row"><code>{{ event.action }}</code></th><td>{{ event.actor_id|default('System') }}</td><td>{{ event.subject_type }}{% if event.subject_id %}<br><small>{{ event.subject_id }}</small>{% endif %}</td><td><span class="status status-{{ event.outcome == 'success' ? 'published' : 'draft' }}">{{ event.outcome|title }}</span></td></tr>{% endfor %}</tbody></table></div>{% endif %}<p class="text-muted text-small">{{ t('core.administrator.access_control.the_timeline_is_capped_at_the') }}</p></section>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
