{% extends "layout.twig" %}

{% macro step_up() %}
  <fieldset class="field-group stack">
    <legend>{{ t('core.administrator.access_control.verify_this_exact_action') }}</legend>
    <p class="text-muted text-small">{{ t('core.administrator.access_control.one_verification_covers_this_submitted_change') }}</p>
    <label>{{ t('core.administrator.access_control.verification_method') }}<select name="step_up_method"><option value="totp">{{ t('core.administrator.access_control.authenticator_code') }}</option><option value="recovery">{{ t('core.administrator.access_control.recovery_code') }}</option></select></label>
    <div class="two-column"><label>{{ t('core.administrator.access_control.authenticator_code') }}<input name="step_up_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}"></label><label>{{ t('core.administrator.access_control.recovery_code') }}<input name="recovery_code" autocomplete="one-time-code" maxlength="128"></label></div>
    <small>{{ t('core.administrator.access_control.fill_only_the_field_matching_the') }}</small>
  </fieldset>
{% endmacro %}

{% import _self as access_forms %}
{% set section = workspace.section %}
{% set mode = workspace.mode %}
{% set selected_id = workspace.id %}

{% block title %}{{ t('core.administrator.access_control.users_and_access_kumwe') }}{% endblock %}
{% block context_title %}{{ t('core.administrator.access_control.users_access') }}{% endblock %}
{% block content %}
<div class="kis-access-control" data-kis-surface="core.administrator.access-control" data-kis-component="local-navigation">
  {% embed '@kis/page-header.twig' with {
    eyebrow: 'Identity',
    title: t('core.administrator.access_control.users_access'),
    purpose: t('core.administrator.access_control.manage_identities_groups_and_roles_capability')
  } %}
    {% block metadata %}<p><strong>{{ t('core.administrator.access_control.authority_context') }}</strong> {{ active_organization|default('Installation') }}{% if active_workspace %} / {{ active_workspace }}{% endif %}</p>{% endblock %}
    {% block actions %}<div class="page-actions"><a class="button" href="/administrator/business-security?section=overview">{{ t('core.administrator.access_control.open_business_security') }}</a></div>{% endblock %}
  {% endembed %}

  {% if saved %}<div class="notice success" role="status"><span>{{ t('core.administrator.access_control.users_access_updated') }}</span><button class="notice-dismiss" type="button" aria-label="{{ t('core.administrator.access_control.dismiss') }}" data-dismiss-notice>×</button></div>{% endif %}

  <nav class="panel" aria-label="{{ t('core.administrator.access_control.users_and_access_concerns') }}">
    <div class="actions">
      {% for item in [
        {id: 'users', label: 'Users'},
        {id: 'groups', label: t('core.administrator.access_control.groups_roles')},
        {id: 'grants', label: 'Grants'},
        {id: 'assignments', label: 'Assignments'},
        {id: 'tokens', label: 'Tokens'},
        {id: 'events', label: t('core.administrator.access_control.security_events')}
      ] %}
        <a class="button{% if section == item.id %} primary{% endif %}" href="/administrator/access?section={{ item.id }}"{% if section == item.id %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </div>
  </nav>

  {% if organization_selections is not empty %}
    <section class="panel stack" aria-labelledby="authority-context-heading">
      <div><p class="eyebrow">{{ t('core.administrator.access_control.live_membership') }}</p><h2 id="authority-context-heading">{{ t('core.administrator.access_control.organization_context') }}</h2><p>{{ t('core.administrator.access_control.choose_only_from_current_memberships_a') }}</p></div>
      <p><strong>{{ t('core.administrator.access_control.active') }}</strong> {{ active_organization|default('Installation') }}{% if active_workspace %} / {{ active_workspace }}{% endif %}</p>
      <div class="actions" role="list" aria-label="{{ t('core.administrator.access_control.available_organization_contexts') }}">{% for selection in organization_selections %}<form method="post" action="/administrator/access?section={{ section }}{% if mode != 'browse' %}&amp;mode={{ mode }}{% endif %}{% if selected_id is not null %}&amp;id={{ selected_id|url_encode }}{% endif %}" role="listitem"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="context.select"><input type="hidden" name="organization" value="{{ selection.organization }}"><input type="hidden" name="workspace" value="{{ selection.workspace|default('') }}"><button type="submit"{% if selection.organization == active_organization and selection.workspace == active_workspace %} aria-current="true"{% endif %}>{{ selection.organization }}{% if selection.workspace %} / {{ selection.workspace }}{% else %} {{ t('core.administrator.access_control.all_workspaces') }}{% endif %}</button></form>{% endfor %}</div>
    </section>
  {% endif %}

  {% if section == 'users' %}
    {% set user = selected_id ? users|filter(item => item.id == selected_id)|first : null %}
    {% if mode == 'create' %}
      <p><a href="/administrator/access?section=users">{{ t('core.administrator.access_control.user_catalog') }}</a></p>
      <section class="panel stack" aria-labelledby="create-user-heading">
        <div><p class="eyebrow">{{ t('core.administrator.access_control.portal_provisioning_step_1') }}</p><h2 id="create-user-heading">{{ t('core.administrator.access_control.create_active_identity') }}</h2><p>{{ t('core.administrator.access_control.issue_a_unique_initial_password_to') }}</p></div>
        {% if capabilities['users.manage'] is defined %}
          <form method="post" action="/administrator/access?section=users" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="user.create">
            <label>{{ t('core.administrator.access_control.email_address') }}<input type="email" name="email" autocomplete="off" required></label>
            <label>{{ t('core.administrator.access_control.display_name') }}<input name="display_name" maxlength="191" required></label>
            <label>{{ t('core.administrator.access_control.unique_initial_password') }}<input type="password" name="password" minlength="12" autocomplete="new-password" required><small>{{ t('core.administrator.access_control.deliver_it_through_an_approved_private') }}</small></label>
            <label>{{ t('core.administrator.access_control.status') }}<select name="status"><option value="active">{{ t('core.administrator.access_control.active_ready_for_membership') }}</option><option value="pending">{{ t('core.administrator.access_control.pending_cannot_sign_in_yet') }}</option></select></label>
            {{ access_forms.step_up() }}
            <div class="page-actions"><button class="primary" type="submit">{{ t('core.administrator.access_control.create_user') }}</button><a class="button" href="/administrator/access?section=users">{{ t('core.administrator.access_control.cancel') }}</a></div>
          </form>
        {% else %}
          {% embed '@kis/empty-state.twig' with {title: t('core.administrator.access_control.user_creation_is_unavailable'), message: t('core.administrator.access_control.an_installation_identity_administrator_must_crea')} %}{% endembed %}
        {% endif %}
      </section>
      <section class="notice" aria-labelledby="provisioning-next-heading"><div><h2 id="provisioning-next-heading">{{ t('core.administrator.access_control.next_grant_portal_membership') }}</h2><p>{{ t('core.administrator.access_control.after_the_identity_exists_create_its') }}</p><a class="button" href="/administrator/business-security?section=memberships&amp;mode=create">{{ t('core.administrator.access_control.continue_to_membership') }}</a></div></section>
    {% elseif mode == 'edit' %}
      <p><a href="/administrator/access?section=users">{{ t('core.administrator.access_control.user_catalog') }}</a></p>
      {% if not user %}
        {% embed '@kis/empty-state.twig' with {title: t('core.administrator.access_control.user_unavailable'), message: t('core.administrator.access_control.the_user_does_not_exist_in')} %}{% block action %}<a class="button" href="/administrator/access?section=users">{{ t('core.administrator.access_control.return_to_users') }}</a>{% endblock %}{% endembed %}
      {% else %}
        <section class="panel stack" aria-labelledby="edit-user-heading"><div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.focused_edit') }}</p><h2 id="edit-user-heading">{{ user.display_name }}</h2><p>{{ t('core.administrator.access_control.version', {email: user.email, status: (user.status|title), version: user.version}) }}</p></div><a class="button" href="/administrator/access?section=users&amp;mode=review&amp;id={{ user.id|url_encode }}">{{ t('core.administrator.access_control.review_access_and_emergency_action') }}</a></div>
          {% if capabilities['users.manage'] is defined %}<form method="post" action="/administrator/access?section=users" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="user.update"><input type="hidden" name="id" value="{{ user.id }}"><input type="hidden" name="version" value="{{ user.version }}"><label>{{ t('core.administrator.access_control.display_name') }}<input name="display_name" value="{{ user.display_name }}" required></label><label>{{ t('core.administrator.access_control.email_address') }}<input type="email" name="email" value="{{ user.email }}" required></label><label>{{ t('core.administrator.access_control.status') }}<select name="status">{% for status in ['pending','active','suspended','disabled'] %}<option value="{{ status }}"{% if status == user.status %} selected{% endif %}>{{ status|title }}</option>{% endfor %}</select></label>{{ access_forms.step_up() }}<div class="page-actions"><button class="primary" type="submit">{{ t('core.administrator.access_control.save_user') }}</button><a class="button" href="/administrator/access?section=users">{{ t('core.administrator.access_control.cancel') }}</a></div></form>{% endif %}
        </section>
      {% endif %}
    {% elseif mode == 'review' %}
      <p><a href="/administrator/access?section=users">{{ t('core.administrator.access_control.user_catalog') }}</a></p>
      {% if not user %}
        {% embed '@kis/empty-state.twig' with {title: t('core.administrator.access_control.user_unavailable'), message: t('core.administrator.access_control.the_user_does_not_exist_in')} %}{% endembed %}
      {% else %}
        <section class="panel stack" aria-labelledby="review-user-heading"><div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.identity_review') }}</p><h2 id="review-user-heading">{{ user.display_name }}</h2><p>{{ t('core.administrator.access_control.version', {email: user.email, status: (user.status|title), version: user.version}) }}</p></div><a class="button" href="/administrator/access?section=users&amp;mode=edit&amp;id={{ user.id|url_encode }}">{{ t('core.administrator.access_control.edit_user') }}</a></div><div><h3>{{ t('core.administrator.access_control.direct_groups_and_roles') }}</h3>{% for role in user.roles %}<span class="status">{{ role.name }} · {{ role.code }}</span> {% else %}<span class="text-muted">{{ t('core.administrator.access_control.no_direct_role_assignment') }}</span>{% endfor %}</div><div class="notice"><span><strong>{{ t('core.administrator.access_control.portal_readiness') }}</strong> {{ t('core.administrator.access_control.active_identity_is_only_step_one') }}</span></div><div class="page-actions"><a class="button" href="/administrator/business-security?section=memberships">{{ t('core.administrator.access_control.review_memberships') }}</a><a class="button" href="/administrator/access?section=events">{{ t('core.administrator.access_control.review_security_events') }}</a></div></section>
        {% if capabilities['users.manage'] is defined %}<section class="panel stack" aria-labelledby="emergency-token-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.danger_zone') }}</p><h2 id="emergency-token-heading">{{ t('core.administrator.access_control.emergency_credential_revocation') }}</h2><p>{{ t('core.administrator.access_control.revoke_all_tokens_only_when_this') }}</p></div><form method="post" action="/administrator/access?section=users" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="token.emergency_revoke"><input type="hidden" name="user_id" value="{{ user.id }}"><label>{{ t('core.administrator.access_control.emergency_revocation_reason') }}<input name="reason" maxlength="500" required></label>{{ access_forms.step_up() }}<button class="danger" type="submit">{{ t('core.administrator.access_control.revoke_every_token_for', {display_name: user.display_name}) }}</button></form></section>
          <section class="panel stack" aria-labelledby="credential-recovery-heading">
            <div><p class="eyebrow">{{ t('core.administrator.access_control.danger_zone') }}</p><h2 id="credential-recovery-heading">{{ t('core.administrator.access_control.credential_recovery_for', {display_name: user.display_name}) }}</h2><p>{{ t('core.administrator.access_control.each_act_below_is_a_focused') }}</p></div>
            <div class="page-actions">
              <a class="button" href="/administrator/access?section=users&amp;mode=password&amp;id={{ user.id|url_encode }}">{{ t('core.administrator.access_control.reset_password') }}</a>
              <a class="button" href="/administrator/access?section=users&amp;mode=unenroll&amp;id={{ user.id|url_encode }}">{{ t('core.administrator.access_control.retire_second_factors') }}</a>
              <a class="button" href="/administrator/access?section=users&amp;mode=sessions&amp;id={{ user.id|url_encode }}">{{ t('core.administrator.access_control.end_every_session') }}</a>
            </div>
          </section>{% endif %}
      {% endif %}
    {% elseif mode in ['password', 'unenroll', 'sessions'] %}
      <p><a href="/administrator/access?section=users&amp;mode=review&amp;id={{ selected_id|url_encode }}">{{ t('core.administrator.access_control.identity_review_2') }}</a></p>
      {% if not user or capabilities['users.manage'] is not defined %}
        {% embed '@kis/empty-state.twig' with {title: t('core.administrator.access_control.credential_recovery_is_unavailable'), message: t('core.administrator.access_control.the_account_does_not_exist_in')} %}{% block action %}<a class="button" href="/administrator/access?section=users">{{ t('core.administrator.access_control.return_to_users') }}</a>{% endblock %}{% endembed %}
      {% elseif mode == 'password' and user.id == active_actor_id %}
        {% embed '@kis/empty-state.twig' with {title: t('core.administrator.access_control.reset_your_own_password_from_your'), message: t('core.administrator.access_control.replacing_your_own_password_requires_proving')} %}{% block action %}<a class="button" href="/administrator/access?section=events&amp;mode=edit">{{ t('core.administrator.access_control.change_my_password') }}</a>{% endblock %}{% endembed %}
      {% elseif mode == 'password' %}
        <section class="panel stack" aria-labelledby="reset-password-heading">
          <div><p class="eyebrow">{{ t('core.administrator.access_control.danger_zone_focused_task') }}</p><h2 id="reset-password-heading">{{ t('core.administrator.access_control.reset_the_password_of', {display_name: user.display_name}) }}</h2><p>{{ t('core.administrator.access_control.sets_a_new_password_without_asking') }}</p></div>
          <form method="post" action="/administrator/access?section=users" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="user.password.reset"><input type="hidden" name="user_id" value="{{ user.id }}">
            <label>{{ t('core.administrator.access_control.new_password') }}<input type="password" name="new_password" minlength="12" autocomplete="new-password" required><small>{{ t('core.administrator.access_control.at_least_12_characters') }}</small></label>
            <label>{{ t('core.administrator.access_control.reason_for_this_reset') }}<input name="reason" maxlength="500" required><small>{{ t('core.administrator.access_control.stored_on_the_audit_event_beside') }}</small></label>
            {{ access_forms.step_up() }}
            <div class="page-actions"><button class="danger" type="submit">{{ t('core.administrator.access_control.reset_this_password') }}</button><a class="button" href="/administrator/access?section=users&amp;mode=review&amp;id={{ user.id|url_encode }}">{{ t('core.administrator.access_control.cancel') }}</a></div>
          </form>
        </section>
      {% elseif mode == 'unenroll' %}
        <section class="panel stack" aria-labelledby="unenroll-heading">
          <div><p class="eyebrow">{{ t('core.administrator.access_control.danger_zone_focused_task') }}</p><h2 id="unenroll-heading">{{ t('core.administrator.access_control.retire_the_second_factors_of', {display_name: user.display_name}) }}</h2><p>{{ t('core.administrator.access_control.for_a_lost_authenticator_with_no') }}</p></div>
          <form method="post" action="/administrator/access?section=users" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="user.step_up.revoke"><input type="hidden" name="user_id" value="{{ user.id }}">
            <label>{{ t('core.administrator.access_control.reason_for_this_retirement') }}<input name="reason" maxlength="500" required><small>{{ t('core.administrator.access_control.stored_beside_the_retired_credential_as') }}</small></label>
            {{ access_forms.step_up() }}
            <div class="page-actions"><button class="danger" type="submit">{{ t('core.administrator.access_control.retire_every_second_factor') }}</button><a class="button" href="/administrator/access?section=users&amp;mode=review&amp;id={{ user.id|url_encode }}">{{ t('core.administrator.access_control.cancel') }}</a></div>
          </form>
        </section>
      {% else %}
        <section class="panel stack" aria-labelledby="terminate-sessions-heading">
          <div><p class="eyebrow">{{ t('core.administrator.access_control.danger_zone_focused_task') }}</p><h2 id="terminate-sessions-heading">{{ t('core.administrator.access_control.end_every_session_of', {display_name: user.display_name}) }}</h2><p>{{ t('core.administrator.access_control.signs_this_account_out_of_every') }}</p></div>
          <form method="post" action="/administrator/access?section=users" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="user.sessions.terminate"><input type="hidden" name="user_id" value="{{ user.id }}">
            <label>{{ t('core.administrator.access_control.reason_for_this_termination') }}<input name="reason" maxlength="500" required></label>
            {{ access_forms.step_up() }}
            <div class="page-actions"><button class="danger" type="submit">{{ t('core.administrator.access_control.end_every_session') }}</button><a class="button" href="/administrator/access?section=users&amp;mode=review&amp;id={{ user.id|url_encode }}">{{ t('core.administrator.access_control.cancel') }}</a></div>
          </form>
        </section>
      {% endif %}
    {% elseif mode == 'history' %}
      <section class="panel stack" aria-labelledby="user-history-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.immutable_audit') }}</p><h2 id="user-history-heading">{{ t('core.administrator.access_control.identity_history') }}</h2><p>{{ t('core.administrator.access_control.user_role_and_token_changes_are') }}</p></div><a class="button primary" href="/administrator/access?section=events">{{ t('core.administrator.access_control.open_security_events') }}</a></section>
    {% else %}
      <section class="panel stack" aria-labelledby="users-heading"><header class="panel-header section-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.identity_catalog') }}</p><h2 id="users-heading">{{ t('core.administrator.access_control.users') }}</h2><p>{{ t('core.administrator.access_control.browse_identity_state_first_edit_emergency') }}</p></div>{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=users&amp;mode=create">{{ t('core.administrator.access_control.create_user') }}</a>{% endif %}</header>
        {% if users is empty %}
          {% embed '@kis/empty-state.twig' with {title: t('core.administrator.access_control.no_manageable_users'), message: capabilities['users.manage'] is defined ? t('core.administrator.access_control.create_the_first_identity_then_continue') : t('core.administrator.access_control.no_identity_records_are_available_in')} %}{% block action %}{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=users&amp;mode=create">{{ t('core.administrator.access_control.create_user') }}</a>{% endif %}{% endblock %}{% endembed %}
        {% else %}
          <div class="table-wrap kis-responsive-table" tabindex="0" role="region" aria-label="{{ t('core.administrator.access_control.users') }}">
            <table class="kis-access-table">
              <thead><tr><th scope="col">{{ t('core.administrator.access_control.user') }}</th><th scope="col">{{ t('core.administrator.access_control.status') }}</th><th scope="col">{{ t('core.administrator.access_control.groups_and_roles') }}</th><th scope="col">{{ t('core.administrator.access_control.tasks') }}</th></tr></thead>
              <tbody>
                {% for item in users %}
                  <tr>
                    <th scope="row" data-label="User">{{ item.display_name }}<br><small>{{ item.email }}</small></th>
                    <td data-label="Status"><span class="status status-{{ item.status }}">{{ item.status|title }}</span><br><small>{{ t('core.administrator.access_control.version_2', {version: item.version}) }}</small></td>
                    <td data-label="Groups and roles">{% for role in item.roles %}<span class="status">{{ role.name }}</span> {% else %}<span class="text-muted">{{ t('core.administrator.access_control.no_direct_role') }}</span>{% endfor %}</td>
                    <td data-label="Tasks"><a class="link-button" href="/administrator/access?section=users&amp;mode=edit&amp;id={{ item.id|url_encode }}">{{ t('core.administrator.access_control.edit_user') }}</a><br><a class="link-button" href="/administrator/access?section=users&amp;mode=review&amp;id={{ item.id|url_encode }}">{{ t('core.administrator.access_control.review_access') }}</a></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </section>
      <section class="notice" aria-labelledby="portal-provisioning-heading"><div><h2 id="portal-provisioning-heading">{{ t('core.administrator.access_control.provision_an_ordinary_portal_member') }}</h2><ol><li>{{ t('core.administrator.access_control.create_a_unique_active_identity') }}</li><li>{{ t('core.administrator.access_control.create_its_organization_membership') }}</li><li>{{ t('core.administrator.access_control.assign_only_the_required_workspace_and') }}</li><li>{{ t('core.administrator.access_control.review_effective_access_then_give_the') }}</li></ol><div class="page-actions"><a class="button" href="/administrator/business-security?section=memberships&amp;mode=create">{{ t('core.administrator.access_control.continue_to_memberships') }}</a><a class="button" href="/portal/login">{{ t('core.administrator.access_control.open_portal_sign_in') }}</a></div></div></section>
    {% endif %}

  {% elseif section == 'groups' %}
    {% set role = selected_id ? roles|filter(item => item.id == selected_id)|first : null %}
    {% if mode == 'create' %}
      <p><a href="/administrator/access?section=groups">{{ t('core.administrator.access_control.group_and_role_catalog') }}</a></p><section class="panel stack" aria-labelledby="create-role-heading"><div><p class="eyebrow">{{ t('core.administrator.access_control.focused_authoring') }}</p><h2 id="create-role-heading">{{ t('core.administrator.access_control.create_group_or_role') }}</h2><p>{{ t('core.administrator.access_control.a_new_role_starts_empty_and') }}</p></div>{% if capabilities['users.manage'] is defined %}<form method="post" action="/administrator/access?section=groups" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="role.create"><label>{{ t('core.administrator.access_control.stable_code') }}<input name="code" pattern="[a-z][a-z0-9._-]+" maxlength="64" required></label><label>{{ t('core.administrator.access_control.name') }}<input name="name" maxlength="191" required></label>{{ access_forms.step_up() }}<div class="page-actions"><button class="primary" type="submit">{{ t('core.administrator.access_control.create_empty_role') }}</button><a class="button" href="/administrator/access?section=groups">{{ t('core.administrator.access_control.cancel') }}</a></div></form>{% endif %}</section>
    {% elseif mode == 'review' %}
