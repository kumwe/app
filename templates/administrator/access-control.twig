{% extends "layout.twig" %}

{% macro step_up() %}
  <fieldset class="field-group stack">
    <legend>Verify this exact action</legend>
    <p class="text-muted text-small">Verification is collected only at submission and is bound to this actor, action, target and rotated session.</p>
    <label>Verification method<select name="step_up_method"><option value="totp">Authenticator code</option><option value="recovery">Recovery code</option></select></label>
    <div class="two-column"><label>Authenticator code<input name="step_up_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}"></label><label>Recovery code<input name="recovery_code" autocomplete="one-time-code" maxlength="128"></label></div>
    <small>Fill only the field matching the selected method. The value is used once and never retained.</small>
  </fieldset>
{% endmacro %}

{% import _self as access_forms %}
{% set section = workspace.section %}
{% set mode = workspace.mode %}
{% set selected_id = workspace.id %}

{% block title %}Users and access · Kumwe{% endblock %}
{% block context_title %}Users &amp; access{% endblock %}
{% block content %}
<div data-kis-surface="core.administrator.access-control" data-kis-component="local-navigation">
  {% embed '@kis/page-header.twig' with {
    eyebrow: 'Identity',
    title: 'Users & access',
    purpose: 'Manage identities, groups and roles, capability grants, assignments, tokens and security events as separate accountable concerns.'
  } %}
    {% block metadata %}<p><strong>Authority context:</strong> {{ active_organization|default('Installation') }}{% if active_workspace %} / {{ active_workspace }}{% endif %}</p>{% endblock %}
    {% block actions %}<div class="page-actions"><a class="button" href="/administrator/business-security?section=overview">Open Business Security</a></div>{% endblock %}
  {% endembed %}

  {% if saved %}<div class="notice success" role="status"><span>Users &amp; Access updated.</span><button class="notice-dismiss" type="button" aria-label="Dismiss" data-dismiss-notice>×</button></div>{% endif %}

  <nav class="panel" aria-label="Users and Access concerns">
    <div class="actions">
      {% for item in [
        {id: 'users', label: 'Users'},
        {id: 'groups', label: 'Groups & roles'},
        {id: 'grants', label: 'Grants'},
        {id: 'assignments', label: 'Assignments'},
        {id: 'tokens', label: 'Tokens'},
        {id: 'events', label: 'Security events'}
      ] %}
        <a class="button{% if section == item.id %} primary{% endif %}" href="/administrator/access?section={{ item.id }}"{% if section == item.id %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </div>
  </nav>

  {% if organization_selections is not empty %}
    <section class="panel stack" aria-labelledby="authority-context-heading">
      <div><p class="eyebrow">Live membership</p><h2 id="authority-context-heading">Organization context</h2><p>Choose only from current memberships. A context change rotates this session and its CSRF secret.</p></div>
      <p><strong>Active:</strong> {{ active_organization|default('Installation') }}{% if active_workspace %} / {{ active_workspace }}{% endif %}</p>
      <div class="actions" role="list" aria-label="Available organization contexts">{% for selection in organization_selections %}<form method="post" action="/administrator/access?section={{ section }}{% if mode != 'browse' %}&amp;mode={{ mode }}{% endif %}{% if selected_id is not null %}&amp;id={{ selected_id|url_encode }}{% endif %}" role="listitem"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="context.select"><input type="hidden" name="organization" value="{{ selection.organization }}"><input type="hidden" name="workspace" value="{{ selection.workspace|default('') }}"><button type="submit"{% if selection.organization == active_organization and selection.workspace == active_workspace %} aria-current="true"{% endif %}>{{ selection.organization }}{% if selection.workspace %} / {{ selection.workspace }}{% else %} / All workspaces{% endif %}</button></form>{% endfor %}</div>
    </section>
  {% endif %}

  {% if section == 'users' %}
    {% set user = selected_id ? users|filter(item => item.id == selected_id)|first : null %}
    {% if mode == 'create' %}
      <p><a href="/administrator/access?section=users">← User catalog</a></p>
      <section class="panel stack" aria-labelledby="create-user-heading">
        <div><p class="eyebrow">Portal provisioning · step 1</p><h2 id="create-user-heading">Create active identity</h2><p>Issue a unique initial password to this person. Never reuse a shared seeded or demonstration secret.</p></div>
        {% if capabilities['users.manage'] is defined %}
          <form method="post" action="/administrator/access?section=users" class="stack">
            <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="user.create">
            <label>Email address<input type="email" name="email" autocomplete="off" required></label>
            <label>Display name<input name="display_name" maxlength="191" required></label>
            <label>Unique initial password<input type="password" name="password" minlength="12" autocomplete="new-password" required><small>Deliver it through an approved private channel and have the user protect it immediately.</small></label>
            <label>Status<select name="status"><option value="active">Active — ready for membership</option><option value="pending">Pending — cannot sign in yet</option></select></label>
            {{ access_forms.step_up() }}
            <div class="page-actions"><button class="primary" type="submit">Create user</button><a class="button" href="/administrator/access?section=users">Cancel</a></div>
          </form>
        {% else %}
          {% embed '@kis/empty-state.twig' with {title: 'User creation is unavailable', message: 'An installation identity administrator must create this account.'} %}{% endembed %}
        {% endif %}
      </section>
      <section class="notice" aria-labelledby="provisioning-next-heading"><div><h2 id="provisioning-next-heading">Next: grant portal membership</h2><p>After the identity exists, create its organization membership and assign only the required workspace and role.</p><a class="button" href="/administrator/business-security?section=memberships&amp;mode=create">Continue to membership</a></div></section>
    {% elseif mode == 'edit' %}
      <p><a href="/administrator/access?section=users">← User catalog</a></p>
      {% if not user %}
        {% embed '@kis/empty-state.twig' with {title: 'User unavailable', message: 'The user does not exist in the current authority scope or is no longer manageable.'} %}{% block action %}<a class="button" href="/administrator/access?section=users">Return to users</a>{% endblock %}{% endembed %}
      {% else %}
        <section class="panel stack" aria-labelledby="edit-user-heading"><div class="section-heading"><div><p class="eyebrow">Focused edit</p><h2 id="edit-user-heading">{{ user.display_name }}</h2><p>{{ user.email }} · {{ user.status|title }} · version {{ user.version }}</p></div><a class="button" href="/administrator/access?section=users&amp;mode=review&amp;id={{ user.id|url_encode }}">Review access and emergency action</a></div>
          {% if capabilities['users.manage'] is defined %}<form method="post" action="/administrator/access?section=users" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="user.update"><input type="hidden" name="id" value="{{ user.id }}"><input type="hidden" name="version" value="{{ user.version }}"><label>Display name<input name="display_name" value="{{ user.display_name }}" required></label><label>Email address<input type="email" name="email" value="{{ user.email }}" required></label><label>Status<select name="status">{% for status in ['pending','active','suspended','disabled'] %}<option value="{{ status }}"{% if status == user.status %} selected{% endif %}>{{ status|title }}</option>{% endfor %}</select></label>{{ access_forms.step_up() }}<div class="page-actions"><button class="primary" type="submit">Save user</button><a class="button" href="/administrator/access?section=users">Cancel</a></div></form>{% endif %}
        </section>
      {% endif %}
    {% elseif mode == 'review' %}
      <p><a href="/administrator/access?section=users">← User catalog</a></p>
      {% if not user %}
        {% embed '@kis/empty-state.twig' with {title: 'User unavailable', message: 'The user does not exist in the current authority scope or is no longer manageable.'} %}{% endembed %}
      {% else %}
        <section class="panel stack" aria-labelledby="review-user-heading"><div class="section-heading"><div><p class="eyebrow">Identity review</p><h2 id="review-user-heading">{{ user.display_name }}</h2><p>{{ user.email }} · {{ user.status|title }} · version {{ user.version }}</p></div><a class="button" href="/administrator/access?section=users&amp;mode=edit&amp;id={{ user.id|url_encode }}">Edit user</a></div><div><h3>Direct groups and roles</h3>{% for role in user.roles %}<span class="status">{{ role.name }} · {{ role.code }}</span> {% else %}<span class="text-muted">No direct role assignment.</span>{% endfor %}</div><div class="notice"><span><strong>Portal readiness:</strong> Active identity is only step one. Confirm the organization membership, workspace and minimum role in Business Security.</span></div><div class="page-actions"><a class="button" href="/administrator/business-security?section=memberships">Review memberships</a><a class="button" href="/administrator/access?section=events">Review security events</a></div></section>
        {% if capabilities['users.manage'] is defined %}<section class="panel stack" aria-labelledby="emergency-token-heading"><div><p class="eyebrow">Danger zone</p><h2 id="emergency-token-heading">Emergency credential revocation</h2><p>Revoke all tokens only when this identity or its credentials may be compromised. This advances the security epoch.</p></div><form method="post" action="/administrator/access?section=users" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="token.emergency_revoke"><input type="hidden" name="user_id" value="{{ user.id }}"><label>Emergency revocation reason<input name="reason" maxlength="500" required></label>{{ access_forms.step_up() }}<button class="danger" type="submit">Revoke every token for {{ user.display_name }}</button></form></section>{% endif %}
      {% endif %}
    {% elseif mode == 'history' %}
      <section class="panel stack" aria-labelledby="user-history-heading"><div><p class="eyebrow">Immutable audit</p><h2 id="user-history-heading">Identity history</h2><p>User, role and token changes are recorded in the installation security-event timeline.</p></div><a class="button primary" href="/administrator/access?section=events">Open security events</a></section>
    {% else %}
      <section class="panel stack" aria-labelledby="users-heading"><header class="panel-header section-heading"><div><p class="eyebrow">Identity catalog</p><h2 id="users-heading">Users</h2><p>Browse identity state first; edit, emergency review and history are focused deep links.</p></div>{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=users&amp;mode=create">Create user</a>{% endif %}</header>
        {% if users is empty %}
          {% embed '@kis/empty-state.twig' with {title: 'No manageable users', message: capabilities['users.manage'] is defined ? 'Create the first identity, then continue to its minimum portal membership.' : 'No identity records are available in this authority scope.'} %}{% block action %}{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=users&amp;mode=create">Create user</a>{% endif %}{% endblock %}{% endembed %}
        {% else %}
          <div class="table-wrap" tabindex="0" role="region" aria-label="Users"><table><thead><tr><th scope="col">User</th><th scope="col">Status</th><th scope="col">Groups and roles</th><th scope="col">Tasks</th></tr></thead><tbody>{% for item in users %}<tr><th scope="row">{{ item.display_name }}<br><small>{{ item.email }}</small></th><td><span class="status status-{{ item.status }}">{{ item.status|title }}</span><br><small>version {{ item.version }}</small></td><td>{% for role in item.roles %}<span class="status">{{ role.name }}</span> {% else %}<span class="text-muted">No direct role</span>{% endfor %}</td><td><a href="/administrator/access?section=users&amp;mode=edit&amp;id={{ item.id|url_encode }}">Edit user</a><br><a href="/administrator/access?section=users&amp;mode=review&amp;id={{ item.id|url_encode }}">Review access</a></td></tr>{% endfor %}</tbody></table></div>
        {% endif %}
      </section>
      <section class="notice" aria-labelledby="portal-provisioning-heading"><div><h2 id="portal-provisioning-heading">Provision an ordinary portal member</h2><ol><li>Create a unique active identity.</li><li>Create its organization membership.</li><li>Assign only the required workspace and role.</li><li>Review effective access, then give the person the portal URL and exact workspace identifier.</li></ol><div class="page-actions"><a class="button" href="/administrator/business-security?section=memberships&amp;mode=create">Continue to memberships</a><a class="button" href="/portal/login">Open portal sign-in</a></div></div></section>
    {% endif %}

  {% elseif section == 'groups' %}
    {% set role = selected_id ? roles|filter(item => item.id == selected_id)|first : null %}
    {% if mode == 'create' %}
      <p><a href="/administrator/access?section=groups">← Group and role catalog</a></p><section class="panel stack" aria-labelledby="create-role-heading"><div><p class="eyebrow">Focused authoring</p><h2 id="create-role-heading">Create group or role</h2><p>A new role starts empty and grants no authority until reviewed capabilities are attached.</p></div>{% if capabilities['users.manage'] is defined %}<form method="post" action="/administrator/access?section=groups" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="role.create"><label>Stable code<input name="code" pattern="[a-z][a-z0-9._-]+" maxlength="64" required></label><label>Name<input name="name" maxlength="191" required></label>{{ access_forms.step_up() }}<div class="page-actions"><button class="primary" type="submit">Create empty role</button><a class="button" href="/administrator/access?section=groups">Cancel</a></div></form>{% endif %}</section>
    {% elseif mode == 'review' %}
      <p><a href="/administrator/access?section=groups">← Group and role catalog</a></p>{% if role %}<section class="panel stack" aria-labelledby="role-review-heading"><div><p class="eyebrow">Role review</p><h2 id="role-review-heading">{{ role.name }}</h2><p><code>{{ role.code }}</code></p></div><h3>Capability grants</h3>{% for grant in role.grants %}<div class="role-card"><strong>{{ grant.capability }}</strong><span>{{ grant.scope_type }}{% if grant.scope_identifier %}:{{ grant.scope_identifier }}{% endif %}</span><a href="/administrator/access?section=grants&amp;mode=review&amp;id={{ grant.id|url_encode }}">Review revocation</a></div>{% else %}<p class="text-muted">This role carries no grants and confers no authority.</p>{% endfor %}<div class="page-actions"><a class="button" href="/administrator/access?section=grants&amp;mode=create">Create grant</a><a class="button" href="/administrator/access?section=assignments&amp;mode=create">Assign role</a></div></section>{% else %}{% embed '@kis/empty-state.twig' with {title: 'Role unavailable', message: 'The role does not exist in the current authority scope.'} %}{% endembed %}{% endif %}
    {% elseif mode == 'history' %}
      <section class="panel stack"><div><p class="eyebrow">Immutable audit</p><h2>Group and role history</h2><p>Role creation, assignments and capability changes are retained in Security Events.</p></div><a class="button primary" href="/administrator/access?section=events">Open security events</a></section>
    {% else %}
      <section class="panel stack" aria-labelledby="groups-heading"><header class="panel-header section-heading"><div><p class="eyebrow">Authority building blocks</p><h2 id="groups-heading">Groups and roles</h2><p>Review a role before adding grants or assigning it to a person.</p></div>{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=groups&amp;mode=create">Create role</a>{% endif %}</header>{% for item in roles %}<article class="role-card"><div class="section-heading"><div><h3>{{ item.name }}</h3><p><code>{{ item.code }}</code> · {{ item.grants|length }} grants</p></div><a class="button" href="/administrator/access?section=groups&amp;mode=review&amp;id={{ item.id|url_encode }}">Review role</a></div></article>{% else %}{% embed '@kis/empty-state.twig' with {title: 'No manageable roles', message: 'Create an empty role before attaching the minimum required grants.'} %}{% block action %}{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=groups&amp;mode=create">Create role</a>{% endif %}{% endblock %}{% endembed %}{% endfor %}<div class="page-actions"><a class="button" href="/administrator/access?section=groups&amp;mode=history">Role history</a></div></section>
    {% endif %}

  {% elseif section == 'grants' %}
    {% set selected_grant_role = selected_id is not null ? roles|filter(item => item.grants|filter(grant => grant.id == selected_id)|length > 0)|first : null %}
    {% set selected_grant = selected_grant_role ? selected_grant_role.grants|filter(grant => grant.id == selected_id)|first : null %}
    {% if mode == 'create' %}
      <p><a href="/administrator/access?section=grants">← Grant catalog</a></p><section class="panel stack" aria-labelledby="create-grant-heading"><div><p class="eyebrow">Focused authority change</p><h2 id="create-grant-heading">Create capability grant</h2><p>Choose one role, live capability and exact scope. The delegation ceiling is rechecked transactionally.</p></div>{% if roles is empty %}{% embed '@kis/empty-state.twig' with {title: 'A role is required', message: 'Create and review an empty role before attaching capability grants.'} %}{% block action %}<a class="button primary" href="/administrator/access?section=groups&amp;mode=create">Create role</a>{% endblock %}{% endembed %}{% elseif capabilities['users.manage'] is defined %}<form method="post" action="/administrator/access?section=grants" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="grant.create"><label>Role<select name="role_id" required>{% for role in roles %}<option value="{{ role.id }}">{{ role.name }} · {{ role.code }}</option>{% endfor %}</select></label><label>Capability<select name="capability" required>{% for option in available_capabilities %}<option value="{{ option.code }}">{{ option.code }} — {{ option.description }}</option>{% endfor %}</select></label><div class="two-column"><label>Scope type<select name="scope_type"><option value="global">Global</option><option value="component">Component</option><option value="content_type">Content type</option></select></label><label>Scope identifier<input name="scope_identifier" placeholder="Required unless scope is global"></label></div>{{ access_forms.step_up() }}<div class="page-actions"><button class="primary" type="submit">Create grant</button><a class="button" href="/administrator/access?section=grants">Cancel</a></div></form>{% endif %}</section>
    {% elseif mode == 'review' %}
      <p><a href="/administrator/access?section=grants">← Grant catalog</a></p>{% if selected_grant and selected_grant_role %}<section class="panel stack" aria-labelledby="grant-review-heading"><div><p class="eyebrow">Protected revocation review</p><h2 id="grant-review-heading">{{ selected_grant.capability }}</h2><p>{{ selected_grant_role.name }} · {{ selected_grant.scope_type }}{% if selected_grant.scope_identifier %}:{{ selected_grant.scope_identifier }}{% endif %}</p></div><div class="notice warning"><span>Revoking this grant changes every current direct and organization-membership assignment of this role and advances affected security epochs.</span></div>{% if capabilities['users.manage'] is defined %}<form method="post" action="/administrator/access?section=grants" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="grant.revoke"><input type="hidden" name="grant_id" value="{{ selected_grant.id }}">{{ access_forms.step_up() }}<button class="danger" type="submit">Revoke {{ selected_grant.capability }}</button></form>{% endif %}</section>{% else %}{% embed '@kis/empty-state.twig' with {title: 'Grant unavailable', message: 'The grant does not exist in the current authority scope or has already been revoked.'} %}{% endembed %}{% endif %}
    {% elseif mode == 'history' %}
      <section class="panel stack"><div><p class="eyebrow">Immutable audit</p><h2>Grant history</h2><p>Capability grant and revocation events are retained without exposing credential values.</p></div><a class="button primary" href="/administrator/access?section=events">Open security events</a></section>
    {% else %}
      <section class="panel stack" aria-labelledby="grants-heading"><header class="panel-header section-heading"><div><p class="eyebrow">Delegated authority</p><h2 id="grants-heading">Capability grants</h2><p>Browse current role grants. Every revocation opens a target-specific review boundary.</p></div>{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=grants&amp;mode=create">Create grant</a>{% endif %}</header><div class="table-wrap" tabindex="0" role="region" aria-label="Capability grants"><table><thead><tr><th scope="col">Role</th><th scope="col">Capability</th><th scope="col">Scope</th><th scope="col">Review</th></tr></thead><tbody>{% for role in roles %}{% for grant in role.grants %}<tr><th scope="row">{{ role.name }}<br><small>{{ role.code }}</small></th><td><code>{{ grant.capability }}</code></td><td>{{ grant.scope_type }}{% if grant.scope_identifier %}:{{ grant.scope_identifier }}{% endif %}</td><td><a href="/administrator/access?section=grants&amp;mode=review&amp;id={{ grant.id|url_encode }}">Review revocation</a></td></tr>{% else %}<tr><th scope="row">{{ role.name }}</th><td colspan="3">No grants; this role confers no authority.</td></tr>{% endfor %}{% else %}<tr><td colspan="4">No roles are available.</td></tr>{% endfor %}</tbody></table></div><div class="page-actions"><a class="button" href="/administrator/access?section=grants&amp;mode=history">Grant history</a></div></section>
    {% endif %}

  {% elseif section == 'assignments' %}
    {% set assignment_parts = selected_id ? selected_id|split(':') : [] %}{% set assignment_user = assignment_parts|length == 2 ? users|filter(item => item.id == assignment_parts[0])|first : null %}{% set assignment_role = assignment_parts|length == 2 ? roles|filter(item => item.id == assignment_parts[1])|first : null %}
    {% if mode == 'create' %}
      <p><a href="/administrator/access?section=assignments">← Assignment catalog</a></p><section class="panel stack" aria-labelledby="assign-role-heading"><div><p class="eyebrow">Focused assignment</p><h2 id="assign-role-heading">Assign group or role</h2><p>The service locks the role and refuses any grant above the actor's delegation ceiling.</p></div>{% if users is empty or roles is empty %}{% embed '@kis/empty-state.twig' with {title: 'Assignment prerequisites are incomplete', message: users is empty ? 'Create an identity before assigning a role.' : 'Create and review a role before assigning it.'} %}{% block action %}<a class="button primary" href="{{ users is empty ? '/administrator/access?section=users&mode=create' : '/administrator/access?section=groups&mode=create' }}">Create prerequisite</a>{% endblock %}{% endembed %}{% elseif capabilities['users.manage'] is defined %}<form method="post" action="/administrator/access?section=assignments" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="role.assign"><label>User<select name="user_id" required>{% for user in users %}<option value="{{ user.id }}">{{ user.display_name }} · {{ user.email }}</option>{% endfor %}</select></label><label>Group or role<select name="role_id" required>{% for role in roles %}<option value="{{ role.id }}">{{ role.name }} · {{ role.code }}</option>{% endfor %}</select></label>{{ access_forms.step_up() }}<div class="page-actions"><button class="primary" type="submit">Assign role</button><a class="button" href="/administrator/access?section=assignments">Cancel</a></div></form>{% endif %}</section><section class="notice"><div><h3>Portal membership remains separate</h3><p>A direct identity role does not create organization membership or workspace access.</p><a class="button" href="/administrator/business-security?section=memberships&amp;mode=create">Continue portal provisioning</a></div></section>
    {% elseif mode == 'review' %}
      <p><a href="/administrator/access?section=assignments">← Assignment catalog</a></p>{% if assignment_user and assignment_role %}<section class="panel stack" aria-labelledby="assignment-review-heading"><div><p class="eyebrow">Protected revocation review</p><h2 id="assignment-review-heading">Remove {{ assignment_role.name }} from {{ assignment_user.display_name }}</h2><p>{{ assignment_user.email }} · {{ assignment_user.status|title }}</p></div><div class="notice warning"><span>This removes every capability conferred through this direct role and advances the user's security epoch.</span></div>{% if capabilities['users.manage'] is defined %}<form method="post" action="/administrator/access?section=assignments" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="role.revoke"><input type="hidden" name="user_id" value="{{ assignment_user.id }}"><input type="hidden" name="role_id" value="{{ assignment_role.id }}">{{ access_forms.step_up() }}<button class="danger" type="submit">Remove {{ assignment_role.name }}</button></form>{% endif %}</section>{% else %}{% embed '@kis/empty-state.twig' with {title: 'Assignment unavailable', message: 'The assignment does not exist in the current authority scope or has already changed.'} %}{% endembed %}{% endif %}
    {% elseif mode == 'history' %}
      <section class="panel stack"><div><p class="eyebrow">Immutable audit</p><h2>Assignment history</h2><p>Direct and membership role changes are retained in Security Events and Business Security approval history.</p></div><div class="page-actions"><a class="button primary" href="/administrator/access?section=events">Open security events</a><a class="button" href="/administrator/business-security?section=approvals&amp;mode=history">Approval history</a></div></section>
    {% else %}
      <section class="panel stack" aria-labelledby="assignments-heading"><header class="panel-header section-heading"><div><p class="eyebrow">Direct identity authority</p><h2 id="assignments-heading">Role assignments</h2><p>Organization-membership roles remain in Business Security; this catalog covers direct identity roles.</p></div>{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=assignments&amp;mode=create">Assign role</a>{% endif %}</header><div class="table-wrap" tabindex="0" role="region" aria-label="Direct role assignments"><table><thead><tr><th scope="col">User</th><th scope="col">Role</th><th scope="col">Review</th></tr></thead><tbody>{% for user in users %}{% for role in user.roles %}<tr><th scope="row">{{ user.display_name }}<br><small>{{ user.email }}</small></th><td>{{ role.name }}<br><code>{{ role.code }}</code></td><td><a href="/administrator/access?section=assignments&amp;mode=review&amp;id={{ (user.id ~ ':' ~ role.id)|url_encode }}">Review removal</a></td></tr>{% else %}<tr><th scope="row">{{ user.display_name }}</th><td colspan="2">No direct role assigned.</td></tr>{% endfor %}{% else %}<tr><td colspan="3">No manageable users are available.</td></tr>{% endfor %}</tbody></table></div><div class="page-actions"><a class="button" href="/administrator/business-security?section=memberships">Organization membership roles</a><a class="button" href="/administrator/access?section=assignments&amp;mode=history">Assignment history</a></div></section>
    {% endif %}

  {% elseif section == 'tokens' %}
    {% set token = selected_id ? tokens|filter(item => item.id == selected_id)|first : null %}
    {% if mode == 'create' %}
      <p><a href="/administrator/access?section=tokens">← Token catalog</a></p>
      {% if created_token %}<section class="alert token-result stack" role="status" aria-labelledby="created-token-heading"><h2 id="created-token-heading">Copy this token now</h2><p>It will never be shown again. Store it in the intended client's secret manager.</p><code>{{ created_token.token }}</code><small>Token ID: {{ created_token.token_id }}</small><a class="button" href="/administrator/access?section=tokens">I have stored the token</a></section>{% endif %}
      {% if not created_token %}<section class="panel stack" aria-labelledby="create-token-heading"><div><p class="eyebrow">Focused credential issuance</p><h2 id="create-token-heading">Create API, CLI or MCP token</h2><p>Choose the smallest capabilities, exact delivery audience and bounded expiry required by one client.</p></div>{% if capabilities['users.manage'] is defined %}<form method="post" action="/administrator/access?section=tokens&amp;mode=create" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="token.create"><label>User email<input type="email" name="token_email" required></label><label>Token name<input name="token_name" maxlength="191" required></label><label>Capabilities<small>Select only what this client must use.</small><select name="token_capabilities[]" multiple size="8" required>{% for option in available_capabilities %}<option value="{{ option.code }}">{{ option.code }} — {{ option.description }}</option>{% endfor %}</select></label><div class="form-grid"><label>Expires at <span class="text-muted">(optional)</span><input type="datetime-local" name="expires_at"></label><label>Audience<select name="audience" required><option value="kumwe-http">HTTP API</option><option value="kumwe-cli">CLI</option><option value="kumwe-mcp">MCP</option></select></label><label>Purpose<select name="purpose" required><option value="api">API</option><option value="management">CLI management</option><option value="mcp">MCP</option></select></label></div>{{ access_forms.step_up() }}<div class="page-actions"><button class="primary" type="submit">Create token and show once</button><a class="button" href="/administrator/access?section=tokens">Cancel</a></div></form>{% endif %}</section>{% endif %}
    {% elseif mode == 'review' %}
      <p><a href="/administrator/access?section=tokens">← Token catalog</a></p>{% if token %}<section class="panel stack" aria-labelledby="token-review-heading"><div><p class="eyebrow">Credential review</p><h2 id="token-review-heading">{{ token.name }}</h2><p>{{ token.subject_name }} · {{ token.subject_email }}</p></div><dl class="definition-metadata"><div><dt>Token ID</dt><dd>{% include '@kis/technical-value.twig' with {label: 'Token ID', value: token.id} only %}</dd></div><div><dt>Scope</dt><dd>{{ token.audience }} · {{ token.purpose }} · {{ token.site_identifier }}</dd></div><div><dt>Capabilities</dt><dd>{{ token.capabilities|join(', ') }}</dd></div><div><dt>Expiry</dt><dd>{{ token.expires_at|default('No expiry') }}</dd></div><div><dt>Status</dt><dd>{{ token.revoked_at ? 'Revoked' : 'Active' }}</dd></div></dl>{% if not token.revoked_at and capabilities['users.manage'] is defined %}<section class="role-card stack"><h3>Rotate token</h3><p>Rotation issues one replacement secret and revokes this token within the existing credential contract.</p><form method="post" action="/administrator/access?section=tokens&amp;mode=create" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="token.rotate"><input type="hidden" name="token_id" value="{{ token.id }}"><label>Replacement name<input name="token_name" value="{{ token.name }}" required></label><label>Replacement expiry <span class="text-muted">(optional)</span><input type="datetime-local" name="expires_at"></label>{{ access_forms.step_up() }}<button class="primary" type="submit">Rotate and show replacement once</button></form></section><section class="role-card stack"><h3>Revoke token</h3><p>Revocation is immediate and retained in credential history.</p><form method="post" action="/administrator/access?section=tokens" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="token.revoke"><input type="hidden" name="token_id" value="{{ token.id }}">{{ access_forms.step_up() }}<button class="danger" type="submit">Revoke {{ token.name }}</button></form></section>{% endif %}</section>{% else %}{% embed '@kis/empty-state.twig' with {title: 'Token unavailable', message: 'The token does not exist in this site scope or is no longer manageable.'} %}{% endembed %}{% endif %}
    {% elseif mode == 'history' %}
      <section class="panel stack"><div><p class="eyebrow">Credential audit</p><h2>Token history</h2><p>Issue, rotation, revocation and emergency actions are retained without token secrets.</p></div><a class="button primary" href="/administrator/access?section=events">Open security events</a></section>
    {% else %}
      <section class="panel stack" aria-labelledby="tokens-heading"><header class="panel-header section-heading"><div><p class="eyebrow">Non-human credentials</p><h2 id="tokens-heading">API, CLI and MCP tokens</h2><p>Only metadata is listed. Plaintext secrets exist solely in the issue or rotation response.</p></div>{% if capabilities['users.manage'] is defined %}<a class="button primary" href="/administrator/access?section=tokens&amp;mode=create">Create token</a>{% endif %}</header><div class="table-wrap" tabindex="0" role="region" aria-label="API, CLI and MCP tokens"><table><thead><tr><th scope="col">Token</th><th scope="col">User</th><th scope="col">Capabilities</th><th scope="col">Expiry</th><th scope="col">Status</th><th scope="col">Review</th></tr></thead><tbody>{% for item in tokens %}<tr><th scope="row">{{ item.name }}<br><small>{{ item.id }}</small></th><td>{{ item.subject_name }}<br><small>{{ item.subject_email }}</small></td><td><small>{{ item.capabilities|join(', ') }}<br>{{ item.audience }} · {{ item.purpose }} · {{ item.site_identifier }}</small></td><td>{{ item.expires_at|default('No expiry') }}</td><td><span class="status status-{{ item.revoked_at ? 'draft' : 'published' }}">{{ item.revoked_at ? 'Revoked' : 'Active' }}</span></td><td><a href="/administrator/access?section=tokens&amp;mode=review&amp;id={{ item.id|url_encode }}">Review token</a></td></tr>{% else %}<tr><td colspan="6">No API, CLI or MCP tokens have been issued for this site.</td></tr>{% endfor %}</tbody></table></div><div class="page-actions"><a class="button" href="/administrator/access?section=tokens&amp;mode=history">Token history</a></div></section>
    {% endif %}

  {% elseif section == 'events' %}
    {% if mode == 'review' %}
      <p><a href="/administrator/access?section=events">← Security events</a></p><section class="panel stack" aria-labelledby="step-up-enrollment-heading"><div><p class="eyebrow">Current administrator assurance</p><h2 id="step-up-enrollment-heading">Authenticator and recovery setup</h2><p>Enrollment material and recovery codes are displayed once. Later high-impact forms request verification only at their action boundary.</p></div>{% if step_up_enrollment %}<div class="alert token-result" role="status"><strong>Add this secret to your authenticator now.</strong><code>{{ step_up_enrollment.secret }}</code><small>Provisioning URI: {{ step_up_enrollment.provisioningUri }}</small><small>Expires <time datetime="{{ step_up_enrollment.expiresAt|date('c') }}">{{ step_up_enrollment.expiresAt|date('Y-m-d H:i T') }}</time></small></div><form method="post" action="/administrator/access?section=events&amp;mode=review" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="step_up.confirm"><input type="hidden" name="enrollment_id" value="{{ step_up_enrollment.enrollmentId }}"><label>Current authenticator code<input name="step_up_code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6,10}" required></label><button class="primary" type="submit">Confirm enrollment</button></form>{% else %}<form method="post" action="/administrator/access?section=events&amp;mode=review"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="step_up.begin"><button class="primary" type="submit">Begin authenticator setup</button></form>{% endif %}{% if step_up_recovery_codes is not empty %}<div class="alert token-result" role="status"><strong>Copy all recovery codes now. They cannot be retrieved again.</strong><ul>{% for code in step_up_recovery_codes %}<li><code>{{ code }}</code></li>{% endfor %}</ul></div>{% endif %}</section>
    {% else %}
      <section class="panel stack" aria-labelledby="security-events-heading"><header class="panel-header section-heading"><div><p class="eyebrow">Installation audit</p><h2 id="security-events-heading">Security events</h2><p>Recent identity, role, capability, token and step-up events. Operational metadata and all credential values are omitted.</p></div><a class="button" href="/administrator/access?section=events&amp;mode=review">Set up my verification</a></header>{% if security_events is empty %}{% embed '@kis/empty-state.twig' with {title: 'No identity security events', message: 'No identity, role, grant, token or step-up events are available in the retained audit window.'} %}{% endembed %}{% else %}<div class="table-wrap" tabindex="0" role="region" aria-label="Identity security events"><table><thead><tr><th scope="col">Time</th><th scope="col">Action</th><th scope="col">Actor</th><th scope="col">Target</th><th scope="col">Outcome</th></tr></thead><tbody>{% for event in security_events %}<tr><td>{{ event.occurred_at }}</td><th scope="row"><code>{{ event.action }}</code></th><td>{{ event.actor_id|default('System') }}</td><td>{{ event.subject_type }}{% if event.subject_id %}<br><small>{{ event.subject_id }}</small>{% endif %}</td><td><span class="status status-{{ event.outcome == 'success' ? 'published' : 'draft' }}">{{ event.outcome|title }}</span></td></tr>{% endfor %}</tbody></table></div>{% endif %}<p class="text-muted text-small">The timeline is capped at the newest 100 identity-related records; use the controlled audit export path for broader retention evidence.</p></section>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
