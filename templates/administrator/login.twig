{% extends "layout.twig" %}
{% block title %}Sign in · Kumwe{% endblock %}
{% block content %}
  <section class="panel login-card" aria-labelledby="sign-in-title">
    <header class="login-header">
      <a class="administrator-brand" href="/">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="m12 2 8.7 5v10L12 22l-8.7-5V7L12 2Zm0 3.1L6 8.5v7l6 3.4 6-3.4v-7l-6-3.4Z"/></svg></span>
        <span class="brand-copy"><strong>Kumwe</strong><span>Administrator</span></span>
      </a>
      <p>Manage content, publishing, navigation and the platform from one secure workspace.</p>
    </header>
    <form action="/administrator/login" method="post" class="stack login-form">
      <div><p class="eyebrow">Welcome back</p><h1 id="sign-in-title">Sign in</h1></div>
      {% if error is defined %}<div class="notice danger" role="alert">{{ error }}</div>{% endif %}
      <label>Email address<input type="email" name="email" value="{{ email|default('') }}" autocomplete="username" inputmode="email" required autofocus></label>
      <label>Password<input type="password" name="password" autocomplete="current-password" required></label>
      <button class="primary full" type="submit">Sign in to Kumwe</button>
    </form>
    <footer class="login-footer">Protected administrator area · Sessions and permission decisions are audited</footer>
  </section>
{% endblock %}
