{% extends "layout.twig" %}
{% block title %}{{ t('core.administrator.automation.automation_kumwe') }}{% endblock %}
{% block context_title %}{{ t('core.administrator.automation.automation') }}{% endblock %}
{% block content %}
  <div class="kis-phase-five" data-kis-surface="core.administrator.automation">
  {% include '@kis/page-header.twig' with {
    eyebrow: 'Operations',
    title: 'Automation',
    purpose: t('core.administrator.automation.schedule_registered_work_inspect_delivery_and')
  } only %}
  <nav class="kis-phase-five-section-nav" aria-label="{{ t('core.administrator.automation.automation_concerns') }}">
    <a href="#automation-schedules">{{ t('core.administrator.automation.schedules') }}</a>
    <a href="#automation-new-schedule">{{ t('core.administrator.automation.new_schedule') }}</a>
    <a href="#automation-runs">{{ t('core.administrator.automation.recent_jobs') }}</a>
  </nav>
  {% if saved %}<div class="notice success" role="status"><span>{{ t('core.administrator.automation.automation_updated') }}</span><button class="notice-dismiss" type="button" aria-label="{{ t('core.administrator.access_control.dismiss') }}" data-dismiss-notice>×</button></div>{% endif %}

  <div class="editor-grid">
    <section id="automation-schedules" class="panel kis-phase-five-card">
      <header class="panel-header"><div><h2>{{ t('core.administrator.automation.schedules') }}</h2><p>{{ t('core.administrator.automation.recurring_jobs_use_explicit_queues_timezones') }}</p></div></header>
      {% if schedules is empty %}{% include '@kis/empty-state.twig' with {title: t('core.administrator.automation.no_schedules_configured'), message: t('core.administrator.automation.create_a_schedule_when_recurring_work')} only %}{% else %}<div class="table-wrap automation-schedules" tabindex="0" role="region" aria-label="{{ t('core.administrator.automation.automation_schedules_scroll_horizontally_for_mor') }}"><table>
        <thead><tr><th scope="col">{{ t('core.administrator.access_control.name') }}</th><th scope="col">{{ t('core.administrator.automation.job') }}</th><th scope="col">{{ t('core.administrator.automation.next_run') }}</th><th scope="col">{{ t('core.administrator.access_control.status') }}</th><th scope="col"><span class="sr-only">{{ t('core.administrator.automation.actions') }}</span></th></tr></thead>
        <tbody>{% for schedule in schedules %}<tr>
          <td><span class="content-title"><strong>{{ schedule.name }}</strong><span><code>{{ schedule.cron_expression }}</code></span></span></td>
          <td><span class="content-title"><strong>{{ schedule.job_type }}</strong><span>{{ schedule.queue }}</span></span></td>
          <td><span data-visual-dynamic>{{ schedule.next_run_at ?: t('core.administrator.automation.not_scheduled') }}</span></td>
          <td><span class="status status-{{ schedule.enabled ? 'published' : 'draft' }}">{{ schedule.enabled ? 'Enabled' : 'Disabled' }}</span></td>
          <td class="actions"><form action="/administrator/automation" method="post"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="id" value="{{ schedule.id }}"><input type="hidden" name="version" value="{{ schedule.version }}"><button class="link-button" name="action" value="schedule.{{ schedule.enabled ? 'disable' : 'enable' }}">{{ schedule.enabled ? 'Disable' : 'Enable' }}</button><button class="link-button danger" name="action" value="schedule.delete" data-confirm="Delete the {{ schedule.name }} schedule?">{{ t('core.administrator.automation.delete') }}</button></form></td>
        </tr>{% endfor %}</tbody>
      </table></div>{% endif %}
    </section>

    <aside id="automation-new-schedule" class="panel panel-body stack automation-builder kis-phase-five-card">
      <div><p class="eyebrow">{{ t('core.administrator.automation.new_schedule') }}</p><h2>{{ t('core.administrator.automation.configure_recurring_work') }}</h2><p class="text-muted text-small">{{ t('core.administrator.automation.only_registered_job_types_are_available') }}</p></div>
      <form action="/administrator/automation" method="post" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="action" value="schedule.create">
        <label>{{ t('core.administrator.access_control.name') }}<input name="name" maxlength="160" required></label>
        <div class="two-column"><label>{{ t('core.administrator.automation.cron_expression') }}<input name="cron_expression" value="0 * * * *" maxlength="120" required></label><label>{{ t('core.administrator.automation.timezone') }}<input name="timezone" value="UTC" maxlength="80" required></label></div>
        <div class="two-column"><label>{{ t('core.administrator.automation.queue') }}<input name="queue" value="default" maxlength="64" required></label><label>{{ t('core.administrator.automation.first_run_utc') }}<input type="datetime-local" name="first_run" required></label></div>
        <kumwe-job-fields class="stack">
          <label>{{ t('core.administrator.automation.job_type') }}<select name="job_type" required data-job-type>{% for type in job_types %}<option value="{{ type.type }}">{{ type.label }}</option>{% endfor %}</select></label>
          {% for type in job_types %}<fieldset class="field-group stack" data-job-fields="{{ type.type }}"{% if not loop.first %} hidden{% endif %}><legend>{{ t('core.administrator.automation.settings', {label: type.label}) }}</legend>
            {% if type.fields is empty %}<p class="text-muted text-small">{{ t('core.administrator.automation.this_job_does_not_require_additional') }}</p>{% endif %}
            {% for field in type.fields %}<label>{{ field.label }}{% if field.help %}<small>{{ field.help }}</small>{% endif %}{% if field.type == 'select' %}<select name="{{ field.name }}"{% if field.required %} required{% endif %}>{% for option in field.options %}<option value="{{ option }}"{% if field.default == option %} selected{% endif %}>{{ option }}</option>{% endfor %}</select>{% elseif field.type == 'boolean' %}<select name="{{ field.name }}"{% if field.required %} required{% endif %}><option value="true"{% if field.default is same as(true) %} selected{% endif %}>{{ t('core.administrator.business_fields.yes') }}</option><option value="false"{% if field.default is same as(false) %} selected{% endif %}>{{ t('core.administrator.business_fields.no') }}</option></select>{% else %}<input type="{{ field.type == 'integer' ? 'number' : 'text' }}" name="{{ field.name }}" value="{{ field.default }}"{% if field.required %} required{% endif %}{% if field.minimum is not null %} min="{{ field.minimum }}"{% endif %}{% if field.maximum is not null %} max="{{ field.maximum }}"{% endif %}>{% endif %}</label>{% endfor %}
          </fieldset>{% endfor %}
        </kumwe-job-fields>
        <button class="primary full" type="submit">{{ t('core.administrator.automation.create_schedule') }}</button>
      </form>
    </aside>
  </div>

  <section id="automation-runs" class="panel kis-phase-five-card">
    <header class="panel-header"><div><h2>{{ t('core.administrator.automation.recent_jobs') }}</h2><p>{{ t('core.administrator.automation.delivery_attempts_and_recoverable_failures_acros') }}</p></div></header>
    <div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.automation.recent_automation_jobs_scroll_horizontally_for') }}"><table><thead><tr><th scope="col">{{ t('core.administrator.automation.job') }}</th><th scope="col">{{ t('core.administrator.access_control.status') }}</th><th scope="col">{{ t('core.administrator.automation.attempts') }}</th><th scope="col">{{ t('core.administrator.automation.available') }}</th><th scope="col"><span class="sr-only">{{ t('core.administrator.automation.actions') }}</span></th></tr></thead><tbody>
      {% for job in jobs %}<tr><td><span class="content-title"><strong>{{ job.job_type }}</strong><span>{% include '@kis/technical-value.twig' with {label: t('core.administrator.automation.job_identifier'), value: job.id, copy: true} only %} · {{ job.queue }}</span>{% if job.error_message %}<span class="text-small">{{ job.error_message }}</span>{% endif %}</span></td><td><span class="status status-{{ job.status }}">{{ job.status|title }}</span></td><td>{{ job.attempts }} / {{ job.maximum_attempts }}</td><td>{{ job.available_at }}</td><td class="actions">{% if job.status in ['dead', 'pending'] %}<form action="/administrator/automation" method="post"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="id" value="{{ job.id }}">{% if job.status == 'dead' %}<button class="link-button" name="action" value="job.retry" aria-label="{{ t('core.administrator.automation.retry_job', {job_type: job.job_type}) }}">{{ t('core.administrator.automation.retry') }}</button>{% endif %}{% if job.status == 'pending' %}<button class="link-button danger" name="action" value="job.cancel" aria-label="{{ t('core.administrator.automation.cancel_job', {job_type: job.job_type}) }}">{{ t('core.administrator.access_control.cancel') }}</button>{% endif %}</form>{% else %}<span class="text-muted">{{ t('core.administrator.automation.no_action_available') }}</span>{% endif %}</td></tr>
      {% else %}<tr><td colspan="5">{{ t('core.administrator.automation.no_jobs_recorded') }}</td></tr>{% endfor %}
    </tbody></table></div>
  </section>
  </div>
{% endblock %}
