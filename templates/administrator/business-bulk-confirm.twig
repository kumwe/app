{% extends "layout.twig" %}
{% import "_business-schema-fields.twig" as schema_fields %}

{% set selected_actions = definition.actions|filter(action => action.handle == bulk.action) %}
{% set selected_action = selected_actions is not empty ? selected_actions|first : null %}
{% set operation_label = bulk.operation == 'archive'
  ? t('core.administrator.business_bulk_confirm.archive_selected_records')
  : (bulk.operation == 'restore'
    ? t('core.administrator.business_bulk_confirm.restore_selected_records')
    : t('core.administrator.business_bulk_confirm.selected_records', {label: selected_action.label}))
%}
{% set bulk_operation_value = bulk.operation == 'action' ? 'action:' ~ bulk.action : bulk.operation %}

{% block title %}{{ t('core.administrator.business_bulk_confirm.kumwe', {operation_label: operation_label}) }}{% endblock %}
{% block context_title %}{{ operation_label }}{% endblock %}
{% block context_subtitle %}{{ t('core.administrator.business_bulk_confirm.review_every_record_and_expected_version') }}{% endblock %}

{% block content %}
  <kumwe-business-confirmation data-kis-business data-kis-component="generated-bulk-confirmation" data-kis-surface="core.administrator.generated-definition">
    <header class="page-heading">
      <div>
        <p class="eyebrow">{{ t('core.administrator.business_bulk_confirm.bulk_confirmation_required') }}</p>
        <h1 id="business-bulk-confirm-title">{{ operation_label }}</h1>
        <p>{{ t('core.administrator.business_bulk_confirm.all_records_are_applied_atomically_and', {items: (bulk.items|length)}) }}</p>
      </div>
    </header>

    {% if error_summary is defined and error_summary %}
      <section class="notice danger business-error-summary" role="alert" tabindex="-1">
        <div><h2>{{ t('core.administrator.business_bulk_confirm.the_bulk_action_input_is_invalid') }}</h2><p>{{ error_summary }}</p></div>
      </section>
    {% endif %}

    <section class="panel panel-body stack business-confirmation kis-business-confirmation{% if bulk.operation == 'action' %} danger{% endif %}"{% if bulk.operation == 'action' %} data-danger{% endif %} aria-labelledby="business-bulk-confirm-title">
      <div class="table-wrap" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_bulk_confirm.selected_records_and_expected_versions') }}">
        <table>
          <thead><tr><th scope="col">{{ t('core.administrator.business_bulk_confirm.record') }}</th><th scope="col">{{ t('core.administrator.business_bulk_confirm.expected_version') }}</th></tr></thead>
          <tbody>
            {% for item in bulk.items %}
              <tr><th scope="row"><code>{{ item.record_id }}</code></th><td>{{ item.expected_version }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <form method="post" class="stack" data-business-confirm-form>
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <input type="hidden" name="operation" value="bulk">
        <input type="hidden" name="operation_id" value="{{ operation_id }}">
        <input type="hidden" name="confirmed" value="1">
        <input type="hidden" name="bulk_operation" value="{{ bulk_operation_value }}">
        {% for item in bulk.items %}
          <input type="hidden" name="bulk_records[]" value="{{ {'record_id': item.record_id, 'expected_version': item.expected_version}|json_encode }}">
        {% endfor %}
        {% if bulk_action_fields|default([]) is not empty %}
          <fieldset class="business-schema-group">
            <legend>{{ t('core.administrator.business_bulk_confirm.input_for_every_selected_record') }}</legend>
            <p class="field-help">{{ t('core.administrator.business_bulk_confirm.the_same_validated_input_is_bound') }}</p>
            {{ schema_fields.fields(bulk_action_fields) }}
            <button
              class="button"
              type="submit"
              name="prepare_bulk_input"
              value="1"
              formnovalidate
            >{{ t('core.administrator.business_bulk_confirm.update_action_rows') }}</button>
          </fieldset>
        {% endif %}
        <label class="check business-confirm-check kis-business-confirm-check">
          <input type="checkbox" required data-business-confirm-check>
          <span>{{ t('core.administrator.business_bulk_confirm.i_reviewed_all_records_and_understand', {items: (bulk.items|length)}) }}</span>
        </label>
        <div class="page-actions">
          <button class="{% if bulk.operation == 'action' %}danger{% else %}primary{% endif %}" type="submit">{{ operation_label }}</button>
          <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}">{{ t('core.administrator.access_control.cancel') }}</a>
        </div>
      </form>
    </section>
  </kumwe-business-confirmation>
{% endblock %}
