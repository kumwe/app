{% extends "layout.twig" %}
{% block title %}Dashboard · Kumwe{% endblock %}
{% block context_title %}Dashboard{% endblock %}
{% block content %}
  <section class="panel dashboard-hero">
    <div>
      <p class="eyebrow">Your publishing workspace</p>
      <h1>Good work starts with a clear view.</h1>
      <p>See what needs attention, continue editing, and move content from an idea to the public website.</p>
      <form class="dashboard-search" action="/administrator/content" method="get" role="search"><label class="sr-only" for="dashboard-content-search">Search content</label><input id="dashboard-content-search" type="search" name="q" placeholder="Search titles and URLs"><button type="submit">Search</button></form>
      <div class="hero-actions">
        {% if capabilities['content.create'] is defined %}<a class="button primary" href="/administrator/content/new"><svg aria-hidden="true"><use href="#kumwe-icon-plus"></use></svg>Create content</a>{% endif %}
        <a class="button" href="/administrator/content">Browse all content</a>
      </div>
    </div>
    <div class="hero-progress">
      <strong>{{ published_percent }}% published</strong>
      <span>{{ counts.published }} of {{ counts.total - counts.trashed }} active items are public</span>
      <div class="progress-track" aria-hidden="true"><span style="--progress: {{ published_percent }}%"></span></div>
    </div>
  </section>

  <section class="metric-grid" aria-label="Content summary">
    <article class="panel metric-card"><span class="metric-icon"><svg aria-hidden="true"><use href="#kumwe-icon-content"></use></svg></span><span class="metric-copy"><strong class="metric-value">{{ counts.total }}</strong><span class="metric-label">Total content</span></span></article>
    <article class="panel metric-card"><span class="metric-icon info"><svg aria-hidden="true"><use href="#kumwe-icon-external"></use></svg></span><span class="metric-copy"><strong class="metric-value">{{ counts.published }}</strong><span class="metric-label">Published</span></span></article>
    <article class="panel metric-card"><span class="metric-icon warning"><svg aria-hidden="true"><use href="#kumwe-icon-automation"></use></svg></span><span class="metric-copy"><strong class="metric-value">{{ counts.review }}</strong><span class="metric-label">Awaiting review</span></span></article>
    <article class="panel metric-card"><span class="metric-icon violet"><svg aria-hidden="true"><use href="#kumwe-icon-models"></use></svg></span><span class="metric-copy"><strong class="metric-value">{{ content_types|length }}</strong><span class="metric-label">Content types</span></span></article>
  </section>

  <div class="dashboard-grid">
    <section class="panel">
      <header class="panel-header"><div><h2>Recently updated</h2><p>Continue where your team left off.</p></div><a href="/administrator/content">View all</a></header>
      {% if entries is empty %}
        <div class="panel-body"><p class="text-muted">There is no content yet. Create the first item to begin publishing.</p></div>
      {% else %}
        <div class="table-wrap" tabindex="0" role="region" aria-label="Recently updated content"><table><thead><tr><th>Content</th><th>Status</th><th>Updated</th><th><span class="sr-only">Action</span></th></tr></thead><tbody>
          {% for entry in entries %}<tr><td><span class="content-title"><strong>{{ entry.title }}</strong><span>{{ entry.public_url|default('/' ~ entry.slug) }}</span></span></td><td><span class="status status-{{ entry.deleted_at ? 'trashed' : entry.status }}">{{ entry.deleted_at ? 'Trashed' : entry.status|replace({'_': ' '})|title }}</span></td><td><time datetime="{{ entry.updated_at }}">{{ entry.updated_at|date('M j, H:i') }}</time></td><td class="actions">{% if not entry.deleted_at and capabilities['content.update'] is defined %}<a href="/administrator/content/{{ entry.id }}/edit">Edit</a>{% endif %}</td></tr>{% endfor %}
        </tbody></table></div>
      {% endif %}
    </section>
    <aside class="panel">
      <header class="panel-header"><div><h2>Quick actions</h2><p>Common site-management tasks.</p></div></header>
      <div class="panel-body quick-actions">
        {% for item in administrator_navigation %}
          {% if item.id in ['create-content', 'media', 'navigation', 'models', 'access', 'settings'] %}<a class="quick-action" href="{{ item.href }}"><svg aria-hidden="true"><use href="#kumwe-icon-{{ item.icon }}"></use></svg><span><strong>{{ item.label }}</strong><span>{{ item.description }}</span></span></a>{% endif %}
        {% endfor %}
      </div>
    </aside>
  </div>
{% endblock %}
