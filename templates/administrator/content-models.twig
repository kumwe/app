{% extends "layout.twig" %}
{% block title %}{{ t('core.administrator.content_models.content_models_kumwe') }}{% endblock %}
{% block context_title %}{{ t('core.administrator.content_models.content_models') }}{% endblock %}
{% block content %}
  <div class="kis-phase-five" data-kis-surface="core.administrator.content-models">
    {% embed '@kis/page-header.twig' with {
      eyebrow: 'Structure',
      title: t('core.administrator.content_models.content_models'),
      purpose: t('core.administrator.content_models.define_the_fields_people_complete_and')
    } only %}
      {% block actions %}<div class="page-actions"><a class="button" href="/administrator/content/new">{{ t('core.administrator.content_form.create_content') }}</a></div>{% endblock %}
    {% endembed %}

  <div class="notice" role="status"><span><strong>{{ t('core.administrator.content_models.versioned_by_design') }}</strong> {{ t('core.administrator.content_models.publishing_a_model_creates_an_immutable') }}</span><button class="notice-dismiss" type="button" aria-label="{{ t('core.administrator.business_definitions.dismiss_notice') }}" data-dismiss-notice>×</button></div>

  {% embed '@kis/master-detail.twig' with {
    id: 'content-model-workspace',
    catalog_label: t('core.administrator.content_models.content_model_catalog'),
    catalog_toggle_label: t('core.administrator.content_models.browse_content_models'),
    content_types: content_types,
    workflows: workflows,
    capabilities: capabilities,
    csrf: csrf
  } only %}
    {% block catalog %}
      <div class="kis-phase-five-catalog">
        <div><p class="eyebrow">{{ t('core.administrator.business_report.catalog') }}</p><h2>{{ t('core.administrator.content_models.models_and_workflows') }}</h2><p class="field-help">{{ t('core.administrator.content_models.choose_a_stable_concern_editors_remain') }}</p></div>
        <nav aria-label="{{ t('core.administrator.content_models.content_models_and_workflows') }}">
          <h3>{{ t('core.administrator.content_models.content_types') }}</h3>
          <ul>{% for type in content_types %}<li><a href="#content-type-{{ type.handle }}"><strong>{{ type.name }}</strong><small>{{ t('core.administrator.content_models.version', {handle: type.handle, version: type.version}) }}</small></a></li>{% endfor %}</ul>
          <h3>{{ t('core.administrator.content_models.workflows') }}</h3>
          <ul>{% for workflow in workflows %}<li><a href="#workflow-{{ workflow.handle }}"><strong>{{ workflow.name }}</strong><small>{{ t('core.administrator.content_models.version', {handle: workflow.handle, version: workflow.version}) }}</small></a></li>{% endfor %}</ul>
          {% if capabilities['content.update'] is defined %}<ul><li><a href="#create-content-type"><strong>{{ t('core.administrator.content_models.create_content_type') }}</strong><small>{{ t('core.administrator.content_models.build_a_reusable_authoring_form') }}</small></a></li><li><a href="#create-workflow"><strong>{{ t('core.administrator.content_models.create_workflow') }}</strong><small>{{ t('core.administrator.content_models.define_publication_states') }}</small></a></li></ul>{% endif %}
        </nav>
      </div>
    {% endblock %}
    {% block detail %}
  <section class="model-layout kis-phase-five-dual-workspace">
    <div id="content-type-catalog" class="stack kis-phase-five-card">
      <div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.content_form.authoring') }}</p><h2>{{ t('core.administrator.content_models.content_types') }}</h2><p class="field-help">{{ t('core.administrator.content_models.choose_a_type_to_inspect_or') }}</p></div><span class="count-badge">{{ content_types|length }}</span></div>
      {% for type in content_types %}
        <details id="content-type-{{ type.handle }}" class="panel model-card kis-phase-five-card">
          <summary><span><strong>{{ type.name }}</strong><br><span>{{ t('core.administrator.content_models.version', {handle: type.handle, version: type.version}) }}</span></span></summary>
          {% if capabilities['content.update'] is defined %}
            <form method="post" class="stack">
              <input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="kind" value="content_type"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="{{ type.id }}"><input type="hidden" name="version" value="{{ type.version }}"><input type="hidden" name="schema_mode" value="builder">
              <div class="two-column"><label>{{ t('core.administrator.access_control.name') }}<input name="name" value="{{ type.name }}" required></label><label>{{ t('core.administrator.business_definitions.workflow') }}<select name="workflow">{% for workflow in workflows %}<option value="{{ workflow.id }}"{% if workflow.id == type.workflow_id %} selected{% endif %}>{{ workflow.name }} · v{{ workflow.version }}</option>{% endfor %}</select></label></div>
              <kumwe-field-builder class="stack">
                <div class="section-heading"><div><h3>{{ t('core.administrator.content_models.authoring_fields') }}</h3><p class="field-help">{{ t('core.administrator.content_models.each_row_becomes_a_graphical_field') }}</p></div><button type="button" data-add-field>{{ t('core.administrator.business_definitions.add_field') }}</button></div>
                <div data-field-rows>
                  {% for field in type.builder_fields %}
                    <div class="builder-row" data-field-row>
                      <label>{{ t('core.administrator.business_fields.key') }}<input name="field_{{ loop.index0 }}_key" value="{{ field.key }}" pattern="[a-z][a-z0-9_]*" required></label>
                      <label>{{ t('core.administrator.business_definitions.label') }}<input name="field_{{ loop.index0 }}_title" value="{{ field.title }}" required></label>
                      <label>{{ t('core.administrator.content_models.field_type') }}<select name="field_{{ loop.index0 }}_type">{% for option, label in {'string':t('core.administrator.content_models.short_text'),'text':t('core.administrator.content_models.long_text'),'integer':t('core.administrator.content_models.whole_number'),'number':'Number','boolean':t('core.administrator.content_models.yes_no'),'date':'Date','date-time':t('core.administrator.content_models.date_and_time'),'email':t('core.administrator.access_control.email_address'),'url':t('core.administrator.content_models.web_address'),'media':t('core.administrator.content_models.media_url'),'string-list':t('core.administrator.content_models.list_of_text')} %}<option value="{{ option }}"{% if field.type == option %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
                      <button class="remove-row" type="button" data-remove-field aria-label="{{ t('core.administrator.content_models.remove', {title: field.title}) }}">{{ t('core.administrator.business_definitions.remove') }}</button>
                      <div class="builder-options"><label>{{ t('core.administrator.business_definitions.description') }}<input name="field_{{ loop.index0 }}_description" value="{{ field.description }}"></label><label>{{ t('core.administrator.business_definitions.minimum') }}<input type="number" name="field_{{ loop.index0 }}_minimum" value="{{ field.minimum }}"></label><label>{{ t('core.administrator.business_definitions.maximum') }}<input type="number" name="field_{{ loop.index0 }}_maximum" value="{{ field.maximum }}"></label><label>{{ t('core.administrator.content_models.choices') }}<small>{{ t('core.administrator.content_models.one_choice_per_line_optional') }}</small><textarea name="field_{{ loop.index0 }}_options" rows="3">{{ field.options }}</textarea></label><label class="check"><input type="checkbox" name="field_{{ loop.index0 }}_required" value="1"{% if field.required %} checked{% endif %}><span>{{ t('core.administrator.content_models.required_field') }}</span></label></div>
                    </div>
                  {% endfor %}
                </div>
                <template data-field-template><div class="builder-row" data-field-row><label>{{ t('core.administrator.business_fields.key') }}<input name="field___INDEX___key" pattern="[a-z][a-z0-9_]*" required></label><label>{{ t('core.administrator.business_definitions.label') }}<input name="field___INDEX___title" required></label><label>{{ t('core.administrator.content_models.field_type') }}<select name="field___INDEX___type"><option value="string">{{ t('core.administrator.content_models.short_text') }}</option><option value="text">{{ t('core.administrator.content_models.long_text') }}</option><option value="integer">{{ t('core.administrator.content_models.whole_number') }}</option><option value="number">{{ t('core.administrator.content_models.number') }}</option><option value="boolean">{{ t('core.administrator.content_models.yes_no') }}</option><option value="date">{{ t('core.administrator.content_models.date') }}</option><option value="date-time">{{ t('core.administrator.content_models.date_and_time') }}</option><option value="email">{{ t('core.administrator.access_control.email_address') }}</option><option value="url">{{ t('core.administrator.content_models.web_address') }}</option><option value="media">{{ t('core.administrator.content_models.media_url') }}</option><option value="string-list">{{ t('core.administrator.content_models.list_of_text') }}</option></select></label><button class="remove-row" type="button" data-remove-field>{{ t('core.administrator.business_definitions.remove') }}</button><div class="builder-options"><label>{{ t('core.administrator.business_definitions.description') }}<input name="field___INDEX___description"></label><label>{{ t('core.administrator.business_definitions.minimum') }}<input type="number" name="field___INDEX___minimum"></label><label>{{ t('core.administrator.business_definitions.maximum') }}<input type="number" name="field___INDEX___maximum"></label><label>{{ t('core.administrator.content_models.choices') }}<textarea name="field___INDEX___options" rows="3"></textarea></label><label class="check"><input type="checkbox" name="field___INDEX___required" value="1"><span>{{ t('core.administrator.content_models.required_field') }}</span></label></div></div></template>
                <noscript><p class="notice warning">{{ t('core.administrator.content_models.javascript_is_off_you_can_edit') }}</p></noscript>
              </kumwe-field-builder>
              <label class="check"><input type="checkbox" name="allow_breaking" value="1"><span>{{ t('core.administrator.content_models.publish_an_explicitly_breaking_version') }}<small>{{ t('core.administrator.content_models.use_only_after_reviewing_existing_content') }}</small></span></label>
              <details class="advanced-definition"><summary>{{ t('core.administrator.content_models.inspect_generated_json_schema') }}</summary><pre>{{ type.schema_json }}</pre></details>
              <button class="primary" type="submit">{{ t('core.administrator.content_models.publish_version', {value: (type.version + 1)}) }}</button>
            </form>
          {% else %}<div class="model-details"><details class="advanced-definition"><summary>{{ t('core.administrator.content_models.inspect_definition') }}</summary><pre>{{ type.schema_json }}</pre></details></div>{% endif %}
        </details>
      {% endfor %}

      {% if capabilities['content.update'] is defined %}
        <details id="create-content-type" class="panel model-card kis-phase-five-card" open>
          <summary><span><strong>{{ t('core.administrator.content_models.create_a_content_type') }}</strong><br><span>{{ t('core.administrator.content_models.build_a_reusable_authoring_form') }}</span></span></summary>
          <form method="post" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="kind" value="content_type"><input type="hidden" name="action" value="create"><input type="hidden" name="schema_mode" value="builder">
            <div class="two-column"><label>{{ t('core.administrator.business_definitions.handle') }}<input name="handle" placeholder="article" pattern="[a-z][a-z0-9_-]*" required></label><label>{{ t('core.administrator.access_control.name') }}<input name="name" placeholder="{{ t('core.administrator.content_models.article') }}" required></label></div>
            <label>{{ t('core.administrator.business_definitions.workflow') }}<select name="workflow">{% for workflow in workflows %}<option value="{{ workflow.id }}">{{ workflow.name }} · v{{ workflow.version }}</option>{% endfor %}</select></label>
            <kumwe-field-builder class="stack"><div class="section-heading"><div><h3>{{ t('core.administrator.content_models.authoring_fields') }}</h3><p class="field-help">{{ t('core.administrator.content_models.start_with_the_main_body_and') }}</p></div><button type="button" data-add-field>{{ t('core.administrator.business_definitions.add_field') }}</button></div><div data-field-rows>
              <div class="builder-row" data-field-row><label>{{ t('core.administrator.business_fields.key') }}<input name="field_0_key" value="body" required></label><label>{{ t('core.administrator.business_definitions.label') }}<input name="field_0_title" value="Body" required></label><label>{{ t('core.administrator.content_models.field_type') }}<select name="field_0_type"><option value="text">{{ t('core.administrator.content_models.long_text') }}</option><option value="string">{{ t('core.administrator.content_models.short_text') }}</option></select></label><button class="remove-row" type="button" data-remove-field>{{ t('core.administrator.business_definitions.remove') }}</button><div class="builder-options"><label>{{ t('core.administrator.business_definitions.description') }}<input name="field_0_description" value="The main content shown on the page."></label><label>{{ t('core.administrator.business_definitions.minimum') }}<input type="number" name="field_0_minimum"></label><label>{{ t('core.administrator.business_definitions.maximum') }}<input type="number" name="field_0_maximum" value="50000"></label><label>{{ t('core.administrator.content_models.choices') }}<textarea name="field_0_options" rows="3"></textarea></label><label class="check"><input type="checkbox" name="field_0_required" value="1" checked><span>{{ t('core.administrator.content_models.required_field') }}</span></label></div></div>
            </div><template data-field-template><div class="builder-row" data-field-row><label>{{ t('core.administrator.business_fields.key') }}<input name="field___INDEX___key" pattern="[a-z][a-z0-9_]*" required></label><label>{{ t('core.administrator.business_definitions.label') }}<input name="field___INDEX___title" required></label><label>{{ t('core.administrator.content_models.field_type') }}<select name="field___INDEX___type"><option value="string">{{ t('core.administrator.content_models.short_text') }}</option><option value="text">{{ t('core.administrator.content_models.long_text') }}</option><option value="integer">{{ t('core.administrator.content_models.whole_number') }}</option><option value="number">{{ t('core.administrator.content_models.number') }}</option><option value="boolean">{{ t('core.administrator.content_models.yes_no') }}</option><option value="date">{{ t('core.administrator.content_models.date') }}</option><option value="date-time">{{ t('core.administrator.content_models.date_and_time') }}</option><option value="email">{{ t('core.administrator.access_control.email_address') }}</option><option value="url">{{ t('core.administrator.content_models.web_address') }}</option><option value="media">{{ t('core.administrator.content_models.media_url') }}</option><option value="string-list">{{ t('core.administrator.content_models.list_of_text') }}</option></select></label><button class="remove-row" type="button" data-remove-field>{{ t('core.administrator.business_definitions.remove') }}</button><div class="builder-options"><label>{{ t('core.administrator.business_definitions.description') }}<input name="field___INDEX___description"></label><label>{{ t('core.administrator.business_definitions.minimum') }}<input type="number" name="field___INDEX___minimum"></label><label>{{ t('core.administrator.business_definitions.maximum') }}<input type="number" name="field___INDEX___maximum"></label><label>{{ t('core.administrator.content_models.choices') }}<textarea name="field___INDEX___options" rows="3"></textarea></label><label class="check"><input type="checkbox" name="field___INDEX___required" value="1"><span>{{ t('core.administrator.content_models.required_field') }}</span></label></div></div></template></kumwe-field-builder>
            <button class="primary" type="submit">{{ t('core.administrator.content_models.create_content_type') }}</button>
          </form>
        </details>
      {% endif %}
    </div>

    <div id="workflow-catalog" class="stack kis-phase-five-card">
      <div class="section-heading"><div><p class="eyebrow">{{ t('core.administrator.content_models.publishing') }}</p><h2>{{ t('core.administrator.content_models.workflows') }}</h2><p class="field-help">{{ t('core.administrator.content_models.choose_a_workflow_to_inspect_states') }}</p></div><span class="count-badge">{{ workflows|length }}</span></div>
      {% for workflow in workflows %}
        <details id="workflow-{{ workflow.handle }}" class="panel model-card kis-phase-five-card">
          <summary><span><strong>{{ workflow.name }}</strong><br><span>{{ t('core.administrator.content_models.version', {handle: workflow.handle, version: workflow.version}) }}</span></span></summary>
          {% if capabilities['content.update'] is defined %}
            <form method="post" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="kind" value="workflow"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="{{ workflow.id }}"><input type="hidden" name="version" value="{{ workflow.version }}"><input type="hidden" name="workflow_mode" value="builder"><label>{{ t('core.administrator.access_control.name') }}<input name="name" value="{{ workflow.name }}" required></label>
              <kumwe-workflow-builder class="stack">
                <div class="section-heading"><h3>{{ t('core.administrator.business_definitions.states') }}</h3><button type="button" data-add-workflow-row="state">{{ t('core.administrator.content_models.add_state') }}</button></div>
                <div class="stack-compact" data-state-rows>{% for state in workflow.states %}<div class="builder-row builder-row-expanded" data-workflow-row><label>{{ t('core.administrator.business_fields.key') }}<input name="state_{{ loop.index0 }}_key" value="{{ state.key }}" pattern="[a-z][a-z0-9_-]*" required></label><label>{{ t('core.administrator.access_control.name') }}<input name="state_{{ loop.index0 }}_name" value="{{ state.name }}" required></label><label class="check"><input type="radio" name="initial_state_key" value="{{ state.key }}"{% if state.initial %} checked{% endif %}><span>{{ t('core.administrator.content_models.initial') }}</span></label><label class="check"><input type="checkbox" name="state_{{ loop.index0 }}_public" value="1"{% if state.public %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.public') }}</span></label><button class="remove-row" type="button" data-remove-workflow-row>{{ t('core.administrator.business_definitions.remove') }}</button></div>{% endfor %}</div>
                <template data-state-template><div class="builder-row builder-row-expanded" data-workflow-row><label>{{ t('core.administrator.business_fields.key') }}<input name="state___INDEX___key" pattern="[a-z][a-z0-9_-]*" required></label><label>{{ t('core.administrator.access_control.name') }}<input name="state___INDEX___name" required></label><label class="check"><input type="radio" name="initial_state_key" value=""><span>{{ t('core.administrator.content_models.initial') }}</span></label><label class="check"><input type="checkbox" name="state___INDEX___public" value="1"><span>{{ t('core.administrator.business_definitions.public') }}</span></label><button class="remove-row" type="button" data-remove-workflow-row>{{ t('core.administrator.business_definitions.remove') }}</button></div></template>
                <div class="section-heading"><h3>{{ t('core.administrator.business_definitions.transitions') }}</h3><button type="button" data-add-workflow-row="transition">{{ t('core.administrator.business_definitions.add_transition') }}</button></div>
                <div class="stack-compact" data-transition-rows>{% for transition in workflow.transitions %}<div class="builder-row builder-row-expanded" data-workflow-row><label>{{ t('core.administrator.business_definitions.from') }}<input name="transition_{{ loop.index0 }}_from" value="{{ transition.from }}" required></label><label>{{ t('core.administrator.business_definitions.to') }}<input name="transition_{{ loop.index0 }}_to" value="{{ transition.to }}" required></label><label>{{ t('core.administrator.content_models.required_permission') }}<select name="transition_{{ loop.index0 }}_capability">{% for permission in ['content.update','content.submit','content.review','content.publish','content.unpublish','content.archive','content.restore'] %}<option value="{{ permission }}"{% if permission == transition.required_capability %} selected{% endif %}>{{ permission }}</option>{% endfor %}</select></label><button class="remove-row" type="button" data-remove-workflow-row>{{ t('core.administrator.business_definitions.remove') }}</button></div>{% endfor %}</div>
                <template data-transition-template><div class="builder-row builder-row-expanded" data-workflow-row><label>{{ t('core.administrator.business_definitions.from') }}<input name="transition___INDEX___from" required></label><label>{{ t('core.administrator.business_definitions.to') }}<input name="transition___INDEX___to" required></label><label>{{ t('core.administrator.content_models.required_permission') }}<select name="transition___INDEX___capability"><option value="content.update">content.update</option><option value="content.submit">content.submit</option><option value="content.review">content.review</option><option value="content.publish">content.publish</option><option value="content.unpublish">content.unpublish</option><option value="content.archive">content.archive</option><option value="content.restore">content.restore</option></select></label><button class="remove-row" type="button" data-remove-workflow-row>{{ t('core.administrator.business_definitions.remove') }}</button></div></template>
              </kumwe-workflow-builder>
              <label class="check"><input type="checkbox" name="allow_breaking" value="1"><span>{{ t('core.administrator.content_models.publish_an_explicitly_breaking_version') }}</span></label>
              <details class="advanced-definition"><summary>{{ t('core.administrator.content_models.inspect_generated_workflow_definition') }}</summary><pre>{{ workflow.states_json }}

{{ workflow.transitions_json }}</pre></details>
              <button class="primary" type="submit">{{ t('core.administrator.content_models.publish_version', {value: (workflow.version + 1)}) }}</button>
            </form>
          {% else %}<div class="model-details"><details class="advanced-definition"><summary>{{ t('core.administrator.content_models.inspect_definition') }}</summary><pre>{{ workflow.states_json }}

{{ workflow.transitions_json }}</pre></details></div>{% endif %}
        </details>
      {% endfor %}

      {% if capabilities['content.update'] is defined %}
        <details id="create-workflow" class="panel model-card kis-phase-five-card"><summary><span><strong>{{ t('core.administrator.content_models.create_a_workflow') }}</strong><br><span>{{ t('core.administrator.content_models.define_review_and_publication_states') }}</span></span></summary>
          <form method="post" class="stack"><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="kind" value="workflow"><input type="hidden" name="action" value="create"><input type="hidden" name="workflow_mode" value="builder"><div class="two-column"><label>{{ t('core.administrator.business_definitions.handle') }}<input name="handle" placeholder="editorial" pattern="[a-z][a-z0-9_-]*" required></label><label>{{ t('core.administrator.access_control.name') }}<input name="name" placeholder="{{ t('core.administrator.content_models.editorial') }}" required></label></div>
            <kumwe-workflow-builder class="stack"><div class="section-heading"><h3>{{ t('core.administrator.business_definitions.states') }}</h3><button type="button" data-add-workflow-row="state">{{ t('core.administrator.content_models.add_state') }}</button></div><div class="stack-compact" data-state-rows>
              {% for key, name in {'draft':'Draft','review':'Review','published':'Published'} %}{% set index = loop.index0 %}<div class="builder-row builder-row-expanded" data-workflow-row><label>{{ t('core.administrator.business_fields.key') }}<input name="state_{{ index }}_key" value="{{ key }}" required></label><label>{{ t('core.administrator.access_control.name') }}<input name="state_{{ index }}_name" value="{{ name }}" required></label><label class="check"><input type="radio" name="initial_state_key" value="{{ key }}"{% if key == 'draft' %} checked{% endif %}><span>{{ t('core.administrator.content_models.initial') }}</span></label><label class="check"><input type="checkbox" name="state_{{ index }}_public" value="1"{% if key == 'published' %} checked{% endif %}><span>{{ t('core.administrator.business_definitions.public') }}</span></label><button class="remove-row" type="button" data-remove-workflow-row>{{ t('core.administrator.business_definitions.remove') }}</button></div>{% endfor %}
            </div><template data-state-template><div class="builder-row builder-row-expanded" data-workflow-row><label>{{ t('core.administrator.business_fields.key') }}<input name="state___INDEX___key" required></label><label>{{ t('core.administrator.access_control.name') }}<input name="state___INDEX___name" required></label><label class="check"><input type="radio" name="initial_state_key"><span>{{ t('core.administrator.content_models.initial') }}</span></label><label class="check"><input type="checkbox" name="state___INDEX___public" value="1"><span>{{ t('core.administrator.business_definitions.public') }}</span></label><button class="remove-row" type="button" data-remove-workflow-row>{{ t('core.administrator.business_definitions.remove') }}</button></div></template>
            <div class="section-heading"><h3>{{ t('core.administrator.business_definitions.transitions') }}</h3><button type="button" data-add-workflow-row="transition">{{ t('core.administrator.business_definitions.add_transition') }}</button></div><div class="stack-compact" data-transition-rows>
              {% set defaults = [{'from':'draft','to':'review','capability':'content.submit'},{'from':'review','to':'draft','capability':'content.review'},{'from':'review','to':'published','capability':'content.publish'},{'from':'published','to':'draft','capability':'content.unpublish'}] %}{% for transition in defaults %}<div class="builder-row builder-row-expanded" data-workflow-row><label>{{ t('core.administrator.business_definitions.from') }}<input name="transition_{{ loop.index0 }}_from" value="{{ transition.from }}" required></label><label>{{ t('core.administrator.business_definitions.to') }}<input name="transition_{{ loop.index0 }}_to" value="{{ transition.to }}" required></label><label>{{ t('core.administrator.content_models.required_permission') }}<input name="transition_{{ loop.index0 }}_capability" value="{{ transition.capability }}" required></label><button class="remove-row" type="button" data-remove-workflow-row>{{ t('core.administrator.business_definitions.remove') }}</button></div>{% endfor %}
            </div><template data-transition-template><div class="builder-row builder-row-expanded" data-workflow-row><label>{{ t('core.administrator.business_definitions.from') }}<input name="transition___INDEX___from" required></label><label>{{ t('core.administrator.business_definitions.to') }}<input name="transition___INDEX___to" required></label><label>{{ t('core.administrator.content_models.required_permission') }}<select name="transition___INDEX___capability"><option value="content.update">content.update</option><option value="content.submit">content.submit</option><option value="content.review">content.review</option><option value="content.publish">content.publish</option><option value="content.unpublish">content.unpublish</option><option value="content.archive">content.archive</option><option value="content.restore">content.restore</option></select></label><button class="remove-row" type="button" data-remove-workflow-row>{{ t('core.administrator.business_definitions.remove') }}</button></div></template></kumwe-workflow-builder>
            <button class="primary" type="submit">{{ t('core.administrator.content_models.create_workflow') }}</button>
          </form>
        </details>
      {% endif %}
    </div>
  </section>
    {% endblock %}
  {% endembed %}
  </div>
{% endblock %}
