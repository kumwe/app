{% extends "layout.twig" %}
{% import "_business-schema-fields.twig" as schema_fields %}

{% set operation_labels = {
  'archive': t('core.administrator.business_confirm.archive_record'),
  'delete': t('core.administrator.business_confirm.delete_record'),
  'restore': t('core.administrator.business_confirm.restore_record'),
  'action': t('core.administrator.business_confirm.confirm_business_action')
} %}
{% set selected_actions = definition.actions|filter(action => action.handle == action_handle) %}
{% set operation_label = confirmation == 'action' and selected_actions is not empty
  ? (selected_actions|first).label
  : operation_labels[confirmation]
%}
{% set operation_allowed =
  (confirmation == 'archive' and available_operations.archive is defined)
  or (confirmation == 'delete' and available_operations.delete is defined)
  or (confirmation == 'restore' and available_operations.restore is defined)
  or (confirmation == 'action' and available_operations.action is defined and selected_actions is not empty)
%}

{% block title %}{{ t('core.administrator.business_bulk_confirm.kumwe', {operation_label: operation_label}) }}{% endblock %}
{% block context_title %}{{ operation_label }}{% endblock %}
{% block context_subtitle %}{{ t('core.administrator.business_confirm.review_before_applying_this_operation') }}{% endblock %}

{% block content %}
  <kumwe-business-confirmation data-kis-business data-kis-component="generated-operation-confirmation" data-kis-surface="core.administrator.generated-record">
    <header class="page-heading">
      <div>
        <p class="eyebrow">{{ t('core.administrator.business_confirm.confirmation_required') }}</p>
        <h1 id="business-confirm-title">{{ operation_label }}</h1>
        <p>{{ t('core.administrator.business_confirm.review_the_exact_record_and_version') }}</p>
      </div>
    </header>

    <section class="panel panel-body stack business-confirmation kis-business-confirmation{% if confirmation in ['delete', 'action'] %} danger{% endif %}"{% if confirmation in ['delete', 'action'] %} data-danger{% endif %} aria-labelledby="business-confirm-title">
      {% if error_summary is defined and error_summary %}<div class="notice error" role="alert"><h2>{{ t('core.administrator.business_confirm.action_could_not_be_completed') }}</h2><p>{{ error_summary }}</p></div>{% endif %}
      {% if approval_requested|default(false) and approval_request_id|default(null) %}
        <div class="notice success" role="status">
          <div>
            <strong>{{ t('core.administrator.business_confirm.approval_requested') }}</strong>
            {{ t_html('core.administrator.business_confirm.request_must_be_approved', {id: approval_request_id}) }}
            <a href="/administrator/business-security#approval-heading">{{ t('core.administrator.business_confirm.open_the_approval_inbox') }}</a>.
          </div>
        </div>
      {% endif %}
      <dl class="business-record-metadata">
        <div><dt>{{ t('core.administrator.business_confirm.record_type') }}</dt><dd>{{ definition.singular_label }}</dd></div>
        <div><dt>{{ t('core.administrator.business_confirm.record_id') }}</dt><dd><code>{{ record.record_id }}</code></dd></div>
        <div><dt>{{ t('core.administrator.business_bulk_confirm.expected_version') }}</dt><dd>{{ record.version }}</dd></div>
        {% if confirmation == 'action' %}<div><dt>{{ t('core.administrator.access_control.action') }}</dt><dd><code>{{ action_handle }}</code></dd></div>{% endif %}
      </dl>

      {% if operation_allowed %}
        <p>
          {% if confirmation == 'delete' %}
            {{ t('core.administrator.business_confirm.deleting_may_remove_this_record_from') }}
          {% elseif confirmation == 'archive' %}
            {{ t('core.administrator.business_confirm.archiving_removes_this_record_from_active') }}
          {% elseif confirmation == 'restore' %}
            {{ t('core.administrator.business_confirm.restoring_returns_this_record_to_the') }}
          {% else %}
            {{ t('core.administrator.business_confirm.this_action_may_change_workflow_state') }}
          {% endif %}
        </p>
        <form method="post" class="stack" data-business-confirm-form>
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          {% if confirmation != 'action' %}<input type="hidden" name="operation" value="{{ confirmation }}">{% endif %}
          <input type="hidden" name="operation_id" value="{{ operation_id }}">
          <input type="hidden" name="expected_version" value="{{ record.version }}">
          <input type="hidden" name="confirmed" value="1">
          {% if confirmation == 'action' %}
            <input type="hidden" name="action" value="{{ action_handle }}">
            {% if approval_request %}<input type="hidden" name="approval" value="1">{% endif %}
            {{ schema_fields.fields(action_fields) }}
            {% if action_high_impact and not approval_request %}
              <label for="business-approval-request-id">{{ t('core.administrator.business_confirm.approved_request_id') }}
                <input
                  id="business-approval-request-id"
                  type="text"
                  name="approval_request_id"
                  value="{{ approval_request_id|default('') }}"
                  pattern="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}"
                  maxlength="36"
                  autocomplete="off"
                  required
                >
                <small>{{ t('core.administrator.business_confirm.use_the_exact_approved_request_bound') }}</small>
              </label>
              <fieldset class="stack business-step-up">
                <legend>{{ t('core.administrator.business_confirm.fresh_requester_verification') }}</legend>
                <p>
                  {{ t('core.administrator.business_confirm.confirm_your_identity_again_the_one') }}
                </p>
                <label class="check" for="business-verification-totp">
                  <input
                    id="business-verification-totp"
                    type="radio"
                    name="verification_method"
                    value="totp"
                    checked
                  >
                  <span>{{ t('core.administrator.access_control.authenticator_code') }}</span>
                </label>
                <label class="check" for="business-verification-recovery">
                  <input
                    id="business-verification-recovery"
                    type="radio"
                    name="verification_method"
                    value="recovery"
                  >
                  <span>{{ t('core.administrator.access_control.recovery_code') }}</span>
                </label>
                <label for="business-verification">{{ t('core.administrator.business_confirm.verification_code') }}
                  <input
                    id="business-verification"
                    type="text"
                    name="verification"
                    minlength="6"
                    maxlength="71"
                    autocomplete="one-time-code"
                    required
                  >
                </label>
              </fieldset>
            {% endif %}
          {% endif %}
          <label class="check business-confirm-check">
            <input type="checkbox" required data-business-confirm-check>
            <span>{{ t('core.administrator.business_confirm.i_have_reviewed_record_at_version', {record_id: record.record_id, version: record.version}) }}</span>
          </label>
          <div class="page-actions">
            <button
              class="{% if confirmation in ['delete', 'action'] %}danger{% else %}primary{% endif %}"
              type="submit"
              {% if confirmation == 'action' %}name="operation" value="{{ approval_request ? 'approval' : 'action' }}"{% endif %}
            >
              {{ operation_label }}
            </button>
            {% if confirmation == 'action' and action_fields is not empty %}
              <button type="submit" name="operation" value="action_prepare" formnovalidate>{{ t('core.administrator.business_confirm.update_rows') }}</button>
            {% endif %}
            <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}/{{ record.record_id|url_encode }}">{{ t('core.administrator.access_control.cancel') }}</a>
          </div>
        </form>
      {% else %}
        <div class="notice warning" role="alert">{{ t('core.administrator.business_confirm.this_operation_is_no_longer_available') }}</div>
        <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}/{{ record.record_id|url_encode }}">{{ t('core.administrator.business_confirm.return_to_record') }}</a>
      {% endif %}
    </section>
  </kumwe-business-confirmation>
{% endblock %}
