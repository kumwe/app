{% extends "layout.twig" %}
{% set record_path = business_base_path ~ '/' ~ (definition.handle|url_encode)
  ~ '/' ~ (record.record_id|url_encode) %}

{% block title %}{{ document.title }} · Kumwe{% endblock %}
{% block context_title %}{{ document.title }}{% endblock %}
{% block context_subtitle %}Generated business document{% endblock %}

{% block content %}
  <kumwe-business-surface data-kis-business data-kis-component="generated-document" data-kis-surface="core.administrator.generated-record" data-record-task="{{ record_task }}">
    <header class="page-heading kis-business-document-chrome">
      <div>
        <p class="eyebrow">{{ definition.plural_label }}</p>
        <h1>{{ document.title }}</h1>
      </div>
      <div class="page-actions">
        <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}">Back to list</a>
        {% if available_operations.update is defined and record.deleted_at is null %}<a class="button primary" href="{{ record_path }}?edit=1">Edit</a>{% endif %}
      </div>
    </header>

    {% if completed_operation_id %}
      <div class="notice success kis-business-document-chrome" role="status">
        The operation completed.{% if available_operations.status is defined %} <a href="{{ business_base_path }}/operations/{{ completed_operation_id|url_encode }}">View operation status</a>.{% endif %}
      </div>
    {% endif %}

    {% set record_tasks = [
      {id: 'summary', label: 'Summary', href: record_path ~ '?task=summary'},
      {id: 'relations', label: 'Relations', href: record_path ~ '?task=relations', count: definition.relationships|length},
      {id: 'actions', label: 'Actions', href: record_path ~ '?task=actions', count: definition.actions|length}
    ] %}
    {% if available_operations.history is defined %}
      {% set record_tasks = record_tasks|merge([{id: 'history', label: 'History', href: record_path ~ '?task=history'}]) %}
    {% endif %}
    <div class="kis-business-record-tabs kis-business-document-chrome">
      {% include '@kis/task-navigation.twig' with {label: 'Record tasks', tasks: record_tasks, active: record_task} only %}
    </div>

    <article class="panel panel-body kis-business-document" aria-label="{{ document.title }}">
      <header class="kis-business-document-head">
        <div>
          <p class="kis-business-document-kind">{{ definition.singular_label }}</p>
          <p class="kis-business-document-number">{{ document.identity ?: document.title }}</p>
        </div>
        <p class="kis-business-document-state">
          {{ record.deleted_at ? 'Deleted' : (record.archived_at ? 'Archived' : record.workflow_state|default('Active'))|replace({'_': ' '})|title }}
        </p>
      </header>

      {% if document.parties is not empty or document.groups is not empty %}
        <div class="kis-business-document-meta">
          {% for party in document.parties %}
            <section class="kis-business-document-party" aria-label="{{ party.label }}">
              <h2>{{ party.label }}</h2>
              {% if party.records is empty %}
                <p class="kis-business-document-empty">Not specified</p>
              {% else %}
                {% for related in party.records %}
                  <ul class="kis-business-document-party-lines">
                    {% for field in related.fields|default([]) %}
                      {% if field.display is not same as('') %}<li>{{ field.display }}</li>{% endif %}
                    {% endfor %}
                  </ul>
                {% endfor %}
              {% endif %}
            </section>
          {% endfor %}
          {% for group in document.groups %}
            <section class="kis-business-document-group" aria-label="{{ group.label }}">
              <h2>{{ group.label }}</h2>
              <dl>
                {% for field in group.fields %}
                  <div><dt>{{ field.label }}</dt><dd>{{ field.display is not same as('') ? field.display : '—' }}</dd></div>
                {% endfor %}
              </dl>
            </section>
          {% endfor %}
        </div>
      {% endif %}

      {% if document.lines %}
        <section class="kis-business-document-lines" tabindex="0" aria-label="{{ document.lines.label }}">
          <table class="kis-business-document-table">
            <caption class="sr-only">{{ document.lines.label }}</caption>
            <thead>
              <tr>
                <th scope="col" class="kis-business-document-line-number"><span aria-hidden="true">#</span><span class="sr-only">Line</span></th>
                {% for column in document.lines.columns %}<th scope="col">{{ column.label }}</th>{% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in document.lines.rows %}
                <tr>
                  <td class="kis-business-document-line-number">{{ loop.index }}</td>
                  {% for cell in row.cells|default([]) %}<td>{{ cell.display }}</td>{% endfor %}
                </tr>
              {% else %}
                <tr><td colspan="{{ document.lines.columns|length + 1 }}">No lines recorded.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </section>
      {% endif %}

      {% if document.totals is not empty %}
        <section class="kis-business-document-totals" aria-label="Totals">
          <dl>
            {% for total in document.totals %}
              <div{% if loop.last %} class="kis-business-document-grand-total"{% endif %}>
                <dt>{{ total.label }}</dt>
                <dd>{{ total.display is not same as('') ? total.display : '—' }}</dd>
              </div>
            {% endfor %}
          </dl>
        </section>
      {% endif %}
    </article>
  </kumwe-business-surface>
{% endblock %}
