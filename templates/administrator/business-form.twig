{% extends "layout.twig" %}
{% import "_business-fields.twig" as business_fields %}

{% block title %}{{ record ? 'Edit ' ~ definition.singular_label : 'Create ' ~ definition.singular_label }} · Kumwe{% endblock %}
{% block context_title %}{{ record ? 'Edit ' ~ definition.singular_label : 'Create ' ~ definition.singular_label }}{% endblock %}
{% block context_subtitle %}Generated, policy-aware record form{% endblock %}

{% block content %}
  <kumwe-business-surface data-kis-business data-kis-component="generated-record-form" data-kis-surface="core.administrator.generated-definition">
    <header class="page-heading">
      <div>
        <p class="eyebrow">{{ definition.plural_label }}</p>
        <h1>{{ record ? 'Edit ' ~ definition.singular_label : 'Create ' ~ definition.singular_label }}</h1>
        <p>Fields are generated from the published definition and your current field policy.</p>
      </div>
      <div class="page-actions">
        <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}{{ record ? '/' ~ record.record_id|url_encode : '' }}">Cancel</a>
      </div>
    </header>

    {% if version_conflict is defined and record %}
      <section class="notice warning business-version-conflict" data-kis-state="conflict" role="alert" aria-labelledby="business-conflict-title" tabindex="-1">
        <div>
          <h2 id="business-conflict-title">Another actor saved a newer version</h2>
          <p>{{ version_conflict.summary }} You composed this form against version {{ version_conflict.expected_version }}; the stored record is now at version {{ record.version }}.</p>
          <p>Everything you typed is still below. Choose one:</p>
          <ul>
            <li>Save changes again to apply your entries on top of version {{ record.version }}.</li>
            <li><a href="{{ business_base_path }}/{{ definition.handle|url_encode }}/{{ record.record_id|url_encode }}?edit=1">Reload version {{ record.version }}</a> and lose what you typed here.</li>
            {% if available_operations.history is defined %}<li><a href="{{ business_base_path }}/{{ definition.handle|url_encode }}/{{ record.record_id|url_encode }}?task=history">Review what changed</a> before you decide.</li>{% endif %}
          </ul>
        </div>
      </section>
    {% endif %}

    {% if error_summary is defined %}
      <section class="notice danger business-error-summary kis-validation-summary" data-kis-component="validation-summary" role="alert" aria-labelledby="business-error-title" tabindex="-1">
        <div>
          <h2 id="business-error-title">The record could not be saved</h2>
          <p>{{ error_summary }}</p>
          <ul>
            {% for field in fields %}
              {% if field.errors is not empty %}<li><a href="#business-field-{{ field.handle }}">{{ field.label }}</a></li>{% endif %}
            {% endfor %}
          </ul>
        </div>
      </section>
    {% endif %}

    <form
      class="panel editor-form stack business-record-form kis-business-form"
      action="{{ business_base_path }}/{{ definition.handle|url_encode }}{{ record ? '/' ~ record.record_id|url_encode : '' }}"
      method="post"
    >
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <input type="hidden" name="operation" value="{{ record ? 'update' : 'create' }}">
      <input type="hidden" name="operation_id" value="{{ operation_id }}">
      {% if record %}<input type="hidden" name="expected_version" value="{{ record.version }}">{% endif %}

      <div class="section-heading">
        <div>
          <h2>Record fields</h2>
          <p class="field-help"><span aria-hidden="true">*</span> indicates a required field.</p>
        </div>
        {% if record %}<span class="status">Version {{ record.version }}</span>{% endif %}
      </div>

      {% if fields is empty %}
        <p class="empty-state">No editable fields are available for this operation.</p>
      {% else %}
        {{ business_fields.render(fields, definition, record, business_base_path) }}
      {% endif %}

      <div class="page-actions">
        <button class="primary" type="submit">{{ record ? 'Save changes' : 'Create record' }}</button>
        <a class="button" href="{{ business_base_path }}/{{ definition.handle|url_encode }}{{ record ? '/' ~ record.record_id|url_encode : '' }}">Cancel</a>
      </div>
    </form>
  </kumwe-business-surface>
{% endblock %}
