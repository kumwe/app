{% extends 'portal/layout.twig' %}
{% import '@kis/report-parameter-fields.twig' as report_fields %}

{% block title %}{{ t('core.portal.business_report.business_reports_kumwe_portal') }}{% endblock %}

{% block content %}
{% set selected_report = report_result ? report_result.report : (export ? export.report : null) %}
<div data-kis-business data-kis-component="generated-report-workspace" data-kis-surface="core.portal.reports" class="kis-business-stack">
  {% embed '@kis/page-header.twig' with {
    eyebrow: 'Reports',
    title: t('core.administrator.business_report.business_reports'),
    purpose: t('core.administrator.business_report.choose_an_available_report_provide_its')
  } only %}{% endembed %}

  {% if report_error %}<section class="portal-alert kis-validation-summary" data-kis-component="validation-summary" role="alert" tabindex="-1"><h2>{{ t('core.administrator.business_report.report_request_not_accepted') }}</h2><p>{{ report_error }}</p></section>{% endif %}

  <div class="kis-business-record-grid kis-business-report-grid">
    <aside class="portal-business-panel kis-business-record-sidebar" aria-labelledby="portal-report-catalog-title">
      <h2 id="portal-report-catalog-title">{{ t('core.administrator.business_report.catalog') }}</h2>
      {% if reports is empty %}<p>{{ t('core.portal.business_report.no_reports_have_been_enabled_for') }}</p>{% else %}
        <nav class="kis-business-report-catalog" aria-label="{{ t('core.administrator.business_report.available_reports') }}">{% for report in reports %}<a class="kis-business-report-link" href="#portal-report-runner-{{ loop.index }}" aria-current="{{ selected_report == report.id ? 'true' : 'false' }}"><strong>{{ report.title }}</strong><span>{{ t('core.administrator.business_report.parameter', {parameters: (report.parameters|length), parameters2: (report.parameters|length == 1 ? '' : 's')}) }}</span></a>{% endfor %}</nav>
      {% endif %}
    </aside>

    <div class="kis-business-stack">
      <section class="portal-business-panel kis-business-stack" aria-labelledby="portal-report-runner-title">
        <div><p class="eyebrow">{{ t('core.administrator.business_report.runner') }}</p><h2 id="portal-report-runner-title">{{ t('core.administrator.business_report.run_or_export') }}</h2></div>
        {% for report in reports %}
          <form id="portal-report-runner-{{ loop.index }}" method="post" action="{{ report.execute_url }}" class="kis-business-form" aria-label="{{ t('core.administrator.business_report.run', {title: report.title}) }}">
            <input type="hidden" name="_csrf" value="{{ portal_session.csrfToken }}">
            <div><h3>{{ report.title }}</h3>{% include '@kis/technical-value.twig' with {label: t('core.administrator.business_report.report_id'), value: report.id} only %}</div>
            {{ report_fields.fields(report.parameters, 'portal-report-' ~ loop.index) }}
            <div class="portal-actions"><button type="submit">{{ t('core.administrator.business_report.run_report') }}</button>{% if report.can_export %}<button type="submit" formaction="{{ report.export_url }}">{{ t('core.administrator.business_list.queue_csv_export') }}</button>{% endif %}</div>
          </form>
          {% if not loop.last %}<hr>{% endif %}
        {% endfor %}
      </section>

      <section class="portal-business-panel kis-business-report-results" aria-labelledby="portal-report-results-title">
        <div class="portal-business-section-heading"><div><p class="eyebrow">{{ t('core.administrator.business_report.results') }}</p><h2 id="portal-report-results-title">{{ t('core.administrator.business_report.report_results') }}</h2></div>{% if report_result %}<span>{{ t('core.administrator.business_report.rows', {row_count: report_result.row_count}) }}</span>{% endif %}</div>
        {% if report_result %}
          <div class="portal-table-wrap kis-business-table-region" tabindex="0" role="region" aria-label="{{ t('core.administrator.business_report.scrollable_report_results_table') }}" data-scroll-label="Scroll horizontally to review every result column"><table class="portal-table kis-business-table">
            <thead><tr>{% for column in report_result.columns %}<th scope="col">{{ column.label }}</th>{% endfor %}{% if report_result.has_drill_downs %}<th scope="col">{{ t('core.administrator.business_choices.details') }}</th>{% endif %}</tr></thead>
            <tbody>{% for row in report_result.rows %}{% set row_index = loop.index0 %}<tr>{% for column in report_result.columns %}<td data-label="{{ column.label }}">{{ attribute(row, column.alias) is same as(true) ? 'Yes' : (attribute(row, column.alias) is same as(false) ? 'No' : attribute(row, column.alias)|default('')) }}</td>{% endfor %}{% if report_result.has_drill_downs %}<td>{% for link in attribute(report_result.drill_downs, row_index) %}<a href="{{ link.url }}">{{ t('core.administrator.business_report.open_details') }}</a>{% if not loop.last %}<br>{% endif %}{% else %}<span aria-label="{{ t('core.administrator.business_report.no_detail_view') }}">—</span>{% endfor %}</td>{% endif %}</tr>{% else %}<tr><td colspan="{{ report_result.columns|length + (report_result.has_drill_downs ? 1 : 0) }}">{{ t('core.administrator.business_report.no_matching_rows') }}</td></tr>{% endfor %}</tbody>
          </table></div>
          <dl class="kis-business-metadata"><div><dt>{{ t('core.administrator.business_report.definition_checksum') }}</dt><dd>{% include '@kis/technical-value.twig' with {label: t('core.administrator.business_report.definition_checksum'), value: report_result.definition_checksum, copy: false} only %}</dd></div><div><dt>{{ t('core.administrator.business_report.query_digest') }}</dt><dd>{% include '@kis/technical-value.twig' with {label: t('core.administrator.business_report.query_digest'), value: report_result.query_digest, copy: false} only %}</dd></div></dl>
        {% else %}<p>{{ t('core.administrator.business_report.run_a_report_to_display_its') }}</p>{% endif %}
      </section>

      <section class="portal-business-panel" aria-labelledby="portal-export-history-title">
        <div><p class="eyebrow">{{ t('core.administrator.business_report.export_history') }}</p><h2 id="portal-export-history-title">{{ t('core.administrator.business_report.latest_export_request') }}</h2></div>
        {% if export %}<dl class="kis-business-operation-stage"><div><dt>{{ t('core.administrator.access_control.status') }}</dt><dd>{{ export.status|replace({'_': ' '})|title }}</dd></div><div><dt>{{ t('core.administrator.business_report.requested') }}</dt><dd>{{ export.created_at }}</dd></div><div><dt>{{ t('core.administrator.business_report.rows_2') }}</dt><dd>{{ export.row_count is null ? 'Pending' : export.row_count }}</dd></div><div><dt>{{ t('core.administrator.business_definitions.checksum') }}</dt><dd>{{ export.checksum|default('Pending') }}</dd></div></dl><p><a href="/portal/reports/exports/{{ export.id }}">{{ t('core.administrator.business_report.refresh_status') }}</a>{% if export.status == 'completed' %} · <a href="/portal/reports/exports/{{ export.id }}/download">{{ t('core.administrator.business_report.download_verified_csv') }}</a>{% endif %}</p>{% else %}<p>{{ t('core.administrator.business_report.queued_exports_appear_here_with_status') }}</p>{% endif %}
      </section>
    </div>
  </div>
</div>
{% endblock %}
