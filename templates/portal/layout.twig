<!doctype html>
<html lang="{{ locale_tag() }}" dir="{{ text_direction() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}{{ t('core.portal.layout.document_title') }}{% endblock %}</title>
    {% for stylesheet in portal_assets.stylesheets %}<link rel="stylesheet" href="{{ stylesheet }}">{% endfor %}
    {% for module in portal_assets.modules %}<script type="module" src="{{ module }}"></script>{% endfor %}
</head>
<body>
<a class="skip-link" href="#portal-main">{{ t('core.portal.layout.skip_to_content') }}</a>
<header class="portal-header">
    <a class="portal-brand" href="/portal" aria-label="{{ t('core.portal.layout.brand_home') }}">Kumwe <span>{{ t('core.portal.layout.brand_role') }}</span></a>
    {% if portal_session %}
        <div class="portal-context" aria-label="{{ t('core.portal.layout.context_label') }}">
            <span>{{ portal_site }}</span>
            {% if portal_organization %}<span>{{ portal_organization }}</span>{% endif %}
            {% if portal_workspace %}<span>{{ portal_workspace }}</span>{% endif %}
        </div>
        <form method="post" action="/portal/logout">
            <input type="hidden" name="_csrf" value="{{ portal_session.csrfToken }}">
            <button type="submit">{{ t('core.portal.layout.sign_out') }}</button>
        </form>
    {% endif %}
</header>
<div class="portal-shell{% if not portal_session %} portal-shell--guest{% endif %}">
    {% if portal_session %}
        <nav class="portal-navigation" aria-label="{{ t('core.portal.layout.navigation_label') }}">
            {% for workspace in portal_workspaces %}
                <section aria-labelledby="{{ workspace.dom_id }}">
                    <h2 id="{{ workspace.dom_id }}">{{ workspace.label }}</h2>
                    <ul>
                        {% for item in portal_navigation|filter(item => item.workspace == workspace.id) %}
                            <li>
                                <a href="{{ item.href }}"{% if item.id == active_navigation %} aria-current="page"{% endif %}>
                                    <span>{{ item.label }}</span>
                                    <small>{{ item.description }}</small>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        </nav>
    {% endif %}
    <main id="portal-main" tabindex="-1">
        {% block content %}{% endblock %}
    </main>
</div>
</body>
</html>
