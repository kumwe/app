{% extends 'portal/layout.twig' %}

{% block title %}Business records · Kumwe Portal{% endblock %}

{% block content %}
<section class="portal-business-heading" aria-labelledby="portal-business-title">
    <p class="eyebrow">Generated workspaces</p>
    <h1 id="portal-business-title">Business records</h1>
    <p>Only business definitions explicitly enabled for this portal and your current scope appear here.</p>
</section>

{% if definitions is empty %}
    <section class="portal-business-empty" aria-labelledby="portal-business-empty-title">
        <h2 id="portal-business-empty-title">No business workspaces are available</h2>
        <p>Your portal permissions and organization scope do not currently expose any business definitions.</p>
    </section>
{% else %}
    <section class="portal-business-cards" aria-label="Available business workspaces">
        {% for definition in definitions %}
            <article>
                <p class="eyebrow">{{ definition.scope|replace({'_': ' '}) }}</p>
                <h2>{{ definition.plural_label }}</h2>
                <p>{{ definition.fields|length }} visible fields · definition version {{ definition.version }}</p>
                <a href="{{ business_base_path }}/{{ definition.handle|url_encode }}">Open {{ definition.plural_label }}</a>
            </article>
        {% endfor %}
    </section>
{% endif %}
{% endblock %}
