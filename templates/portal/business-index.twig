{% extends 'portal/layout.twig' %}

{% block title %}Business records · Kumwe Portal{% endblock %}

{% block content %}
<div data-kis-business data-kis-component="generated-catalog" data-kis-surface="core.portal.generated-catalog">
{% embed '@kis/page-header.twig' with {
    eyebrow: 'Generated workspaces',
    title: 'Business records',
    purpose: 'Only business definitions explicitly enabled for this portal and your current scope appear here.'
} only %}{% endembed %}

{% if definitions is empty %}
    {% embed '@kis/empty-state.twig' with {
        title: 'No business workspaces are available',
        message: 'Your portal permissions and organization scope do not currently expose any business definitions.'
    } only %}{% endembed %}
{% else %}
    <section class="portal-business-cards kis-business-workspaces" aria-label="Available business workspaces">
        {% for definition in definitions %}
            <article class="kis-business-workspace-card">
                <p class="eyebrow">{{ definition.scope|replace({'_': ' '}) }}</p>
                <h2>{{ definition.plural_label }}</h2>
                <p>{{ definition.fields|length }} visible fields · definition version {{ definition.version }}</p>
                <a href="{{ business_base_path }}/{{ definition.handle|url_encode }}">Open {{ definition.plural_label }}</a>
            </article>
        {% endfor %}
    </section>
{% endif %}
</div>
{% endblock %}
