{% extends 'portal/layout.twig' %}

{% block title %}{{ t('core.administrator.access_denied.document_title') }}{% endblock %}

{% block content %}
<div class="page-heading">
    <p class="eyebrow">{{ t('core.administrator.access_denied.eyebrow') }}</p>
    <h1>{{ t('core.administrator.access_denied.heading') }}</h1>
    <p>{{ t('core.administrator.business_unavailable.explanation') }}</p>
</div>
<section class="panel stack">
    <h2>{{ t('core.administrator.access_denied.next_heading') }}</h2>
    <p>{{ t('core.administrator.access_denied.next_explanation') }}</p>
    <p><a class="button" href="/portal">{{ t('core.administrator.access_denied.dashboard_action') }}</a></p>
    <p>{{ t('core.administrator.business_unavailable.request_access') }}</p>
</section>
{% endblock %}
