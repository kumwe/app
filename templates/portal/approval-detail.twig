{% extends 'portal/layout.twig' %}

{% block title %}Approval request · Kumwe Portal{% endblock %}

{% block content %}
<p><a href="/portal/approvals">← Approval inbox</a></p>
<section aria-labelledby="approval-detail-title">
    <p class="eyebrow">{{ approval.status }}</p>
    <h1 id="approval-detail-title">Approval request</h1>
    {% if notice %}<div class="portal-notice" role="status">{{ notice }}</div>{% endif %}
    {% if error %}<div class="portal-alert" role="alert">{{ error }}</div>{% endif %}
    <dl class="portal-details">
        <div><dt>Request</dt><dd><code>{{ approval.id }}</code></dd></div>
        <div><dt>Action</dt><dd><code>{{ approval.action }}</code></dd></div>
        <div><dt>Resource</dt><dd>{{ approval.resourceType }}, version {{ approval.resourceVersion }}</dd></div>
        <div><dt>Quorum</dt><dd>{{ approval.approvalCount }} of {{ approval.requiredQuorum }}</dd></div>
        <div><dt>Created</dt><dd><time datetime="{{ approval.createdAt|date('c') }}">{{ approval.createdAt|date('Y-m-d H:i T') }}</time></dd></div>
        <div><dt>Expires</dt><dd><time datetime="{{ approval.expiresAt|date('c') }}">{{ approval.expiresAt|date('Y-m-d H:i T') }}</time></dd></div>
    </dl>
</section>

{% if approval.votes is not empty %}
<section aria-labelledby="approval-votes-title">
    <h2 id="approval-votes-title">Decisions</h2>
    <ol>
    {% for vote in approval.votes %}
        <li><strong>{{ vote.decision }}</strong> at <time datetime="{{ vote.decidedAt|date('c') }}">{{ vote.decidedAt|date('Y-m-d H:i T') }}</time>{% if vote.reason %}: {{ vote.reason }}{% endif %}</li>
    {% endfor %}
    </ol>
</section>
{% endif %}

{% if approval.canApprove or approval.canRevoke %}
<section class="portal-security-panel" aria-labelledby="approval-decision-title">
    <h2 id="approval-decision-title">Record a protected decision</h2>
    <p>Your authenticator or recovery code is verified for this exact decision and cannot be replayed.</p>
    <form method="post" class="portal-security-form" id="approval-decision-form">
        <input type="hidden" name="_csrf" value="{{ portal_session.csrfToken }}">
        <fieldset>
            <legend>Verification method</legend>
            <label><input type="radio" name="verification_method" value="totp" checked> Authenticator code</label>
            <label><input type="radio" name="verification_method" value="recovery"> Recovery code</label>
        </fieldset>
        <label for="approval-verification">Verification code</label>
        <input id="approval-verification" name="verification" autocomplete="one-time-code" required>
        {% if approval.canApprove %}
            <label for="approval-reason">Reason <span>(optional, 500 characters)</span></label>
            <textarea id="approval-reason" name="reason" maxlength="500"></textarea>
            <div class="portal-actions">
                <button type="submit" formaction="/portal/approvals/{{ approval.id }}/approve">Approve</button>
                <button type="submit" class="portal-danger" formaction="/portal/approvals/{{ approval.id }}/reject">Reject</button>
            </div>
        {% endif %}
        {% if approval.canRevoke %}
            <button type="submit" class="portal-danger" formaction="/portal/approvals/{{ approval.id }}/revoke">Revoke approval</button>
        {% endif %}
    </form>
</section>
{% endif %}
{% endblock %}
