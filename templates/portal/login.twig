{% extends 'portal/layout.twig' %}

{% block title %}{{ t('core.portal.login.document_title') }}{% endblock %}

{% block content %}
<section class="portal-login kis-phase-five-portal" aria-labelledby="portal-login-title" data-kis-surface="core.portal.login">
    <p class="eyebrow">{{ t('core.portal.login.eyebrow') }}</p>
    <h1 id="portal-login-title">{{ t('core.portal.login.heading') }}</h1>
    <p>{{ t('core.portal.login.purpose') }}</p>
    {% if error %}
        <div class="portal-alert" role="alert">{{ error }}</div>
    {% endif %}
    <form method="post" action="/portal/login">
        <input type="hidden" name="_csrf" value="{{ login_csrf }}">
        <label for="portal-email">{{ t('core.portal.login.email_label') }}</label>
        <input id="portal-email" name="email" type="email" value="{{ email }}" autocomplete="username" required>

        <label for="portal-password">{{ t('core.portal.login.password_label') }}</label>
        <input id="portal-password" name="password" type="password" autocomplete="current-password" required>

        <label for="portal-workspace">{{ t_html('core.portal.login.workspace_label') }}</label>
        <input id="portal-workspace" name="workspace" type="text" autocomplete="off" aria-describedby="portal-workspace-help">
        <small id="portal-workspace-help">{{ t('core.portal.login.workspace_help') }}</small>

        <button type="submit">{{ t('core.portal.login.submit') }}</button>
    </form>

    <details class="portal-sign-in-help">
        <summary>{{ t('core.portal.login.help_summary') }}</summary>
        <p>{{ t('core.portal.login.help_intro') }}</p>
        <ol>
            <li>{{ t('core.portal.login.help_identity') }}</li>
            <li>{{ t('core.portal.login.help_membership') }}</li>
            <li>{{ t('core.portal.login.help_workspace') }}</li>
            <li>{{ t('core.portal.login.help_identifier') }}</li>
        </ol>
        <p>{{ t('core.portal.login.help_closing') }}</p>
    </details>
</section>
{% endblock %}
