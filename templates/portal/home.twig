{% extends 'portal/layout.twig' %}

{% block title %}{{ t('core.portal.dashboard.document_title') }}{% endblock %}

{% block content %}
<div class="kis-phase-five-portal kis-dashboard" data-kis-surface="core.portal.home">
    {% embed '@kis/page-header.twig' with {
        eyebrow: t('core.portal.dashboard.eyebrow'),
        title: t('core.portal.dashboard.heading'),
        purpose: t('core.portal.dashboard.purpose')
    } only %}
        {% block actions %}
            {% if dashboard.preference_forms|default([]) is not empty %}
                <div class="page-actions">
                    <a class="button" href="#dashboard-customization">
                        {{ t('core.interface_standard.dashboard.customize_action') }}
                    </a>
                </div>
            {% endif %}
        {% endblock %}
    {% endembed %}

    {% if dashboard.diagnostics|default([]) is not empty %}
        <p class="notice info" role="status">{{ t('core.interface_standard.dashboard.fallback_notice') }}</p>
    {% endif %}

    <section class="kis-dashboard-workspace" aria-labelledby="portal-dashboard-widgets-title">
        <header class="kis-dashboard-section-heading">
            <div>
                <p class="eyebrow">{{ t('core.portal.dashboard.widgets_eyebrow') }}</p>
                <h2 id="portal-dashboard-widgets-title">{{ t('core.portal.dashboard.widgets_heading') }}</h2>
                <p>{{ t('core.portal.dashboard.widgets_help') }}</p>
            </div>
        </header>
        {% if dashboard.widgets is empty %}
            {% include '@kis/empty-state.twig' with {
                title: t('core.portal.dashboard.empty_heading'),
                message: t('core.portal.dashboard.empty_message')
            } only %}
        {% else %}
            <div class="kis-dashboard-widget-grid">
                {% for widget in dashboard.widgets %}
                    {% include '@kis/dashboard-widget.twig' with {widget: widget, widget_index: loop.index} only %}
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="panel kis-dashboard-shortcuts" aria-labelledby="portal-dashboard-shortcuts-title">
        <header class="panel-header">
            <div>
                <h2 id="portal-dashboard-shortcuts-title">{{ t('core.portal.dashboard.shortcuts_heading') }}</h2>
                <p>{{ t('core.portal.dashboard.shortcuts_help') }}</p>
            </div>
        </header>
        <div class="panel-body">
            {% if dashboard.shortcuts is empty %}
                <p>{{ t('core.portal.dashboard.shortcuts_empty') }}</p>
            {% else %}
                <nav aria-label="{{ t('core.portal.dashboard.shortcuts_label') }}">
                    <ul class="kis-dashboard-shortcut-list">
                        {% for item in dashboard.shortcuts %}
                            <li>
                                <a href="{{ item.href }}">
                                    {% include '@kis/dashboard-icon.twig' with {icon: item.icon} only %}
                                    <span><strong>{{ item.title }}</strong><span>{{ item.description }}</span></span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        </div>
    </section>

    {% include '@kis/dashboard-preferences.twig' with {dashboard: dashboard, csrf: csrf} only %}
</div>
{% endblock %}
