{% extends 'portal/layout.twig' %}

{% block title %}Record history · Kumwe Portal{% endblock %}

{% block content %}
{% set record_path = business_base_path ~ '/' ~ (definition_handle|url_encode) ~ '/' ~ (record_id|url_encode) %}
<div data-kis-business data-kis-component="generated-record-history" data-kis-surface="core.portal.generated-record" data-record-task="history">
<header class="portal-business-heading">
    <div><p class="eyebrow">{{ definition_handle }}</p><h1>Record history</h1><p>{% include '@kis/technical-value.twig' with {label: 'Record ID', value: record_id} only %}</p></div>
    <a class="portal-button secondary" href="{{ record_path }}">Back to record</a>
</header>

{% include '@kis/task-navigation.twig' with {
    label: 'Record tasks',
    active: 'history',
    tasks: [
        {id: 'summary', label: 'Summary', href: record_path ~ '?task=summary'},
        {id: 'relations', label: 'Relations', href: record_path ~ '?task=relations'},
        {id: 'history', label: 'History', href: record_path ~ '?task=history'},
        {id: 'actions', label: 'Actions', href: record_path ~ '?task=actions'}
    ]
} only %}

{% if items is empty %}
    <section class="portal-business-empty"><h2>No revisions are available</h2><p>This record has no visible history entries.</p></section>
{% else %}
    <ol class="portal-business-history kis-business-history">
        {% for revision in items %}
            <li class="portal-business-panel kis-business-history-entry">
                <header class="portal-business-section-heading">
                    <div>
                        <p class="eyebrow">{{ revision.operation|replace({'_': ' '}) }}</p>
                        <h2>Version {{ revision.record_version }} · Revision {{ revision.revision_number }}</h2>
                    </div>
                    <time datetime="{{ revision.occurred_at }}">{{ revision.occurred_at|date('Y-m-d H:i:s') }}</time>
                </header>
                <p>
                    {% if revision.actor_id is defined and revision.actor_id %}Performed by <code>{{ revision.actor_id }}</code>.{% else %}Actor attribution is not disclosed.{% endif %}
                    {% if revision.changed_fields is not empty %}Changed {{ revision.changed_fields|join(', ') }}.{% endif %}
                </p>
                {% if revision.snapshot is not empty %}
                    <details>
                        <summary>View disclosed snapshot</summary>
                        <dl class="portal-details">
                            {% for handle, value in revision.snapshot %}
                                <div>
                                    <dt>{{ handle|replace({'_': ' '})|title }}</dt>
                                    <dd>
                                        {{ value is same as(true)
                                            ? 'Yes'
                                            : (value is same as(false)
                                                ? 'No'
                                                : (value is null
                                                    ? 'Not set'
                                                    : (value is iterable ? value|json_encode : value)))
                                        }}
                                    </dd>
                                </div>
                            {% endfor %}
                        </dl>
                    </details>
                {% endif %}
                {% if revision.integrity_checksum is defined %}
                    <small>Integrity checksum <code class="portal-digest">{{ revision.integrity_checksum }}</code></small>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
    {% if has_more and before_version %}
        <nav class="portal-actions" aria-label="History pages"><a class="portal-button secondary" href="?task=history&amp;before_version={{ before_version }}" rel="next">Older revisions</a></nav>
    {% endif %}
{% endif %}
</div>
{% endblock %}
