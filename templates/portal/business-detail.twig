{% extends 'portal/layout.twig' %}
{% import 'portal/_business-fields.twig' as business_fields %}
{% set record_path = business_base_path ~ '/' ~ (definition.handle|url_encode)
    ~ '/' ~ (record.record_id|url_encode) %}

{% block title %}{{ t('core.portal.business_detail.kumwe_portal', {singular_label: definition.singular_label}) }}{% endblock %}

{% block content %}
<div data-kis-business data-kis-component="generated-record" data-kis-surface="{{ relationship_focus|default(null) ? 'core.portal.generated-relationship' : 'core.portal.generated-record' }}" data-record-task="{{ record_task }}">
<header class="portal-business-heading">
    <div>
        <p class="eyebrow">{{ definition.plural_label }}</p>
        <h1>{{ definition.singular_label }}</h1>
        <p>{% include '@kis/technical-value.twig' with {label: t('core.administrator.business_confirm.record_id'), value: record.record_id} only %} {{ t('core.administrator.business_detail.version', {version: record.version}) }}</p>
    </div>
    <nav class="portal-actions" aria-label="{{ t('core.portal.business_detail.record_actions') }}">
        {% if relationship_focus|default(null) %}
            <a class="portal-button secondary" href="{{ record_path }}">{{ t('core.administrator.business_custom_view.back_to_record') }}</a>
        {% endif %}
        <a class="portal-button secondary" href="{{ business_base_path }}/{{ definition.handle|url_encode }}">{{ t('core.administrator.business_detail.back_to_list') }}</a>
        {% for declared_view in definition.views %}
            {% if declared_view.custom and (
                declared_view.kind == 'detail'
                or (declared_view.kind == 'form' and available_operations.update is defined)
                or (declared_view.kind == 'history' and available_operations.history is defined)
                or (declared_view.kind == 'relation' and available_operations.relation is defined)
            ) %}
                <a class="portal-button secondary" href="{{ business_base_path }}/{{ definition.handle|url_encode }}/{{ record.record_id|url_encode }}/views/{{ declared_view.handle|url_encode }}">{{ declared_view.label }}</a>
            {% endif %}
        {% endfor %}
        {% if available_operations.report is defined %}
            <a class="portal-button secondary" href="{{ business_base_path }}/{{ definition.handle|url_encode }}?purpose=report">{{ t('core.administrator.business_detail.report') }}</a>
        {% endif %}
        {% if available_operations.update is defined and record.deleted_at is null %}<a class="portal-button" href="{{ record_path }}?edit=1">{{ t('core.administrator.business_detail.edit') }}</a>{% endif %}
    </nav>
</header>

{% if completed_operation_id %}
    <div class="portal-notice" role="status">
        {{ t('core.administrator.business_detail.the_operation_completed') }}{% if available_operations.status is defined %} <a href="{{ business_base_path }}/operations/{{ completed_operation_id|url_encode }}">{{ t('core.administrator.business_detail.view_operation_status') }}</a>.{% endif %}
    </div>
{% endif %}
{% if error_summary is defined and error_summary %}
    <section class="portal-alert" role="alert" tabindex="-1">
        <h2>{{ t('core.administrator.business_detail.the_relationship_could_not_be_saved') }}</h2><p>{{ error_summary }}</p>
    </section>
{% endif %}
{% if version_conflict is defined %}
    <section class="portal-alert portal-business-version-conflict" data-kis-state="conflict" role="alert" tabindex="-1">
        <h2>{{ t('core.administrator.business_detail.another_actor_saved_a_newer_version') }}</h2>
        <p>{{ t('core.administrator.business_detail.you_composed_this_form_against_version', {summary: version_conflict.summary, expected_version: version_conflict.expected_version, version: record.version}) }}</p>
        <p>{{ t('core.administrator.business_detail.your_entries_are_kept_in_the', {version: record.version}) }} <a href="{{ record_path }}?task=relations">{{ t('core.administrator.business_detail.reload_version', {version: record.version}) }}</a> {{ t('core.administrator.business_detail.and_lose_what_you_typed_here') }}</p>
    </section>
{% endif %}

{% set record_tasks = [
    {id: 'summary', label: 'Summary', href: record_path ~ '?task=summary'},
    {id: 'relations', label: 'Relations', href: record_path ~ '?task=relations', count: definition.relationships|length},
    {id: 'actions', label: 'Actions', href: record_path ~ '?task=actions', count: definition.actions|length}
] %}
{% if available_operations.history is defined %}
    {% set record_tasks = record_tasks|merge([{id: 'history', label: 'History', href: record_path ~ '?task=history'}]) %}
{% endif %}
<div class="kis-business-record-tabs">
    {% include '@kis/task-navigation.twig' with {label: t('core.administrator.business_detail.record_tasks'), tasks: record_tasks, active: record_task} only %}
</div>

<div class="portal-business-detail-layout kis-business-record-grid">
    <div class="portal-business-stack kis-business-stack">
        {% if record_task == 'summary' %}
        <section class="portal-business-panel kis-business-section" aria-labelledby="portal-business-values-title">
            <div class="portal-business-section-heading">
                <h2 id="portal-business-values-title">{{ t('core.administrator.business_detail.record_details') }}</h2>
                <span class="portal-business-status">
                    {{ record.deleted_at ? 'Deleted' : (record.archived_at ? 'Archived' : record.workflow_state|default('Active'))|replace({'_': ' '})|title }}
                </span>
            </div>
            {% if fields is empty %}
                <p>{{ t('core.administrator.business_detail.no_field_values_are_available_for') }}</p>
            {% else %}
                <dl class="portal-details portal-business-details kis-business-details">
                    {% for field in fields %}
                        <div><dt>{{ field.label }}</dt><dd>{{ field.display is not same as('') ? field.display : t('core.administrator.business_fields.not_set') }}</dd></div>
                    {% endfor %}
                </dl>
            {% endif %}
        </section>
        {% endif %}

        {% if record_task in ['summary', 'relations'] and definition.relationships is not empty %}
            <section class="portal-business-panel portal-business-stack kis-business-section" aria-labelledby="portal-business-relations-title">
                <div><p class="eyebrow">{{ t('core.administrator.business_detail.connected_records') }}</p><h2 id="portal-business-relations-title">{{ t('core.administrator.business_detail.relationships_and_ordered_lines') }}</h2></div>
                {% for relationship in definition.relationships %}
                    {% set related = record.includes[relationship.handle]|default([]) %}
                    {% set relationship_loaded = relationship.loaded|default(false) %}
                    <article class="portal-business-relation kis-business-relation" aria-labelledby="portal-relation-{{ relationship.handle }}-title">
                        <div class="portal-business-section-heading">
                            <div>
                                <h3 id="portal-relation-{{ relationship.handle }}-title">{{ relationship.label }}</h3>
                                <p>{{ relationship.kind|replace({'_': ' '})|title }}{% if relationship.ordered %} {{ t('core.administrator.business_detail.ordered') }}{% endif %}</p>
                            </div>
                            <div class="portal-actions">
                                <span class="portal-business-count">{{ relationship_loaded ? related|length : '…' }}</span>
                                {% if relationship_focus|default(null) != relationship.handle %}
                                    <a
                                        class="portal-button secondary"
                                        href="{{ record_path }}/relationships/{{ relationship.handle|url_encode }}"
                                    >{{ t('core.administrator.business_detail.view_and_manage') }}</a>
                                {% endif %}
                            </div>
                        </div>
                        {% if not relationship_loaded %}
                            <p>{{ t('core.administrator.business_detail.open_this_relationship_to_load_its') }}</p>
                        {% elseif related is empty %}
                            <p>{{ t('core.administrator.business_detail.no_related_records_are_currently_included') }}</p>
                        {% else %}
                            <ul class="portal-business-related-records kis-business-related-records">
                                {% for related_record in related %}
                                    <li>
                                        <span>
                                            <strong>{{ related_record.label|default(t('core.administrator.business_detail.unnamed_record')) }}</strong>
                                            <small>{{ t('core.administrator.business_definitions.version', {version: related_record.version}) }}</small>
                                        </span>
                                        {% if relationship_focus|default(null) == relationship.handle
                                            and available_operations.relation is defined
                                        %}
                                            <form method="post">
                                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                                <input type="hidden" name="operation" value="unrelate">
                                                <input type="hidden" name="operation_id" value="{{ operation_id }}">
                                                <input type="hidden" name="expected_version" value="{{ record.version }}">
                                                <input type="hidden" name="relationship" value="{{ relationship.handle }}">
                                                <input type="hidden" name="target_record_id" value="{{ related_record.record_id }}">
                                                <button class="portal-danger" type="submit">{{ t('core.administrator.business_definitions.remove') }}</button>
                                            </form>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                        {% if relationship_focus|default(null) == relationship.handle
                            and available_operations.relation is defined
                            and relationship.owned_line_form|default(null)
                        %}
                            {% set line_form = relationship.owned_line_form %}
                            <form class="portal-business-relation-form portal-business-owned-line-form kis-business-relation-form kis-business-owned-line-form" method="post">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <input type="hidden" name="operation" value="relate">
                                <input type="hidden" name="operation_id" value="{{ operation_id }}">
                                <input type="hidden" name="expected_version" value="{{ record.version }}">
                                <input type="hidden" name="relationship" value="{{ relationship.handle }}">
                                {% if line_form.identity_generated %}
                                    <input type="hidden" name="target_record_id" value="{{ line_form.suggested_record_id }}">
                                {% endif %}
                                <div>
                                    <h4>{{ t('core.administrator.business_detail.add', {target_label: line_form.target_label}) }}</h4>
                                    <p>{{ t('core.administrator.business_detail.the_new_line_is_created_and') }}</p>
                                </div>
                                {{ business_fields.render(
                                    line_form.fields,
                                    definition,
                                    record,
                                    business_base_path,
                                    'target_values'
                                ) }}
                                {% if relationship.ordered %}
                                    <label for="portal-relation-{{ relationship.handle }}-owned-position">{{ t('core.administrator.business_detail.position') }}
                                        <input
                                            id="portal-relation-{{ relationship.handle }}-owned-position"
                                            type="number"
                                            min="0"
                                            name="position"
                                        >
                                    </label>
                                {% endif %}
                                <button type="submit">{{ t('core.administrator.business_detail.add', {target_label: line_form.target_label}) }}</button>
                            </form>
                        {% elseif relationship_focus|default(null) == relationship.handle
                            and available_operations.relation is defined
                            and relationship.choice_available
                        %}
                            <form class="portal-business-relation-form kis-business-relation-form" method="post">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <input type="hidden" name="operation" value="relate">
                                <input type="hidden" name="operation_id" value="{{ operation_id }}">
                                <input type="hidden" name="expected_version" value="{{ record.version }}">
                                <input type="hidden" name="relationship" value="{{ relationship.handle }}">
                                <label for="portal-relation-{{ relationship.handle }}-target">{{ t('core.administrator.business_detail.target_record') }}
                                    <select id="portal-relation-{{ relationship.handle }}-target" name="target_record_id" required>
                                        <option value=""{% if relationship.selected_choice is not defined %} selected{% endif %} disabled>
                                            {{ t('core.administrator.business_detail.choose_a_related_record') }}
                                        </option>
                                        {% for choice in relationship.choices %}
                                            <option
                                                value="{{ choice.value }}"
                                                {% if relationship.selected_choice|default(null) is same as(choice.value) %}selected{% endif %}
                                            >{{ choice.label }}</option>
                                        {% endfor %}
                                    </select>
                                </label>
                                <a
                                    class="portal-button secondary"
                                    href="{{ business_base_path }}/{{ definition.handle|url_encode }}/{{ record.record_id|url_encode }}/choices/relations/{{ relationship.handle|url_encode }}?operation=relation"
                                >{{ t('core.administrator.business_detail.search_available_records') }}</a>
                                {% if relationship.ordered %}
                                    <label for="portal-relation-{{ relationship.handle }}-position">{{ t('core.administrator.business_detail.position') }}
                                        <input id="portal-relation-{{ relationship.handle }}-position" type="number" min="0" name="position">
                                    </label>
                                {% endif %}
                                <button type="submit">{{ t('core.administrator.business_definitions.add_relationship') }}</button>
                            </form>
                        {% elseif relationship_focus|default(null) == relationship.handle
                            and available_operations.relation is defined
                            and relationship.kind == 'owned_line_collection'
                        %}
                            <p>{{ t('core.administrator.business_detail.no_owned_line_fields_are_available') }}</p>
                        {% endif %}
                        {% if relationship_focus|default(null) == relationship.handle
                            and relationship.ordered
                            and related is not empty
                            and available_operations.reorder is defined
                        %}
                            <form class="portal-business-order-form kis-business-order-form" method="post">
                                <input type="hidden" name="_csrf" value="{{ csrf }}">
                                <input type="hidden" name="operation" value="reorder">
                                <input type="hidden" name="operation_id" value="{{ operation_id }}">
                                <input type="hidden" name="expected_version" value="{{ record.version }}">
                                <input type="hidden" name="relationship" value="{{ relationship.handle }}">
                                <p>{{ t('core.administrator.business_detail.choose_each_related_record_exactly_once') }}</p>
                                <ol data-business-order-list>
                                    {% for related_record in related %}
                                        {% set order_control_id =
                                            'portal-order-' ~ relationship.handle ~ '-' ~ loop.index
                                        %}
                                        <li data-record-id="{{ related_record.record_id }}">
                                            <label for="{{ order_control_id }}">
                                                {{ t('core.administrator.business_detail.position_2', {index: loop.index}) }}
                                                <select
                                                    id="{{ order_control_id }}"
                                                    name="ordered_record_ids[]"
                                                    required
                                                >
                                                    {% for candidate in related %}
                                                        <option
                                                            value="{{ candidate.record_id }}"
                                                            {% if candidate.record_id
                                                                is same as(related_record.record_id)
                                                            %}selected{% endif %}
                                                        >{{ candidate.label|default(t('core.administrator.business_detail.unnamed_record')) }}</option>
                                                    {% endfor %}
                                                </select>
                                            </label>
                                        </li>
                                    {% endfor %}
                                </ol>
                                <button type="submit">{{ t('core.administrator.business_detail.save_order') }}</button>
                            </form>
                        {% endif %}
                    </article>
                {% endfor %}
            </section>
        {% endif %}
    </div>

    {% if record_task in ['summary', 'actions'] %}
    <aside class="portal-business-stack kis-business-record-sidebar" aria-label="{{ t('core.administrator.business_detail.record_operations') }}">
        {% if record_task == 'summary' %}
        <section class="portal-business-panel">
            <p class="eyebrow">{{ t('core.administrator.business_detail.record_state') }}</p>
            <h2>{{ record.workflow_state|default('Active')|replace({'_': ' '})|title }}</h2>
            <dl class="portal-details portal-business-metadata kis-business-metadata">
                <div><dt>{{ t('core.administrator.business_detail.created') }}</dt><dd><time datetime="{{ record.created_at }}">{{ record.created_at|date('Y-m-d H:i') }}</time></dd></div>
                <div><dt>{{ t('core.administrator.business_detail.updated') }}</dt><dd><time datetime="{{ record.updated_at }}">{{ record.updated_at|date('Y-m-d H:i') }}</time></dd></div>
                <div><dt>{{ t('core.administrator.business_detail.definition') }}</dt><dd>v{{ record.definition_version }}</dd></div>
            </dl>
        </section>
        {% endif %}

        {% if record_task in ['summary', 'actions'] and available_operations.action is defined and definition.actions is not empty %}
            <section class="portal-business-panel portal-business-stack" aria-labelledby="portal-business-actions-title">
                <div><p class="eyebrow">{{ t('core.administrator.business_definitions.workflow') }}</p><h2 id="portal-business-actions-title">{{ t('core.administrator.business_detail.available_actions') }}</h2></div>
                {% for action in definition.actions %}
                    <a class="portal-button{% if action.high_impact %} danger{% endif %}" href="{{ record_path }}?confirm=action&amp;action={{ action.handle|url_encode }}">
                        {{ action.label }}{% if action.transition %} → {{ action.transition|replace({'_': ' '})|title }}{% endif %}
                    </a>
                    {% if available_operations.approval is defined and action.high_impact %}
                        <a class="portal-button secondary" href="{{ record_path }}?confirm=action&amp;action={{ action.handle|url_encode }}&amp;approval=1">{{ t('core.administrator.business_detail.request_approval_for', {label: action.label}) }}</a>
                    {% endif %}
                {% endfor %}
                {% if available_operations.approval is defined %}
                    <a href="/portal/approvals">{{ t('core.portal.business_detail.open_approval_inbox') }}</a>
                {% endif %}
            </section>
        {% endif %}

        {% if record_task in ['summary', 'actions'] %}
        <section class="portal-business-panel portal-business-stack" aria-labelledby="portal-business-lifecycle-title">
            <div><p class="eyebrow">{{ t('core.administrator.business_definitions.lifecycle') }}</p><h2 id="portal-business-lifecycle-title">{{ t('core.administrator.business_detail.record_controls') }}</h2></div>
            {% if available_operations.restore is defined and (record.archived_at or record.deleted_at) %}
                <a class="portal-button secondary" href="{{ record_path }}?confirm=restore&archived=1&deleted=1">{{ t('core.administrator.business_confirm.restore_record') }}</a>
            {% endif %}
            {% if available_operations.archive is defined and record.archived_at is null and record.deleted_at is null %}
                <a class="portal-button secondary" href="{{ record_path }}?confirm=archive">{{ t('core.administrator.business_confirm.archive_record') }}</a>
            {% endif %}
            {% if available_operations.delete is defined and record.deleted_at is null %}
                <a class="portal-button danger" href="{{ record_path }}?confirm=delete{% if record.archived_at %}&archived=1{% endif %}">{{ t('core.administrator.business_confirm.delete_record') }}</a>
            {% endif %}
        </section>
        {% endif %}
    </aside>
    {% endif %}
</div>
</div>
{% endblock %}
