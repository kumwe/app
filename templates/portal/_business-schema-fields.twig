{% macro fields(fields) %}
    <div class="portal-business-schema-fields">
        {% for field in fields %}{{ _self.field(field) }}{% endfor %}
    </div>
{% endmacro %}

{% macro field(field) %}
    {% set input_id = 'portal-business-schema-' ~ field.path_token %}
    {% if field.kind == 'object' %}
        <fieldset class="portal-business-schema-group">
            <legend>{{ field.label }}{% if field.required %} <span aria-hidden="true">*</span>{% endif %}</legend>
            {% if not field.required %}<label class="portal-business-checkbox" for="{{ input_id }}-present"><input id="{{ input_id }}-present" type="checkbox" name="{{ field.presence_name }}" value="1"{% if field.included %} checked{% endif %}><span>Include {{ field.label|lower }}</span></label>{% endif %}
            {% if field.description %}<p class="portal-field-help">{{ field.description }}</p>{% endif %}
            {{ _self.fields(field.children) }}
        </fieldset>
    {% elseif field.kind == 'array' %}
        <fieldset class="portal-business-schema-group portal-business-schema-array">
            <legend>{{ field.label }}{% if field.required %} <span aria-hidden="true">*</span>{% endif %}</legend>
            {% if not field.required %}<label class="portal-business-checkbox" for="{{ input_id }}-present"><input id="{{ input_id }}-present" type="checkbox" name="{{ field.presence_name }}" value="1"{% if field.included %} checked{% endif %}><span>Include {{ field.label|lower }}</span></label>{% endif %}
            {% if field.description %}<p class="portal-field-help">{{ field.description }}</p>{% endif %}
            <label for="{{ input_id }}-count">Number of rows<input id="{{ input_id }}-count" type="number" name="{{ field.count_name }}" value="{{ field.count }}" min="{{ field.min_items }}" max="{{ field.max_items }}" step="1"></label>
            <div class="portal-business-schema-array-items">{% for item in field.items %}<div class="portal-business-schema-array-item">{{ _self.field(item) }}</div>{% endfor %}</div>
        </fieldset>
    {% elseif field.kind == 'const' %}
        <div class="portal-business-schema-field">
            {% if not field.required %}<label class="portal-business-checkbox" for="{{ input_id }}-present"><input id="{{ input_id }}-present" type="checkbox" name="{{ field.presence_name }}" value="1"{% if field.included %} checked{% endif %}><span>Include {{ field.label|lower }}</span></label>{% endif %}
            <span class="portal-business-field-label">{{ field.label }}</span><output>{{ field.display }}</output>
        </div>
    {% else %}
        <div class="portal-business-schema-field">
            <label for="{{ input_id }}">{{ field.label }}{% if field.required %} <span aria-hidden="true">*</span>{% endif %}</label>
            {% if field.kind == 'select' %}
                <select id="{{ input_id }}" name="{{ field.name }}"{% if field.required and not field.nullable %} required{% endif %}>
                    {% if not field.required or field.nullable or field.input_value is empty %}<option value="">{{ field.nullable ? 'Not set' : 'Choose an option' }}</option>{% endif %}
                    {% for option in field.options %}<option value="{{ option.value }}"{% if field.input_value is same as(option.value) %} selected{% endif %}>{{ option.label }}</option>{% endfor %}
                </select>
            {% else %}
                <input id="{{ input_id }}" type="{{ field.kind == 'integer' ? 'number' : (field.kind == 'email' ? 'email' : (field.kind == 'date' ? 'date' : 'text')) }}" name="{{ field.name }}" value="{{ field.input_value }}"{% if field.required and not field.nullable %} required{% endif %}{% if field.kind == 'integer' %} step="1"{% endif %}{% if field.attributes.minlength is defined %} minlength="{{ field.attributes.minlength }}"{% endif %}{% if field.attributes.maxlength is defined %} maxlength="{{ field.attributes.maxlength }}"{% endif %}{% if field.attributes.min is defined %} min="{{ field.attributes.min }}"{% endif %}{% if field.attributes.max is defined %} max="{{ field.attributes.max }}"{% endif %}>
            {% endif %}
            {% if field.description %}<p class="portal-field-help">{{ field.description }}</p>{% endif %}
        </div>
    {% endif %}
{% endmacro %}
