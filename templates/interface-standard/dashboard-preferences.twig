  {{ t('core.interface_standard.dashboard.access_group_browser_heading') }}
  {{ t('core.interface_standard.dashboard.access_group_browser_help') }}
  {{ t('core.interface_standard.dashboard.access_group_search_label') }}
  {{ t('core.interface_standard.dashboard.access_group_search_placeholder') }}
  {{ t('core.interface_standard.dashboard.access_group_search_action') }}
  {{ t('core.interface_standard.dashboard.access_group_search_clear') }}
  {{ t('core.interface_standard.dashboard.access_group_page_status') }}
  {{ t('core.interface_standard.dashboard.access_group_search_status') }}
  {{ t('core.interface_standard.dashboard.access_group_search_empty') }}
  {{ t('core.interface_standard.dashboard.access_group_page_empty') }}
  {{ t('core.interface_standard.dashboard.access_group_page_limit') }}
  {{ t('core.interface_standard.dashboard.access_group_pagination_label') }}
  {{ t('core.interface_standard.dashboard.access_group_previous') }}
  {{ t('core.interface_standard.dashboard.access_group_next') }}
  {{ t('core.interface_standard.dashboard.workflow_browser_heading') }}
  {{ t('core.interface_standard.dashboard.workflow_browser_help') }}
