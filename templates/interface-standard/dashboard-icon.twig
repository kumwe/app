{#
  Protected, shell-independent dashboard icon registry. Contributed icon names are semantic hints only:
  an unknown name always renders the generic dashboard glyph instead of an unresolved external symbol.
#}
{% set resolved_icon = icon in [
  'automation',
  'briefcase',
  'check-circle',
  'content',
  'dashboard',
  'extensions',
  'home',
  'media',
  'models',
  'navigation',
  'plus',
  'security',
  'settings',
  'shield',
  'status',
  'users'
] ? icon : 'dashboard' %}
<svg
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  data-kis-dashboard-icon="{{ resolved_icon }}"
  data-kis-dashboard-icon-fallback="{{ resolved_icon == icon ? 'false' : 'true' }}"
>
  {% if resolved_icon == 'content' %}
    <path d="M6 3.8h9l3 3V20H6V3.8Z"/><path d="M15 3.8V7h3M9 11h6M9 14.5h6"/>
  {% elseif resolved_icon == 'media' %}
    <rect x="3.5" y="4" width="17" height="16" rx="2"/><circle cx="9" cy="9" r="1.5"/>
    <path d="m5 17 4.5-4 3 2.5 2-2 4.5 3.7"/>
  {% elseif resolved_icon == 'models' %}
    <path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z"/><path d="m4 12 8 4.5 8-4.5M4 16.5l8 4.5 8-4.5"/>
  {% elseif resolved_icon == 'navigation' %}
    <circle cx="6" cy="5" r="2"/><circle cx="18" cy="12" r="2"/><circle cx="6" cy="19" r="2"/>
    <path d="M8 5h3a3 3 0 0 1 3 3v1a3 3 0 0 0 3 3M8 19h3a3 3 0 0 0 3-3v-1a3 3 0 0 1 3-3"/>
  {% elseif resolved_icon == 'users' %}
    <circle cx="9" cy="8" r="3"/>
    <path d="M3.5 19v-1.5A4.5 4.5 0 0 1 8 13h2a4.5 4.5 0 0 1 4.5 4.5V19M16 5.5a3 3 0 0 1 0 5.8M17 14a4.5 4.5 0 0 1 3.5 4.4V19"/>
  {% elseif resolved_icon in ['security', 'shield'] %}
    <path d="M12 3 19 6v5c0 4.6-2.9 8.1-7 10-4.1-1.9-7-5.4-7-10V6l7-3Z"/>
    <path d="m9 12 2 2 4-4"/>
  {% elseif resolved_icon == 'extensions' %}
    <path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5"/><rect x="8" y="8" width="8" height="8" rx="1.5"/>
  {% elseif resolved_icon == 'automation' %}
    <path d="M4 12a8 8 0 1 0 2.3-5.7L4 8.5"/><path d="M4 4v4.5h4.5M12 7v5l3 2"/>
  {% elseif resolved_icon == 'settings' %}
    <circle cx="12" cy="12" r="3"/>
    <path d="M19 13.5v-3l-2-.7-.7-1.6.9-1.9-2.1-2.1-1.9.9-1.6-.7-.7-2h-3l-.7 2-1.6.7-1.9-.9-2.1 2.1.9 1.9-.7 1.6-2 .7v3l2 .7.7 1.6-.9 1.9 2.1 2.1 1.9-.9 1.6.7.7 2h3l.7-2 1.6-.7 1.9.9 2.1-2.1-.9-1.9.7-1.6 2-.7Z" transform="translate(1.5) scale(.88)"/>
  {% elseif resolved_icon == 'briefcase' %}
    <rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V4h6v3M3 12h18M10 12v2h4v-2"/>
  {% elseif resolved_icon in ['check-circle', 'status'] %}
    <circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/>
  {% elseif resolved_icon == 'home' %}
    <path d="m4 11 8-7 8 7v9h-6v-6h-4v6H4v-9Z"/>
  {% elseif resolved_icon == 'plus' %}
    <path d="M12 5v14M5 12h14"/>
  {% else %}
    <path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z"/>
  {% endif %}
</svg>
