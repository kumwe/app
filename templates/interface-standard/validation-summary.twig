{% if errors %}
  <section
    class="notice danger kis-validation-summary"
    role="alert"
    aria-labelledby="{{ id }}-validation-title"
    data-kis-component="validation-summary"
    tabindex="-1"
  >
    <div>
      <h2 id="{{ id }}-validation-title">{{ title|default(t('core.interface_standard.validation_summary.title')) }}</h2>
      <ul>
        {% for error in errors %}<li><a href="#{{ error.target }}">{{ error.message }}</a></li>{% endfor %}
      </ul>
    </div>
  </section>
{% endif %}
