{% extends "layout.twig" %}
{% block title %}{{ entry.title }} · {{ site_name }}{% endblock %}
{% block content %}
  <article class="article-shell"><header><p class="eyebrow">{{ entry.status|replace({'_': ' '})|title }}</p><h1>{{ entry.title }}</h1><p class="article-meta">Updated <time datetime="{{ entry.updated_at }}">{{ entry.updated_at|date('F j, Y') }}</time></p></header><div class="article-body">{{ entry.body_html|raw }}</div></article>
{% endblock %}
