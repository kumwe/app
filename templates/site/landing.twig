{% extends "layout.twig" %}
{% block title %}{{ entry.title }} · {{ site_name }}{% endblock %}
{% block content %}
  {% set page = entry.data|default({}) %}
  {% set logo = page.logo|default('') %}
  {% set primary_action = page.primary_action|default(null) %}
  {% set secondary_action = page.secondary_action|default(null) %}
  {% set closing = page.closing|default(null) %}
  <article class="managed-page managed-page-landing landing-page kis-phase-five-public" aria-labelledby="managed-page-title" data-kis-surface="{{ surface_id|default('core.public.page') }}">
    <header class="managed-hero"><div class="site-container managed-hero-grid"><div class="managed-hero-copy">
      {% if page.eyebrow|default('') %}<p class="eyebrow">{{ page.eyebrow }}</p>{% endif %}
      <h1 id="managed-page-title">{{ page.heading|default(entry.title, true) }}</h1>
      {% if page.summary|default('') %}<p class="managed-summary">{{ page.summary }}</p>{% endif %}
      {% if primary_action or secondary_action %}
        <div class="managed-actions">
          {% if primary_action and primary_action.url|default('') and primary_action.label|default('') %}<a class="site-button" href="{{ primary_action.url }}">{{ primary_action.label }}</a>{% endif %}
          {% if secondary_action and secondary_action.url|default('') and secondary_action.label|default('') %}<a class="site-button secondary" href="{{ secondary_action.url }}">{{ secondary_action.label }}</a>{% endif %}
        </div>
      {% endif %}
    </div>{% if logo %}<div class="managed-hero-logo"><img src="{{ logo }}" alt="{{ site_name }}" loading="eager"></div>{% endif %}</div></header>
    <section class="managed-section"><div class="site-container">
      <ul class="landing-features">
        {% for feature in page.features|default([]) %}
          <li class="landing-feature"{% if feature.anchor|default('') %} id="{{ feature.anchor }}"{% endif %}>
            <h2>{{ feature.heading }}</h2>
            <div class="article-body">{{ feature.body_html|default('')|raw }}</div>
          </li>
        {% endfor %}
      </ul>
    </div></section>
    {% if closing %}
      <section class="managed-section managed-section-accent landing-closing"><div class="site-container">
        {% if closing.heading|default('') %}<h2>{{ closing.heading }}</h2>{% endif %}
        <div class="article-body">{{ closing.body_html|default('')|raw }}</div>
        {% if closing.action|default(null) and closing.action.url|default('') and closing.action.label|default('') %}
          <div class="managed-actions"><a class="site-button" href="{{ closing.action.url }}">{{ closing.action.label }}</a></div>
        {% endif %}
      </div></section>
    {% endif %}
  </article>
{% endblock %}
