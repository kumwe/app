  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@kumwe/studio-core": "0.1.0-alpha.8",
    "@kumwe/studio-protocol": "0.1.0-alpha.6"
  },
  "publishConfig": {
