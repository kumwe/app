{
  "contractVersion": "0.1-draft",
  "kind": "host-sequence-vector",
  "id": "vector.host-sequence.recovery.store.resource-scope",
  "description": "The same idempotency key and intent in two resource contexts are independent accepted records, and each context receives its own recovery state.",
  "profile": "studio.profile/host-baseline-v2",
  "assertions": ["idempotency-resource-scope-separation"],
  "idempotencyPolicy": {
    "scopeFields": ["idempotencyKey", "operationId", "resourceContextKey", "sessionGeneration"],
    "argumentCanonicalization": "canonical-json",
    "intentContextFields": ["expectedRevision", "locale", "protocolVersion"],
    "absentOptionalFields": "omit",
    "numberNormalization": "canonical-json",
    "excludedContextFields": ["requestId", "traceContext"]
  },
  "given": { "artifacts": [], "permissions": [], "sessionGeneration": "session-r1" },
  "steps": [
    {
      "action": "invoke",
      "id": "store-context-a",
      "port": "recovery",
      "operation": "store",
      "context": {
        "operationId": "studio.operation/recovery.store",
        "protocolVersion": "0.1.0-draft.2",
        "requestId": "requests/store-context-a",
        "resourceContextKey": "contexts/scope-a",
        "sessionGeneration": "session-r1",
        "idempotencyKey": "idempotency/shared-scope-key"
      },
      "argument": { "draft": "same-intent" },
      "completion": "settled",
      "expect": { "outcome": "result", "value": "null" }
    },
    {
      "action": "invoke",
      "id": "store-context-b",
      "port": "recovery",
      "operation": "store",
      "context": {
        "operationId": "studio.operation/recovery.store",
        "protocolVersion": "0.1.0-draft.2",
        "requestId": "requests/store-context-b",
        "resourceContextKey": "contexts/scope-b",
        "sessionGeneration": "session-r1",
        "idempotencyKey": "idempotency/shared-scope-key"
      },
      "argument": { "draft": "same-intent" },
      "completion": "settled",
      "expect": { "outcome": "result", "value": "null" }
    }
  ],
  "expectFinal": {
    "recovery": [
      { "resourceContextKey": "contexts/scope-a", "value": { "draft": "same-intent" } },
      { "resourceContextKey": "contexts/scope-b", "value": { "draft": "same-intent" } }
    ],
    "pendingPreviewRenders": 0,
    "previewDeliveries": []
  }
}
