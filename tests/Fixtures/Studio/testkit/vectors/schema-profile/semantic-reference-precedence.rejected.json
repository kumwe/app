{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/semantic-reference-precedence",
  "description": "Forward graph traversal cannot hide an earlier unresolved reference at its canonical document location.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "additionalProperties": false,
    "$defs": {
      "a": { "$ref": "#/$defs/z" },
      "b": { "$ref": "#/$defs/missing-b" },
      "z": { "$ref": "#/$defs/missing-z" }
    },
    "type": "object"
  },
  "expect": {
    "outcome": "rejected",
    "code": "invalid-reference",
    "schemaPath": "/$defs/b/$ref"
  }
}
