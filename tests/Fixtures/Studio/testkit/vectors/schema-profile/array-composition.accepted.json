{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/array-composition",
  "description": "Bounded prefix items and a non-empty oneOf remain portable within a closed property object.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "tuple": {
        "type": "array",
        "prefixItems": [
          { "type": "string" },
          { "oneOf": [{ "type": "integer" }, { "type": "null" }] }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "expect": {
    "outcome": "accepted",
    "instances": [
      { "value": { "tuple": ["label", 2] }, "valid": true },
      { "value": { "tuple": ["label", null] }, "valid": true },
      {
        "value": { "tuple": ["label", 2, true] },
        "valid": false,
        "diagnostic": { "instancePath": "/tuple", "keyword": "items" }
      }
    ]
  }
}
