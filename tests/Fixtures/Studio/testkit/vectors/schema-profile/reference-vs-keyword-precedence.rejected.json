{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/reference-vs-keyword-precedence",
  "description": "An unresolved reference precedes a later unsupported keyword in the same schema object.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "additionalProperties": false,
    "properties": {
      "x": {
        "$ref": "#/$defs/missing",
        "format": "email"
      }
    },
    "type": "object"
  },
  "expect": {
    "outcome": "rejected",
    "code": "invalid-reference",
    "schemaPath": "/properties/x/$ref"
  }
}
