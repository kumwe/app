{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/closed-object",
  "description": "A closed object with required and enumerated properties is admitted and produces stable instance diagnostics.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["tone"],
    "properties": {
      "tone": { "enum": ["calm", "bold"] },
      "width": { "type": "integer", "minimum": 1, "maximum": 12 }
    }
  },
  "expect": {
    "outcome": "accepted",
    "instances": [
      { "value": { "tone": "calm", "width": 4 }, "valid": true },
      {
        "value": { "tone": "loud" },
        "valid": false,
        "diagnostic": { "instancePath": "/tone", "keyword": "enum" }
      },
      {
        "value": {},
        "valid": false,
        "diagnostic": { "instancePath": "", "keyword": "required" }
      },
      {
        "value": { "tone": "bold", "unknown": true },
        "valid": false,
        "diagnostic": { "instancePath": "", "keyword": "additionalProperties" }
      }
    ]
  }
}
