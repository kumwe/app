{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/non-schema-reference",
  "description": "A local pointer must target a schema position, not merely an existing object in the schema document.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "value": {
        "$ref": "#/properties"
      }
    }
  },
  "expect": {
    "outcome": "rejected",
    "code": "invalid-reference",
    "schemaPath": "/properties/value/$ref"
  }
}
