{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/unresolved-reference",
  "description": "A syntactically valid local reference must resolve to a schema position in the same document.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": { "value": { "$ref": "#/$defs/missing" } }
  },
  "expect": {
    "outcome": "rejected",
    "code": "invalid-reference",
    "schemaPath": "/properties/value/$ref"
  }
}
