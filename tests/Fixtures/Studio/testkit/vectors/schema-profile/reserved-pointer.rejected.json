{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/reserved-pointer",
  "description": "A raw question mark is rejected so URI-fragment parsers cannot reinterpret a local pointer token.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "additionalProperties": false,
    "$defs": {
      "value?draft": {
        "type": "string"
      }
    },
    "properties": {
      "value": {
        "$ref": "#/$defs/value?draft"
      }
    },
    "type": "object"
  },
  "expect": {
    "outcome": "rejected",
    "code": "invalid-reference",
    "schemaPath": "/properties/value/$ref"
  }
}
