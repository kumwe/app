{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/memoized-diagnostic",
  "description": "A speculative failure reused by a conditional branch retains its deterministic diagnostics.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "failing": {
        "type": "object",
        "enum": [{ "allowed": true }],
        "required": ["required"]
      }
    },
    "anyOf": [{ "$ref": "#/$defs/failing" }, true],
    "if": true,
    "then": { "$ref": "#/$defs/failing" }
  },
  "expect": {
    "outcome": "accepted",
    "instances": [
      {
        "value": {},
        "valid": false,
        "diagnostic": { "instancePath": "", "keyword": "enum" }
      }
    ]
  }
}
