{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/recursive-reference",
  "description": "The alpha profile rejects reference cycles rather than relying on implementation-specific evaluation budgets.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "value": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "next": { "$ref": "#/$defs/value" } }
      }
    },
    "properties": { "value": { "$ref": "#/$defs/value" } }
  },
  "expect": {
    "outcome": "rejected",
    "code": "recursive-schema",
    "schemaPath": "/$defs/value/properties/next/$ref"
  }
}
