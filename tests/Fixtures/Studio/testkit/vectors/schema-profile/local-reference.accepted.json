{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/local-reference",
  "description": "A non-recursive local reference with escaped JSON Pointer tokens resolves without registry or network access.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "tone/value~v1": { "enum": ["calm", "bold"] }
    },
    "properties": {
      "tone": { "$ref": "#/$defs/tone~1value~0v1" }
    }
  },
  "expect": {
    "outcome": "accepted",
    "instances": [
      { "value": { "tone": "bold" }, "valid": true },
      {
        "value": { "tone": "unknown" },
        "valid": false,
        "diagnostic": { "instancePath": "/tone", "keyword": "enum" }
      }
    ]
  }
}
