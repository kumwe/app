{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/percent-encoded-pointer",
  "description": "Percent-encoded fragment tokens are outside the alpha profile's canonical raw pointer subset.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "additionalProperties": false,
    "$defs": {
      "value": {
        "type": "string"
      }
    },
    "properties": {
      "value": {
        "$ref": "#/$defs/%76alue"
      }
    },
    "type": "object"
  },
  "expect": {
    "outcome": "rejected",
    "code": "invalid-reference",
    "schemaPath": "/properties/value/$ref"
  }
}
