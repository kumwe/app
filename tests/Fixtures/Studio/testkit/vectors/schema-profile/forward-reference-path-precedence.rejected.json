{
  "contractVersion": "0.1-draft",
  "kind": "schema-profile-vector",
  "id": "schema-profile/forward-reference-path-precedence",
  "description": "A failure reached through a forward reference retains the target's canonical document path.",
  "profile": "studio.profile/schema-property",
  "schema": {
    "$ref": "#/properties/z",
    "additionalProperties": false,
    "properties": {
      "z": { "$ref": "#/$defs/missing" }
    },
    "type": "object"
  },
  "expect": {
    "outcome": "rejected",
    "code": "invalid-reference",
    "schemaPath": "/properties/z/$ref"
  }
}
