      {
        "type": "paragraph",
        "content": [
          { "type": "text", "text": "alpha", "marks": [{ "type": "bold" }] },
          { "type": "text", "text": "beta", "marks": [{ "type": "italic" }] },
          { "type": "text", "text": " tail" }
        ]
      }
    ]
  },
  "projection": [
    {
      "type": "paragraph",
      "text": "alphabeta tail",
      "spans": [
        { "start": 0, "end": 5, "marks": ["bold"] },
        { "start": 5, "end": 9, "marks": ["italic"] }
      ],
      "embeds": []
    }
  ]
}
