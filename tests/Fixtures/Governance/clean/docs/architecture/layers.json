{
  "graph": "kumwe-layer-graph",
  "authority": "docs/architecture/principles.md",
  "note": "Governance fixture copy of the real layer graph with the fictitious example package namespaces admitted and classified.",
  "layers": {
    "shared": {
      "description": "Framework-free types with a stable semantic owner and inward consumers in more than one layer. Depends on nothing.",
      "may_depend_on": []
    },
    "domain": {
      "description": "State, invariants and value objects. Depends on nothing but the shared kernel.",
      "may_depend_on": [
        "shared"
      ]
    },
    "application": {
      "description": "Use cases, authorization, transactions and audit records. Depends inward on the domain.",
      "may_depend_on": [
        "shared",
        "domain"
      ]
    },
    "infrastructure": {
      "description": "Persistence, rendering, packages, clocks, logs and protocol adapters. Implements application-owned ports.",
      "may_depend_on": [
        "shared",
        "domain",
        "application"
      ]
    },
    "presentation": {
      "description": "View models, presenters and form mappers. Shapes application results for a surface without receiving input itself.",
      "may_depend_on": [
        "shared",
        "domain",
        "application"
      ]
    },
    "delivery": {
      "description": "HTTP, console, worker and machine-surface entry points. Validates and translates input, formats a result, and owns no business rule.",
      "may_depend_on": [
        "shared",
        "domain",
        "application",
        "presentation"
      ]
    },
    "kernel": {
      "description": "The single composition root. It is the one place that may see every layer at once, which is what keeps the others from needing to.",
      "may_depend_on": [
        "*"
      ]
    }
  },
