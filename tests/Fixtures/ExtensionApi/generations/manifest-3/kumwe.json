        "value_type": "string",
        "storage_type": "string",
        "configuration_keys": ["options"]
      }],
      "field_presentations": [{
        "field_type": "kumwe.contract-manifest-three.grade",
        "contexts": ["create", "detail", "filter", "history", "list", "relation", "update"]
