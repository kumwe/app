      "resources": [
        {"type": "administrator_session", "identifiers": []},
        {"type": "portal_session", "identifiers": []}
      ],
      "installation_global": false,
      "system_identities": [],
      "lifecycle": "active",
      "version": 1
    }],
    "administrator": {
      "workspaces": [{
        "id": "kumwe.contract-manifest-three.workspace",
        "label": "Manifest three",
        "description": "Compatibility workspace for the manifest-three generation.",
