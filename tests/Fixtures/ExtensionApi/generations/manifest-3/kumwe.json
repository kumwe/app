      "navigation": [{
        "id": "kumwe.contract-manifest-three.navigation",
        "workspace": "kumwe.contract-manifest-three.workspace",
        "label": "Manifest three",
        "description": "Open the manifest-three compatibility surface",
        "path": "/",
        "icon": "extensions",
        "capability": "kumwe.contract-manifest-three.manage",
        "priority": 10,
        "keywords": "compatibility manifest generation three",
        "surface": "kumwe.contract-manifest-three.index"
      }],
      "routes": [],
      "views": [{
        "name": "kumwe.contract-manifest-three.index",
        "template": "index.twig"
      }]
    },
    "portal": {
      "workspaces": [{
        "id": "kumwe.contract-manifest-three.portal-workspace",
        "label": "Manifest three",
        "description": "Compatibility portal workspace for the manifest-three generation.",
        "priority": 150
      }],
      "navigation": [{
        "id": "kumwe.contract-manifest-three.portal-navigation",
        "workspace": "kumwe.contract-manifest-three.portal-workspace",
        "label": "Manifest three",
        "description": "Open the manifest-three portal compatibility surface",
        "path": "/",
        "icon": "extensions",
        "capability": "kumwe.contract-manifest-three.manage",
        "priority": 10,
        "keywords": "compatibility portal generation three",
        "surface": "kumwe.contract-manifest-three.portal-status"
      }],
      "routes": [],
      "templates": [{
        "name": "kumwe.contract-manifest-three.portal-status",
        "template": "status.twig"
      }]
    },
    "business": {
      "field_types": [{
