{
  "schema": 3,
  "name": "kumwe/contract-manifest-three",
  "type": "component",
  "version": "1.0.0",
  "provider": "KumweContract\\ManifestThree\\Provider",
  "autoload": {"psr-4": {"KumweContract\\ManifestThree\\": "src/"}},
  "requires": {"kumwe": "^2.0.0", "php": "^8.5.0"},
  "contributions": {
    "version": 1,
    "capabilities": [{
      "id": "kumwe.contract-manifest-three.manage",
      "label": "Manage the manifest-three compatibility surface",
      "description": "Open the workspaces the manifest-three compatibility package contributes."
