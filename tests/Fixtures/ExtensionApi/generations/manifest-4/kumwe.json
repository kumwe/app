          "timezone": "Africa/Windhoek",
          "payload": {
            "site_identifier": "default",
            "limit": 25
          },
          "queue": "kumwe.contract-manifest-four.integration",
          "site_identifier": "default",
          "enabled": true
        }
      ],
      "projections": [
        {
          "identifier": "kumwe.contract-manifest-four.activity",
          "version": 1,
          "handler_version": "1.0.0",
          "rebuildable": true,
          "sensitivity_ceiling": "public",
