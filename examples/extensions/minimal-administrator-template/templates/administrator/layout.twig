<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{% block title %}Kumwe Administrator{% endblock %}</title>
  {% for stylesheet in administrator_assets.stylesheets %}<link rel="stylesheet" href="{{ stylesheet }}">{% endfor %}
  <link
    rel="stylesheet"
    href="/assets/extensions/kumwe/minimal-administrator-template-example/1.0.0/assets/administrator.css"
  >
  {% for module in administrator_assets.modules %}<script type="module" src="{{ module }}"></script>{% endfor %}
</head>
<body>
  <a class="skip-link" href="#administrator-content">Skip to content</a>
  {% if csrf is defined %}
    <div class="administrator-shell example-administrator-shell" data-administrator-shell>
      <aside class="administrator-sidebar example-sidebar" aria-label="Administrator navigation">
        <a class="administrator-brand" href="/administrator">
          <span class="example-brand-mark" aria-hidden="true">K</span>
          <span class="brand-copy"><strong>Kumwe</strong><span>Administrator</span></span>
        </a>
        <nav id="administrator-navigation" class="administrator-navigation" aria-label="Administrator navigation">
          {% for workspace in administrator_workspaces %}
            <section class="navigation-group" aria-labelledby="navigation-group-{{ workspace.dom_id }}">
              <h2 class="navigation-group-title" id="navigation-group-{{ workspace.dom_id }}">{{ workspace.label }}</h2>
              <ul>
                {% for item in administrator_navigation %}
                  {% if item.workspace == workspace.id %}
                    <li>
                      <a href="{{ item.href }}"{% if active_navigation == item.id %} aria-current="page"{% endif %}>
                        <span class="example-navigation-mark" aria-hidden="true"></span><span>{{ item.label }}</span>
                      </a>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </section>
          {% endfor %}
        </nav>
      </aside>
      <header class="administrator-topbar">
        <button
          class="topbar-action navigation-toggle"
          type="button"
          aria-label="Open administrator navigation"
          aria-controls="administrator-navigation"
          aria-expanded="false"
          data-navigation-toggle
        >Menu</button>
        <div class="topbar-context">
          <strong>{% block context_title %}Administrator workspace{% endblock %}</strong>
          <span>{% block context_subtitle %}Manage your website with confidence{% endblock %}</span>
        </div>
        <button class="command-trigger" type="button" data-open-command-palette>
          <span>Search administrator</span><kbd>Ctrl K</kbd>
        </button>
        <form action="/administrator/logout" method="post">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
          <button class="topbar-action" type="submit">Sign out</button>
        </form>
      </header>
      <button
        class="navigation-backdrop"
        type="button"
        aria-label="Close administrator navigation"
        data-navigation-backdrop
      ></button>
      <main class="administrator-main" id="administrator-content" tabindex="-1">
        <div class="administrator-content">{% block content %}{% endblock %}</div>
      </main>
      <script type="application/json" id="administrator-command-data">{{ administrator_commands_json|raw }}</script>
      <kumwe-command-palette></kumwe-command-palette>
    </div>
  {% else %}
    <main class="login-page" id="administrator-content" tabindex="-1">
      {% block guest_content %}{{ block('content') }}{% endblock %}
    </main>
  {% endif %}
</body>
</html>
