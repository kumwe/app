        "record_invariants": [
            {
                "handle": "total_agrees_with_lines",
                "message": "The document total must equal the sum of its lines.",
                "condition": {
                    "op": "eq",
                    "type": "boolean",
                    "args": [
                        {
                            "op": "field",
                            "type": "decimal",
                            "field": "total"
                        },
                        {
                            "op": "line_aggregate",
                            "type": "decimal",
                            "lines": "lines",
                            "field": "amount",
                            "aggregate": "sum"
                        }
                    ]
                }
            },
            {
                "handle": "line_count_within_bounds",
                "message": "The document carries more lines than it admits.",
                "condition": {
                    "op": "lte",
                    "type": "boolean",
                    "args": [
                        {
                            "op": "line_aggregate",
                            "type": "integer",
                            "lines": "lines",
                            "aggregate": "count"
                        },
                        {
                            "op": "literal",
                            "type": "integer",
                            "value": 1000
                        }
                    ]
                }
            }
