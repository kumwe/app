{
  "uid": "kumwe-platform",
  "title": "Kumwe — platform health",
  "tags": [
    "kumwe",
    "platform"
  ],
  "description": "Availability, saturation, recovery, storage, extension trust and security signals, each panel named after the alert that watches it so an on-call engineer can go from a page to its graph and its runbook.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Availability",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Replicas ready (KumweReadinessFailing)",
      "description": "Per-replica readiness verdict.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kumwe_ready",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Synthetic probe (KumweSyntheticProbeFailing)",
      "description": "Outside-in probe result per check.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (check) (kumwe_probe_success)",
          "legendFormat": "{{check}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Server error ratio (KumweServerErrorRateCritical)",
      "description": "Share of responses in the 5xx class.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kumwe_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(kumwe_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Releases serving (KumweReleaseSkew)",
      "description": "Replicas per release.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (release) (kumwe_build_info)",
          "legendFormat": "{{release}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker liveness (KumweNoLiveWorker)",
      "description": "Registered workers and the age of the freshest heartbeat.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kumwe_workers_registered)",
          "legendFormat": "workers"
        },
        {
          "refId": "B",
          "expr": "max(kumwe_worker_heartbeat_age_seconds)",
          "legendFormat": "heartbeat age"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Scheduler lag (KumweSchedulerLagging)",
      "description": "How far the most overdue schedule is past due.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kumwe_scheduler_lag_seconds)",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Saturation",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Database connections (KumweDatabaseConnectionsSaturated)",
      "description": "Sessions in use against the ceiling.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kumwe_database_connections_in_use)",
          "legendFormat": "in use"
        },
        {
          "refId": "B",
          "expr": "max(kumwe_database_connections_max)",
          "legendFormat": "ceiling"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Replica lag (KumweDatabaseReplicaLagHigh)",
      "description": "Largest replica replay lag.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kumwe_database_replica_lag_seconds)",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scrape cost (KumweMetricsScrapeSlow)",
      "description": "Time spent collecting gauges, and whether collection failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kumwe_metrics_scrape_duration_seconds)",
          "legendFormat": "scrape"
        },
        {
          "refId": "B",
          "expr": "max(kumwe_metrics_collection_failed)",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Recovery and storage",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Backup and restore age (KumweBackupStale, KumweRestoreFailed)",
      "description": "Seconds since each operation last succeeded and last failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (operation) (kumwe_recovery_last_success_timestamp_seconds)",
          "legendFormat": "{{operation}} since success"
        },
        {
          "refId": "B",
          "expr": "time() - max by (operation) (kumwe_recovery_last_failure_timestamp_seconds)",
          "legendFormat": "{{operation}} since failure"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Free storage (KumweStorageNearlyFull, KumweStorageWillFillSoon)",
      "description": "Free share of each storage volume per replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kumwe_storage_free_bytes / kumwe_storage_capacity_bytes",
          "legendFormat": "{{instance}} {{volume}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Retention backlog age (KumweRetentionBacklogStale)",
      "description": "Age of the oldest drainable row per store.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (store) (kumwe_retention_oldest_age_seconds)",
          "legendFormat": "{{store}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Retention capacity forecast (KumweRetentionCapacityForecast)",
      "description": "Seconds until each store reaches capacity at the current slope.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (store) (kumwe_retention_forecast_seconds_to_capacity)",
          "legendFormat": "{{store}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "Trust and security",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Extension runtime trusted (KumweExtensionRuntimeUntrusted)",
      "description": "Per-replica trust verdict and the revocation feed state.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kumwe_extension_runtime_trusted",
          "legendFormat": "{{instance}}"
        },
        {
          "refId": "B",
          "expr": "max(kumwe_extension_revocation_feed_stale)",
          "legendFormat": "revocation feed stale"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Security events per minute (KumweAuthenticationFailureBurst)",
      "description": "Refused sign-ins, throttles, rejected tokens and denied permissions.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (increase(kumwe_security_events_total[1m]))",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ]
}
