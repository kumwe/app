{
  "uid": "kumwe-business",
  "title": "Kumwe — business operations",
  "tags": [
    "kumwe",
    "business"
  ],
  "description": "Business work that completed and how long it took. Every counter here selects the completed outcome, so a retried job, a re-dispatched event or a rolled-back transaction is never counted twice; what that costs is on the transport and retries dashboard.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Successful responses per second",
      "description": "HTTP responses outside the 5xx class, by method.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(kumwe_http_requests_total{status=~\"1xx|2xx|3xx|4xx\"}[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration, 95th percentile",
      "description": "From the request duration histogram, all methods.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kumwe_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Documents and records",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Document commits, 95th percentile",
      "description": "Whole-command latency of committed business documents, by capacity-contract class.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation_class) (rate(kumwe_operation_duration_seconds_bucket{operation_class=~\"document_100_line_commit|document_1000_line_commit\"}[5m])))",
          "legendFormat": "{{operation_class}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Document lines committed per second",
      "description": "Owned lines committed atomically with their document header.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kumwe_document_lines_total[5m]))",
          "legendFormat": "lines"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Committed transactions per second",
      "description": "Outermost transactions that committed; rollbacks are transport cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kumwe_transactions_total{outcome=\"committed\"}[5m]))",
          "legendFormat": "committed"
        }
      ]
    },
    {
      "id": 8,
      "type": "row",
      "title": "Asynchronous work completed",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Jobs completed per second",
      "description": "Job settlements with the completed outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kumwe_queue_settlements_total{outcome=\"completed\"}[5m]))",
          "legendFormat": "jobs"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Events delivered per second",
      "description": "Outbox dispatches and inbox consumptions that completed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kumwe_dispatch_settlements_total{outcome=\"completed\"}[5m]))",
          "legendFormat": "outbox dispatched"
        },
        {
          "refId": "B",
          "expr": "sum(rate(kumwe_consumer_settlements_total{outcome=\"completed\"}[5m]))",
          "legendFormat": "inbox consumed"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Events sequenced per second",
      "description": "Committed source events given a journal sequence for projections and dispatch.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kumwe_sequenced_events_total[5m]))",
          "legendFormat": "sequenced"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Delivery age and queue start, 95th percentile",
      "description": "How long completed work waited: event occurrence to delivery, and job availability to start.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation_class) (rate(kumwe_operation_duration_seconds_bucket{operation_class=~\"delivery_age|queue_time_to_start\"}[5m])))",
          "legendFormat": "{{operation_class}}"
        }
      ]
    }
  ]
}
