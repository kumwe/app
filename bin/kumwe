#!/usr/bin/env php
<?php

/**
 * Command-line entry point for Kumwe.
 *
 * Resolves the console container — recovery or full, depending on the requested command — and hands
 * the argument vector to `ConsoleApplication`, whose exit status becomes the process exit status.
 *
 * @since  2.0.0
 */

declare(strict_types=1);

use Kumwe\App\Delivery\Console\ConsoleApplication;

$root = dirname(__DIR__);
require $root . '/vendor/autoload.php';

/** @var Joomla\DI\Container $container */
$container = require $root . '/bootstrap/console.php';
/** @var ConsoleApplication $application */
$application = $container->get(ConsoleApplication::class);

exit($application->run(array_values($argv)));
