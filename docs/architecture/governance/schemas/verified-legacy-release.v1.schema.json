{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kumwe.dev/schemas/verified-legacy-release.v1",
  "title": "Kumwe verified legacy release record",
  "description": "evidence/legacy/<package>/VERIFIED-LEGACY-RELEASE.yaml for a pre-Version-2 dependency.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kumwe-verified-legacy-release/v1"
    },
    "legacy_without_v2_handoff": {
      "const": true
    },
    "repository": {
      "$ref": "#/$defs/url"
    },
    "artifact_identity": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "$ref": "#/$defs/commit"
    },
    "source_archive": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/$defs/url"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "url",
        "sha256"
      ],
      "additionalProperties": false
    },
    "registry_or_distribution_verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "public_api_snapshot": {
      "type": "object",
      "properties": {
        "documentation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exported_symbols_or_manifest": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "documentation",
        "exported_symbols_or_manifest",
        "sha256"
      ],
      "additionalProperties": false
    },
    "responsibility_and_non_goals_review": {
      "type": "string",
      "minLength": 1
    },
    "clean_consumer_verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_and_license_verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified_at": {
      "type": "string",
      "minLength": 1
    },
    "verified_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "failed"
      ]
    }
  },
  "required": [
    "schema",
    "legacy_without_v2_handoff",
    "repository",
    "artifact_identity",
    "version",
    "tag",
    "source_commit",
    "source_archive",
    "registry_or_distribution_verification",
    "public_api_snapshot",
    "responsibility_and_non_goals_review",
    "clean_consumer_verification",
    "security_and_license_verification",
    "compatibility_constraints",
    "known_gaps",
    "verified_at",
    "verified_by",
    "approved_by",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Full 40-character Git commit SHA."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hexadecimal SHA-256 digest."
    },
    "url": {
      "type": "string",
      "pattern": "^https?://.+$"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
      "description": "Semantic version, optional v prefix."
    }
  }
}
