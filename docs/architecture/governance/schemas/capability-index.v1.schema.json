{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kumwe.dev/schemas/capability-index.v1",
  "title": "Kumwe capability index",
  "description": "Generated from composer.lock and the installed vendor/kumwe manifests (section 3.2).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kumwe-capability-index/v1"
    },
    "generator": {
      "const": "tools/generate-capability-index.php"
    },
    "composer_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package": {
            "$ref": "#/$defs/package"
          },
          "repository": {
            "$ref": "#/$defs/url"
          },
          "installed_version": {
            "$ref": "#/$defs/version"
          },
          "source_reference": {
            "$ref": "#/$defs/commit"
          },
          "dist_reference": {
            "$ref": "#/$defs/commit"
          },
          "license": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manifest_status": {
            "type": "string",
            "enum": [
              "v2-manifested",
              "legacy-unmanifested"
            ]
          },
          "legacy": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "approved_by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "approved_on": {
                    "$ref": "#/$defs/date"
                  },
                  "verified_legacy_release": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/path"
                      }
                    ]
                  },
                  "retired_app_namespaces": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/namespace_root"
                    }
                  }
                },
                "required": [
                  "reason",
                  "approved_by",
                  "approved_on",
                  "verified_legacy_release",
                  "retired_app_namespaces"
                ],
                "additionalProperties": false
              }
            ]
          },
          "release_gate_eligible": {
            "type": "boolean"
          },
          "canonical_namespaces": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/namespace_root"
            },
            "minItems": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "non_responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/capability_id"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "symbols": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/fqcn"
                  }
                },
                "documentation": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/path"
                  }
                }
              },
              "required": [
                "id",
                "title",
                "symbols",
                "documentation"
              ],
              "additionalProperties": false
            }
          },
          "public_symbols": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/fqcn"
            }
          },
          "public_symbols_source": {
            "type": "string",
            "pattern": "^(manifest:[A-Za-z0-9_./-]+|source-scan)$"
          },
          "public_api_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "documentation": {
            "type": "object",
            "properties": {
              "charter": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/path"
                  }
                ]
              },
              "readme": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/path"
                  }
                ]
              },
              "public_api": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/path"
                  }
                ]
              }
            },
            "required": [
              "charter",
              "readme",
              "public_api"
            ],
            "additionalProperties": false
          },
          "dependency_injection": {
            "type": "object",
            "properties": {
              "config_provider": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/fqcn"
                  }
                ]
              },
              "provider_absence_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "factories": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "service": {
                      "$ref": "#/$defs/fqcn"
                    },
                    "factory": {
                      "$ref": "#/$defs/fqcn"
                    },
                    "lifetime": {
                      "$ref": "#/$defs/lifetime"
                    }
                  },
                  "required": [
                    "service",
                    "factory",
                    "lifetime"
                  ],
                  "additionalProperties": false
                }
              },
              "aliases": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/fqcn"
                }
              },
              "configuration_keys": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^kumwe\\.[a-z0-9-]+(\\.[A-Za-z0-9_.-]+)+$"
                    },
                    "default": {},
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "default",
                    "description"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "config_provider",
              "provider_absence_reason",
              "factories",
              "aliases",
              "configuration_keys"
            ],
            "additionalProperties": false
          },
          "native_requirements": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "extension": {
                    "type": "string",
                    "minLength": 1
                  },
                  "abi_major": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "corpus_digests": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/sha256"
                    }
                  }
                },
                "required": [
                  "extension",
                  "abi_major",
                  "capabilities",
                  "corpus_digests"
                ],
                "additionalProperties": false
              }
            ]
          },
          "deprecations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "$ref": "#/$defs/fqcn"
                },
                "since": {
                  "type": "string"
                },
                "replacement": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/fqcn"
                    }
                  ]
                }
              },
              "required": [
                "symbol",
                "since",
                "replacement"
              ],
              "additionalProperties": false
            }
          },
          "handoff": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "$ref": "#/$defs/path"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "migration_id": {
                    "$ref": "#/$defs/migration_id"
                  },
                  "change_set": {
                    "$ref": "#/$defs/change_set_id"
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "migration_id",
                  "change_set"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "package",
          "repository",
          "installed_version",
          "source_reference",
          "dist_reference",
          "license",
          "manifest_status",
          "legacy",
          "release_gate_eligible",
          "canonical_namespaces",
          "responsibility",
          "non_responsibilities",
          "capabilities",
          "public_symbols",
          "public_symbols_source",
          "public_api_digest",
          "documentation",
          "dependency_injection",
          "native_requirements",
          "deprecations",
          "handoff"
        ],
        "additionalProperties": false
      }
    },
    "extracted_namespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "old_namespace": {
            "$ref": "#/$defs/namespace_root"
          },
          "package": {
            "$ref": "#/$defs/package"
          },
          "migration_id": {
            "$ref": "#/$defs/migration_id"
          }
        },
        "required": [
          "old_namespace",
          "package",
          "migration_id"
        ],
        "additionalProperties": false
      }
    },
    "removed_symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "old_fqcn": {
            "$ref": "#/$defs/fqcn"
          },
          "new_fqcn": {
            "$ref": "#/$defs/fqcn"
          },
          "package": {
            "$ref": "#/$defs/package"
          },
          "migration_id": {
            "$ref": "#/$defs/migration_id"
          }
        },
        "required": [
          "old_fqcn",
          "new_fqcn",
          "package",
          "migration_id"
        ],
        "additionalProperties": false
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "required": [
    "schema",
    "generator",
    "composer_lock_sha256",
    "packages",
    "extracted_namespaces",
    "removed_symbols",
    "ownership"
  ],
  "additionalProperties": false,
  "$defs": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
      "description": "Dot-separated, package-prefixed identifier."
    },
    "change_set_id": {
      "type": "string",
      "pattern": "^KUMWE-CS-[0-9]{4}-[0-9]{3}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Full 40-character Git commit SHA."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "fqcn": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\\\[A-Za-z_][A-Za-z0-9_]*)*$",
      "description": "Fully qualified class-like name without a leading backslash."
    },
    "lifetime": {
      "type": "string",
      "enum": [
        "shared",
        "non-shared",
        "request-supplied"
      ]
    },
    "migration_id": {
      "type": "string",
      "pattern": "^KUMWE-MIG-[0-9]{4}-[0-9]{3}$"
    },
    "namespace_root": {
      "type": "string",
      "pattern": "^([A-Za-z_][A-Za-z0-9_]*\\\\)+$",
      "description": "Namespace root with a trailing backslash (autoload.psr-4)."
    },
    "package": {
      "type": "string",
      "pattern": "^kumwe/[a-z0-9-]+$",
      "description": "Composer package name in the kumwe vendor."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path with forward slashes."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hexadecimal SHA-256 digest."
    },
    "url": {
      "type": "string",
      "pattern": "^https?://.+$"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$",
      "description": "Semantic version, optional v prefix."
    }
  }
}
