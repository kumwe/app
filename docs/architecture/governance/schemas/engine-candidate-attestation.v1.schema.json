{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kumwe.dev/schemas/engine-candidate-attestation.v1",
  "title": "Kumwe Engine candidate attestation",
  "description": "External pre-release CI record for the Engine candidate cross-build (Kumwe-v2-08).",
  "type": "object",
  "properties": {
    "schema": {
      "const": "kumwe-engine-candidate-attestation/v1"
    },
    "change_set": {
      "$ref": "#/$defs/change_set_id"
    },
    "engine_candidate": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/url"
        },
        "tested_commit": {
          "$ref": "#/$defs/commit"
        },
        "tested_tree": {
          "type": "string",
          "minLength": 1
        },
        "source_archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "handoff_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "repository",
        "tested_commit",
        "tested_tree",
        "source_archive_sha256",
        "handoff_sha256"
      ],
      "additionalProperties": false
    },
    "extension_candidate": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/url"
        },
        "tested_commit": {
          "$ref": "#/$defs/commit"
        },
        "tested_tree": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "tested_commit",
        "tested_tree"
      ],
      "additionalProperties": false
    },
    "semantic_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "manifest_or_corpus_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "owner",
          "version",
          "manifest_or_corpus_sha256"
        ],
        "additionalProperties": false
      }
    },
    "build": {
      "type": "object",
      "properties": {
        "network_disabled": {
          "type": "boolean"
        },
        "toolchains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operating_systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "architectures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "php_modes_and_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "network_disabled",
        "toolchains",
        "operating_systems",
        "architectures",
        "php_modes_and_versions"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "cmake_consumer": {
          "type": "string",
          "minLength": 1
        },
        "pie_source_build": {
          "type": "string",
          "minLength": 1
        },
        "module_load_and_reflection": {
          "type": "string",
          "minLength": 1
        },
        "abi_capability_handshake": {
          "type": "string",
          "minLength": 1
        },
        "corpus_results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycle_sanitizer_leak": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hostile_input_and_refusal": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "cmake_consumer",
        "pie_source_build",
        "module_load_and_reflection",
        "abi_capability_handshake",
        "corpus_results",
        "lifecycle_sanitizer_leak",
        "hostile_input_and_refusal"
      ],
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "properties": {
        "run_url": {
          "$ref": "#/$defs/url"
        },
        "artifact_url": {
          "$ref": "#/$defs/url"
        }
      },
      "required": [
        "run_url",
        "artifact_url"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "superseded"
      ]
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "observed_by": {
      "type": "string",
      "minLength": 1
    },
    "publishing_permitted": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "change_set",
    "engine_candidate",
    "extension_candidate",
    "semantic_inputs",
    "build",
    "verification",
    "ci",
    "status",
    "observed_at",
    "observed_by",
    "publishing_permitted"
  ],
  "additionalProperties": false,
  "$defs": {
    "change_set_id": {
      "type": "string",
      "pattern": "^KUMWE-CS-[0-9]{4}-[0-9]{3}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "Full 40-character Git commit SHA."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Lowercase hexadecimal SHA-256 digest."
    },
    "url": {
      "type": "string",
      "pattern": "^https?://.+$"
    }
  }
}
