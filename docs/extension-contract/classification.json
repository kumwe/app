{
  "format": "kumwe-extension-contract-classification-v1",
  "authority": "docs/extension-contract/README.md",
  "generations": "docs/extension-contract/generations.json",
  "note": "Which types an extension may build against, as data rather than as prose. Everything under `Kumwe\\App\\` is internal unless it is listed here, so the absence of a type from this file is itself the answer: core may decompose it freely and a package that reaches for it will break. A type listed here is public — it is part of a promised generation, and it changes only by a generation gaining a successor. `pinned_by` names the compatibility fixture whose committed bytes hold the type's exact member signatures; where it is null the type is public and governed by its generation, but its members are not byte-pinned at this release.",
  "default_visibility": "internal",
  "visibilities": {
    "public": "Part of a promised generation. An extension may depend on it.",
    "internal": "Not promised to anyone. It may be renamed, split or deleted without a generation bump."
  },
  "roles": {
    "implement": "The package writes a class that satisfies the contract.",
    "call": "Core hands the package an instance and the package calls it.",
    "construct": "The package builds instances and hands them to core.",
    "receive": "Core hands the package an instance to read.",
    "resolve": "The package resolves it from the restricted container it is handed."
  },
  "namespaces": [
    {
      "prefix": "Kumwe\\App\\Extension\\Infrastructure\\",
      "visibility": "internal",
      "reason": "Adapters. Doctrine, Redis and sodium bindings behind the application contracts."
    },
    {
      "prefix": "Kumwe\\App\\Extension\\Domain\\Internal\\",
      "visibility": "internal",
      "reason": "Parser grammar control used to keep retained manifest generations aligned with runtime acceptance."
    },
    {
      "prefix": "Kumwe\\App\\Extension\\Application\\Install\\",
      "visibility": "internal",
      "reason": "The install plan and its states belong to the platform; a package never drives them."
    },
    {
      "prefix": "Kumwe\\App\\Extension\\Application\\Package\\",
      "visibility": "internal",
      "reason": "Admission, safety and attestation of a package are done to it, not by it."
    },
    {
      "prefix": "Kumwe\\App\\Extension\\Application\\Trust\\",
      "visibility": "internal",
      "reason": "The trust store and its policy are operator surfaces, reached through the console."
    },
    {
      "prefix": "Kumwe\\App\\Kernel\\",
      "visibility": "internal",
      "reason": "The composition root. What it exposes to a package is the allowlist in generations.json."
    },
    {
      "prefix": "Kumwe\\App\\Infrastructure\\",
      "visibility": "internal",
      "reason": "Persistence, migration and driver code. A package uses its own migrations instead."
    }
  ],
  "external_types": [
    {
      "type": "Psr\\Http\\Server\\RequestHandlerInterface",
      "package": "psr/http-server-handler",
      "reason": "Route handler contracts are PSR-15; core does not wrap them in a Kumwe type."
    },
    {
      "type": "Doctrine\\DBAL\\Connection",
      "package": "doctrine/dbal",
      "reason": "An extension migration receives the live connection so it writes its own schema."
    }
  ],
