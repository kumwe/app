{
  "format": "kumwe-extension-contract-generations-v1",
  "authority": "docs/extension-contract/README.md",
  "classification": "docs/extension-contract/classification.json",
  "note": "The frozen extension contract, one entry per manifest generation and one per contribution SPI generation. A generation listed here is still promised: a package built against it installs, activates, upgrades, disables, reactivates and uninstalls on this release. Anything that was once promised and is not any more is recorded under `withdrawn` rather than being deleted, because an author needs to know a surface is gone, not merely find it missing. `tools/verify-extension-contract.php` recomputes every `surface_digest` from the entry it belongs to, so changing what a generation promises fails the build until the change is made deliberately.",
  "statuses": {
    "frozen": "Still promised. The surface is closed: it may gain a new generation beside it, but this entry does not change.",
    "withdrawn": "No longer promised. Recorded so an author who built against it learns that it went, and when."
  },
  "key_statuses": {
    "interpreted": "The platform reads the key and acts on it.",
    "advisory": "The platform reads the key only to describe the package, and acts on nothing in it.",
    "accepted_uninterpreted": "The parser still accepts the key so older packages keep installing, and nothing reads it."
  },
  "signing": {
    "identifier": "kumwe.contract-freeze",
    "algorithm": "ed25519",
    "seed_stem": "kumwe-extension-contract-freeze",
    "seed_derivation": "sha256(seed_stem, raw)",
    "note": "A fixture key, deliberately derived from a written stem rather than generated, so the compatibility packages can be rebuilt and re-signed by anyone and no key material of any kind \u2014 not even the public half \u2014 is committed as a literal. It proves the signing and trust path, not provenance: the package digest is signed with `PackageSigner`, the sidecar is a `SignatureDocument`, and admission runs through `PackageTrustPolicy` over `SodiumEd25519Verifier` \u2014 the same three the platform uses for a real release key. A release key proves provenance and lives outside the repository."
  },
