APP_ENV=development
APP_DEBUG=true
# Direct PHP processes use APP_BASE_URL. Development Compose derives the same
# value from KUMWE_HTTP_HOST and KUMWE_HTTP_PORT below.
APP_BASE_URL=http://localhost:8080
KUMWE_HTTP_HOST=localhost
KUMWE_HTTP_BIND=127.0.0.1
# Change this one value to publish development on another host port.
KUMWE_HTTP_PORT=8080
APP_PUBLIC_SITE=default
APP_TRUSTED_HOSTS=localhost,127.0.0.1
APP_TRUSTED_PROXIES=
APP_MAX_BODY_BYTES=2097152
APP_ADMIN_SESSION_SECONDS=28800
# These independent first-install choices are persisted when profiles are first reconciled.
# Use KUMWE_SITE_CONTENT_PROFILE=blank and KUMWE_BUSINESS_DEMO=false for an empty site.
KUMWE_SITE_CONTENT_PROFILE=documentation
KUMWE_BUSINESS_DEMO=true
KUMWE_RELEASE=2.0.0-dev
APP_SECRET=change-this-to-at-least-32-random-bytes
EXTENSION_RUNTIME_SIGNING_KEY_ID=runtime-v1
EXTENSION_RUNTIME_SIGNING_KEY=use-a-different-32-byte-random-runtime-secret
EXTENSION_RUNTIME_PREVIOUS_KEYS=
# Or set EXTENSION_RUNTIME_PREVIOUS_KEYS_FILE to an absolute root-readable JSON secret file.
KUMWE_DEPLOYMENT_ID=local-development
KUMWE_REPLICA_ID=local-replica
KUMWE_PROCESS_ID=development-process
KUMWE_INSTANCE_ID=development-instance
EXTENSIONS_ALLOW_UNSIGNED_LOCAL=true

DB_DRIVER=mariadb
DB_HOST=database
DB_PORT=3306
DB_NAME=kumwe
DB_USER=kumwe
DB_PASSWORD=kumwe-development-only
DB_TABLE_PREFIX=kumwe_
DB_SSLMODE=disable
DB_SERVER_VERSION=mariadb-12.3.2
KUMWE_DATABASE_IMAGE=mariadb:lts

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_NAMESPACE=kumwe.cms
KUMWE_REDIS_IMAGE=redis:8-alpine
