APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost:8080
APP_TRUSTED_HOSTS=localhost,127.0.0.1
APP_TRUSTED_PROXIES=
APP_MAX_BODY_BYTES=2097152
APP_ADMIN_SESSION_SECONDS=28800
KUMWE_RELEASE=2.0.0-dev
APP_SECRET=change-this-to-at-least-32-random-bytes
EXTENSIONS_ALLOW_UNSIGNED_LOCAL=true

DB_HOST=postgres
DB_PORT=5432
DB_NAME=kumwe
DB_USER=kumwe
DB_PASSWORD=kumwe-development-only
DB_SCHEMA=kumwe
DB_SSLMODE=prefer

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MAIL_TRANSPORT=null
MAIL_FROM_ADDRESS=kumwe@localhost
MAIL_FROM_NAME=Kumwe CMS
